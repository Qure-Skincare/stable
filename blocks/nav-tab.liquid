{% doc %}
  Renders a header navigation tab: the menu item and its dropdown panel.
  The menu item is wrapped in <!--nav-menu--> markers so the parent section
  (sections/n-header.liquid) can move it into the top menu.
{% enddoc %}

{% liquid
  assign panel = block.settings.panel
  assign bf_style = false
  assign bf_assets = false
  if block.settings.bf_style
    if settings.bf_pdp_badge or settings.holiday_offer_turn_on
      assign bf_style = true
    endif
    if settings.bf_pdp_badge
      assign bf_assets = true
    endif
  endif
%}

<!--nav-menu-->
<li{% if panel == 'none' %} {{ block.shopify_attributes }}{% endif %}>
    {% if panel == 'none' %}
        <a{% if bf_style %} class="bf-bundles"{% endif %} href="{{ block.settings.url | default: '#' }}">
    {% else %}
        <a{% if bf_style %} class="bf-bundles"{% endif %} href="{{ block.settings.url | default: 'javascript:;' }}" data-target="{{ panel }}">
    {% endif %}
        <span>{{ block.settings.title }}</span>
        {% if block.settings.pill != blank %}
            <span class="e-pill-save{% if settings.black_friday_turn_on %} e-pill-save--bf{% endif %}">{{ block.settings.pill }}</span>
        {% endif %}
    </a>
</li>
<!--/nav-menu-->

{% if panel == 'none' and bf_style %}
    <!--nav-mobile--><a class="bf-bundles" href="{{ block.settings.url | default: '#' }}">{{ block.settings.title }}</a>
{% endif %}

{% if panel != 'none' %}
    <div class="header__content" id="{{ panel }}" {{ block.shopify_attributes }}>
        <div class="header__content-container container">
            {% if bf_assets and block.settings.bf_badge_value != blank %}
                <div class="e-bf-badge e-bf-badge--silver">
                    <img src="https://qureskincaredns-stable.com/assets/images/bf-26/bf-badge-silver.webp" alt="Black Friday" loading="lazy" />
                    <div class="e-bf-badge__content">
                        {% if block.settings.bf_badge_text != blank %}
                            <span>{{ block.settings.bf_badge_text }}</span>
                        {% endif %}
                        <strong>{{ block.settings.bf_badge_value }}</strong>
                    </div>
                </div>
            {% endif %}
            {% if block.settings.heading != blank %}
                <div class="header__content-title">
                    {% if bf_assets %}
                        <div class="e-bf-label e-bf-label--md">
                            <img src="https://qureskincaredns-stable.com/assets/images/bf-26/bf-label-md.webp" alt="Black Friday" loading="lazy" />
                        </div>
                    {% endif %}
                    <h3>{{ block.settings.heading }}</h3>
                    {% if block.settings.button_label != blank %}
                        <a class="btn btn--primary btn--md" href="{{ block.settings.button_url | default: '#' }}">{{ block.settings.button_label }}</a>
                    {% endif %}
                    {% if bf_style %}
                        <a class="bf-bundles" href="{{ block.settings.button_url | default: '#' }}">{{ block.settings.title }}</a>
                    {% endif %}
                    <!--nav-mobile-slot-->
                </div>
            {% endif %}
            {% content_for 'blocks' %}
        </div>
    </div>
{% endif %}

{% schema %}
{
    "name": "Nav tab",
    "tag": null,
    "blocks": [
        { "type": "nav-cards" },
        { "type": "nav-links" }
    ],
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Menu title",
            "default": "Menu item"
        },
        {
            "type": "text",
            "id": "pill",
            "label": "Pill text",
            "info": "Optional badge next to the menu title, e.g. \"Save up to 55%\""
        },
        {
            "type": "url",
            "id": "url",
            "label": "Link",
            "info": "Used when the tab has no dropdown, and on mobile"
        },
        {
            "type": "select",
            "id": "panel",
            "label": "Dropdown layout",
            "options": [
                { "value": "none", "label": "No dropdown (plain link)" },
                { "value": "shop_bestsellers", "label": "Product cards" },
                { "value": "shop_benefits", "label": "Image cards" },
                { "value": "learn_more", "label": "Link columns + cards" }
            ],
            "default": "none",
            "info": "Each layout can be used by one tab only"
        },
        {
            "type": "checkbox",
            "id": "bf_style",
            "label": "Black Friday style",
            "default": false,
            "info": "Highlighted button: shown while \"Black Friday offer Turn on\" or \"Holiday offer Turn on\" is enabled (blue for Holiday). Badge and Black Friday label: Black Friday only"
        },
        {
            "type": "text",
            "id": "bf_badge_text",
            "label": "Badge text",
            "visible_if": "{{ block.settings.bf_style }}"
        },
        {
            "type": "text",
            "id": "bf_badge_value",
            "label": "Badge value",
            "visible_if": "{{ block.settings.bf_style }}"
        },
        {
            "type": "header",
            "content": "Dropdown title"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading"
        },
        {
            "type": "text",
            "id": "button_label",
            "label": "Button label"
        },
        {
            "type": "url",
            "id": "button_url",
            "label": "Button link"
        }
    ],
    "presets": [
        { "name": "Nav tab" }
    ]
}
{% endschema %}
