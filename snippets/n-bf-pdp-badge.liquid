{% doc %}
  Renders the Black Friday sale badge on product pages.
  Shown only on product templates while the theme setting "Badge PDPs" (Special offer) is on.

  @example
  {% render 'n-bf-pdp-badge' %}
{% enddoc %}

{%- if settings.bf_pdp_badge and template.name == 'product' -%}
    <div class="e-bf-label e-bf-label--pdp">
        <img src="https://qureskincaredns-stable.com/assets/images/bf-26/bf-sale-label.webp" alt="Black Friday Sale" width="432" height="92" />
    </div>
{%- endif -%}

{% stylesheet %}
    .e-bf-label--pdp img {
        width: auto;
        max-height: 34px;
    }

    .hero-product__main .e-bf-label--pdp {
        margin-bottom: -16px;
    }

    .helmet-home__header .e-bf-label--pdp {
        margin-bottom: 12px;
    }
{% endstylesheet %}
