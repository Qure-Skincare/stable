{% doc %}
  Renders a product/page purchase form selector snippet for the product-header section

  @param {object} - A section object.
  @param {object} - A block object.

  @example
  {% render 'n-product-page-purchase-form-selector', section: '', block: '' %}
{% enddoc %}

{% if block == blank %}
    {% for _block in section.blocks %}
        {% if _block.type == 'purchase-form-selector' %}
            {% assign block = _block %}
        {% endif %}
    {% endfor %}
{% endif %}

<div class="c-options-selector">
    <p class="c-options-selector__title">{{ 'product.settings.purchase-form-selector.header' | t }}</p>
    <ul class="c-options-selector__list">
        {% if block.settings.image != blank and block.settings.product != blank and block.settings.form_name != blank %}
            <li>
                <label>
                    <input data-form="{{ block.settings.form_name }}" type="radio" name="type" checked />
                    <img src="{{ block.settings.image | img_url: '250x' }}" alt="{{ block.settings.product | escape }}" />
                    <span>{{ block.settings.product }}</span>
                    {% if block.settings.compatible_text != blank %}
                        <div class="c-info">
                            <div class="c-info__icon"><i class="e-icon e-icon-i"></i></div>
                            <div class="c-info__tooltip">
                                <div class="c-info__filter-compatible">
                                    <p><span class="e-checkmark"></span> {{ 'product.settings.purchase-form-selector.compatible' | t }}</p>
                                    <a href="{% if block.settings.compatible_url != blank %}{{ block.settings.compatible_url }}{% else %}javascript:;{% endif %}">
                                        <span>{{ block.settings.compatible_text }}</span>
                                        {% if block.settings.compatible_image != blank %}
                                            <img src="{{ block.settings.compatible_image | img_url: '250x' }}" alt="{{ block.settings.compatible_text | strip_html | escape }}" />
                                        {% endif %}
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </label>
            </li>
        {% endif %}
        {% if block.settings.image2 != blank and block.settings.product2 != blank and block.settings.form_name2 != blank %}
            <li>
                <label>
                    <input data-form="{{ block.settings.form_name2 }}" type="radio" name="type" />
                    <img src="{{ block.settings.image2 | img_url: '250x' }}" alt="{{ block.settings.product2 | escape }}" />
                    <span>{{ block.settings.product2 }}</span>
                    {% if block.settings.compatible_text2 != blank %}
                        <div class="c-info">
                            <div class="c-info__icon"><i class="e-icon e-icon-i"></i></div>
                            <div class="c-info__tooltip">
                                <div class="c-info__filter-compatible">
                                    <p><span class="e-checkmark"></span> {{ 'product.settings.purchase-form-selector.compatible' | t }}</p>
                                    <a href="{% if block.settings.compatible_url2 != blank %}{{ block.settings.compatible_url2 }}{% else %}javascript:;{% endif %}">
                                        <span>{{ block.settings.compatible_text2 }}</span>
                                        {% if block.settings.compatible_image2 != blank %}
                                            <img src="{{ block.settings.compatible_image2 | img_url: '250x' }}" alt="{{ block.settings.compatible_text2 | strip_html | escape }}" />
                                        {% endif %}
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </label>
            </li>
        {% endif %}
    </ul>
</div>

{% if block.settings.compatible_text != blank or block.settings.compatible_text2 != blank %}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadScriptOnce("popper", "https://qureskincaredns-stable.com/assets/js/popper.min.js", function () {
                loadScriptOnce("tippy-bundle", "https://qureskincaredns-stable.com/assets/js/tippy-bundle.umd.min.js", function () {
                    loadScriptOnce("tippy", "https://qureskincaredns-stable.com/assets/js/tippy.js");
                });
            });
        });
    </script>
{% endif %}
