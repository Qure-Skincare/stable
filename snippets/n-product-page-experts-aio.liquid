{% doc %}
  Renders the "experts" block (quote-card + certified-box) for the product /
  page header. Sits in `.hero-product__extra`, between the collapsed
  accordion and the jump-to nav.

  Renders nothing if no `experts` block is added to the section. The
  certified box is skipped unless the block sets `certified_image_1`.

  @param {object} section - The current section object.

  @example
  {% render 'n-product-page-experts-aio', section: section %}
{% enddoc %}

{% assign experts_blocks = section.blocks | where: 'type', 'experts' %}

{% if experts_blocks.size > 0 %}
    <div class="hero-product__experts">
        {% for block in experts_blocks %}
            <div class="e-quote-card" {{ block.shopify_attributes }}>
                <i class="e-icon e-icon-quote"></i>
                {% if block.settings.image != blank %}
                    <picture>
                        <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.username | escape }}" />
                    </picture>
                {% endif %}
                {% if block.settings.text != blank %}
                    {{ block.settings.text }}
                {% endif %}
                {% if block.settings.username != blank or block.settings.position != blank %}
                    <div>
                        {% if block.settings.username != blank %}<strong>{{ block.settings.username }}</strong>{% endif %}
                        {% if block.settings.position != blank %}<small>{{ block.settings.position }}</small>{% endif %}
                    </div>
                {% endif %}
            </div>

            {% if block.settings.certified_image_1 != blank %}
                <div class="c-certified-box">
                    <ul>
                        <li><img loading="lazy" src="{{ block.settings.certified_image_1 | image_url }}" alt="{{ block.settings.certified_image_1.alt | escape }}" /></li>
                        {% if block.settings.certified_image_2 != blank %}
                            <li><img loading="lazy" src="{{ block.settings.certified_image_2 | image_url }}" alt="{{ block.settings.certified_image_2.alt | escape }}" /></li>
                        {% endif %}
                        {% if block.settings.certified_count != blank %}
                            <li>{{ block.settings.certified_count }}</li>
                        {% endif %}
                    </ul>
                    {{ block.settings.certified_text }}
                </div>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}
