{%- unless sapp_passthrough -%}
  {%- if license_valid_liquid -%}
    {%- if sapp_use_minified -%}
      {%- assign sapp_runtime_file  = '__sapp-runtime.min.js'  -%}
      {%- assign sapp_observer_file = '__sapp-observer.min.js' -%}
      {%- assign sapp_backend_file  = '__sapp-backend.min.js'  -%}
    {%- else -%}
      {%- assign sapp_runtime_file  = '__sapp-runtime.js'  -%}
      {%- assign sapp_observer_file = '__sapp-observer.js' -%}
      {%- assign sapp_backend_file  = '__sapp-backend.js'  -%}
    {%- endif -%}
    {%- assign sapp_custom_file   = '__sapp-custom.js'   -%}
    {%- include '__sapp-preload' -%}
    {%- include '__sapp-config' -%}
    {{ '__sapp-custom.css' | asset_url | stylesheet_tag }}
    <script src="{{ sapp_runtime_file  | asset_url }}"></script>
    <script src="{{ sapp_custom_file   | asset_url }}"></script>
    <script src="{{ sapp_observer_file | asset_url }}"></script>
    <script src="{{ sapp_backend_file  | asset_url }}" async></script>
  {%- endif -%}
{%- endunless -%}