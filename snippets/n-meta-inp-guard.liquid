{% doc %}
  Keeps Meta's automatic events (autoConfig) from slowing down taps. On every tap of a
  button or link, Meta's click listener scanned the button, its form and the page to
  build a SubscribedButtonClick event, which cost ~100-200 ms of INP on mid-range phones.

  Rendered before the Converge pixel script, which installs both Meta pixels. Remove the
  render to restore Meta's default behaviour.

  @param {string} [mode] - 'defer' (default): run the click scan after the tap's next
    paint instead of before the site reacts. Meta keeps every event and all its data.
    'click': skip the click scan for the duration of each tap. Drops SubscribedButtonClick;
    every other event keeps the page, product and form data Meta collects automatically.
    'off': opt both pixels out of Meta's automatic setup before their init. Also drops that
    data from every event.
  @param {boolean} [weak_devices_only] - Apply only on weak devices (Android, or at most
    4 GB of memory or 4 CPU cores); other devices keep Meta's defaults.

  @example
  {% render 'n-meta-inp-guard' %}
  {% render 'n-meta-inp-guard', mode: 'click', weak_devices_only: true %}
{% enddoc %}

{%- assign mode = mode | default: 'defer' -%}

<script>
    (function () {
        {%- if weak_devices_only %}
        var nav = navigator;
        var weak = /Android/i.test(nav.userAgent)
            || (nav.deviceMemory > 0 && nav.deviceMemory <= 4)
            || (nav.hardwareConcurrency > 0 && nav.hardwareConcurrency <= 4);
        if (!weak) return;
        {%- endif %}

        {%- if mode == 'off' %}
        // Converge wraps an existing window.fbq instead of creating its own, so these calls
        // queue ahead of its fbq('init'). The stub resolves window.fbq at call time, as
        // Converge's own does, so calls keep reaching fbevents.js once it replaces the
        // queue with callMethod.
        if (window.fbq) return;
        var fbq = window.fbq = window._fbq = function () {
            window.fbq.callMethod ? window.fbq.callMethod.apply(window.fbq, arguments) : window.fbq.queue.push(arguments);
        };
        fbq.push = fbq;
        fbq.loaded = true;
        fbq.version = '2.0';
        fbq.disablePushState = true;
        fbq.queue = [];
        fbq('set', 'autoConfig', false, '1108799966942521');
        fbq('set', 'autoConfig', false, '875056633226981');
        {%- elsif mode == 'click' %}
        // Meta's click listener returns early while fbq.instance.disableAutoConfig is set.
        // A window capture listener runs before it, so the flag is raised for this tap's
        // dispatch only and dropped in the next task, before any later event is sent.
        window.addEventListener('click', function () {
            var instance = window.fbq && window.fbq.instance;
            if (!instance || instance.disableAutoConfig) return;
            instance.disableAutoConfig = true;
            setTimeout(function () { instance.disableAutoConfig = false; }, 0);
        }, true);
        {%- else %}
        // Meta registers its click scan as a capture listener on document, so it runs before
        // the site's own handlers. Click listeners that Meta's scripts register are wrapped
        // to run after the next paint instead; the scan only reads event.target, which the
        // event keeps after dispatch.
        var addEventListener = document.addEventListener;
        document.addEventListener = function (type, listener, options) {
            if (type === 'click' && typeof listener === 'function' && /connect\.facebook\.net/.test(new Error().stack || '')) {
                var scan = listener;
                listener = function (event) {
                    var target = this;
                    requestAnimationFrame(function () {
                        setTimeout(function () { scan.call(target, event); }, 0);
                    });
                };
            }
            return addEventListener.call(this, type, listener, options);
        };
        {%- endif %}
    })();
</script>
