        <li>
            <i class="e-icon e-icon-circle-check"></i>
            {{ 'purchase-form.settings.bottom.card.guarantee' | t }}
        </li>
        <li>
            <i class="e-icon e-icon-circle-security"></i>
            {{ 'purchase-form.settings.bottom.card.tested' | t }}
