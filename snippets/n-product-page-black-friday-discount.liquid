{% doc %}
  Renders a product limited time offer snippet for the product-header section.

  @param {object} - A section object.
  @param {object} - A block object.
  @param {number} black_friday_discount_percent - Exception-aware discount percent (0 when the page is excluded).

  @example
  {% render 'n-product-page-black-friday-discount', section: '', block: '', black_friday_discount_percent: black_friday_discount_percent %}
{% enddoc %}

{% if block == blank %}
    {% for _block in section.blocks %}
        {% if _block.type == 'black-friday-discount' %}
            {% assign block = _block %}
        {% endif %}
    {% endfor %}
{% endif %}

{% if black_friday_discount_percent == blank %}
    {% assign black_friday_discount_percent = settings.black_friday_discount_percent %}
{% endif %}

{% if black_friday_discount_percent > 0 %}
    <div class="c-special-offer" data-label="{{ 'product.settings.special-offer-discount.header' | t }}">
        <div class="e-pill-save">{{ 'product.settings.special-offer-discount.save' | t }} {{ black_friday_discount_percent }}%</div>
    </div>
{% endif %}