{% doc %}
  Renders a page video snippet for product-header section.

  @param {object} - A section object.
  @param {object} - A block object.

  @example
  {% render 'n-page-video', section: '', block: '' %}
{% enddoc %}

{% if block == blank %}
    {% for _block in section.blocks %}
        {% if _block.type == 'video' %}
            {% assign block = _block %}
        {% endif %}
    {% endfor %}
{% endif %}

<div class="c-wistia c-wistia--custom">
    {% capture wistia_thumbnail %}
        <div class="c-wistia__custom">
            {% if block.settings.image != blank %}
                <figure>
                    <img loading="lazy" src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt | escape }}" />
                    <figcaption>{{ block.settings.heading }}</figcaption>
                </figure>
            {% endif %}
        </div>
    {% endcapture %}
    {% render 'n-wistia-facade', media_id: block.settings.wistia_url, content: wistia_thumbnail %}
</div>