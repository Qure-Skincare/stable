{% doc %}
  Renders a collapsed snippet for the product-header/page-header section

  @param {object} product - A product object.
  @param {object} page - A page object.
  @param {object} section - Optional. When provided, an `faq` block on the
    section will render a "Frequently Asked Questions" link below the list.

  @example
  {% render 'n-product-page-collapsed' product: product, page: page, section: section %}
{% enddoc %}

<div class="c-accordion c-accordion--lines">
    <div class="c-accordion__list">
        {%- assign default_order = 'key_benefits,how_it_works,what_to_expect,what_s_included,technical_specifications,full_ingredient_list,how_to_use,why_we_love_it,clean_ingredients' | split: ',' -%}

        {%- assign order_keys = default_order -%}
        {%- if product.metafields.custom.product_header_accordion_order != blank -%}
            {%- assign order_keys = product.metafields.custom.product_header_accordion_order.value | split: ',' -%}
        {%- elsif page.metafields.custom.product_header_accordion_order != blank -%}
            {%- assign order_keys = page.metafields.custom.product_header_accordion_order.value | split: ',' -%}
        {%- endif -%}

        {%- for key in order_keys -%}
            {%- assign key = key | strip -%}
            {%- assign mf = product.metafields.custom[key] -%}
            {%- if mf == blank -%}{%- assign mf = page.metafields.custom[key] -%}{%- endif -%}
            {%- if mf != blank -%}
                {%- case key -%}
                    {%- when 'key_benefits' -%}{%- assign accordion_title = 'Key Benefits' -%}
                    {%- when 'how_it_works' -%}{%- assign accordion_title = 'How It Works' -%}
                    {%- when 'what_to_expect' -%}{%- assign accordion_title = 'What To Expect' -%}
                    {%- when 'what_s_included' -%}{%- assign accordion_title = 'What’s Included' -%}
                    {%- when 'technical_specifications' -%}{%- assign accordion_title = 'Technical Specifications' -%}
                    {%- when 'full_ingredient_list' -%}{%- assign accordion_title = 'Full ingredient list' -%}
                    {%- when 'how_to_use' -%}{%- assign accordion_title = 'How To Use' -%}
                    {%- when 'why_we_love_it' -%}{%- assign accordion_title = 'Why We Love It' -%}
                    {%- when 'clean_ingredients' -%}{%- assign accordion_title = 'Clean Ingredients' -%}
                    {%- else -%}{%- continue -%}
                {%- endcase -%}
                {%- render 'n-product-page-collapsed-item' input: mf, title: accordion_title -%}
            {%- endif -%}
        {%- endfor -%}
    </div>

    {% if section %}
        {% assign faq_blocks = section.blocks | where: 'type', 'faq' %}
        {% for block in faq_blocks %}
            {% if block.settings.button_label != blank %}
                <a class="c-accordion__link" href="{{ block.settings.button_url }}" {{ block.shopify_attributes }}>{{ block.settings.button_label }}</a>
            {% endif %}
        {% endfor %}
    {% endif %}
</div>