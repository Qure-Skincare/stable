{% doc %}
  Renders an optional subscription add-on widget for the product-header section.

  @param {object} section - A section object.
  @param {object} block - An `optional-subscription` block object.
  @param {object} product - The section product (main / primary product).

  @example
  {% render 'n-product-optional-subscription', section: section, block: block, product: product %}
{% enddoc %}

{% if block == blank %}
    {% for _block in section.blocks %}
        {% if _block.type == 'optional-subscription' %}
            {% assign block = _block %}
        {% endif %}
    {% endfor %}
{% endif %}

{% assign main_price = product.price | money_without_trailing_zeros %}
{% assign optional_layout = block.settings.layout | default: 'hero' %}

{% assign subscription_product = block.settings.product %}
{% assign subscription_variant = blank %}
{% assign configured_variant_id = block.settings.subscription_variant_id | append: '' %}
{% if subscription_product != blank and configured_variant_id != blank %}
    {% for variant in subscription_product.variants %}
        {% assign variant_id = variant.id | append: '' %}
        {% if variant_id == configured_variant_id %}
            {% assign subscription_variant = variant %}
            {% break %}
        {% endif %}
    {% endfor %}
{% endif %}

{% assign selling_plan_allocation = blank %}
{% assign configured_selling_plan_id = block.settings.selling_plan_id | append: '' %}
{% if subscription_variant != blank and configured_selling_plan_id != blank %}
    {% for allocation in subscription_variant.selling_plan_allocations %}
        {% assign selling_plan_id = allocation.selling_plan.id | append: '' %}
        {% if selling_plan_id == configured_selling_plan_id %}
            {% assign selling_plan_allocation = allocation %}
            {% break %}
        {% endif %}
    {% endfor %}
{% endif %}

{% assign subscription_configured = false %}
{% if block.settings.subscription_variant_id != blank and block.settings.selling_plan_id != blank %}
    {% assign subscription_configured = true %}
{% endif %}

{% assign recurring_price = subscription_variant.price %}
{% assign recurring_compare_at_price = subscription_variant.compare_at_price %}
{% if selling_plan_allocation != blank %}
    {% assign recurring_price = selling_plan_allocation.price %}
    {% assign recurring_compare_at_price = selling_plan_allocation.compare_at_price %}
{% endif %}

{% assign unchecked_image_url = blank %}
{% if block.settings.unchecked_image != blank %}
    {% assign unchecked_image_url = block.settings.unchecked_image | image_url %}
{% endif %}

<div
    class="hero-product__optional-subscription"
    data-optional-subscription
    data-subscription-variant-id="{{ block.settings.subscription_variant_id | escape }}"
    data-subscription-selling-plan-id="{{ block.settings.selling_plan_id | escape }}"
>
    <div class="c-optional-subscription">
        <div class="c-optional-subscription__main">
            {% if block.settings.heading != blank %}
                <span>{{ block.settings.heading }}</span>
            {% endif %}
            {% if product.featured_image != blank %}
                <img loading="lazy" src="{{ product.featured_image | image_url }}" alt="{{ product.title | escape }}" />
            {% endif %}
            <p>{{ product.title }}</p>
            {% if main_price != blank %}
                <div class="e-price e-price--highlight">
                    <div class="e-price__main">
                        <div class="e-price__current">{{ main_price }}</div>
                    </div>
                </div>
            {% endif %}
        </div>
        <label class="c-optional-subscription__option">
            <input type="checkbox" name="subscription"{% if subscription_configured %} checked{% endif %} />
            {% if optional_layout == 'hero' and unchecked_image_url != blank %}
                <input type="hidden" name="unchecked-image" value="{{ unchecked_image_url | escape }}" />
            {% endif %}
            <div class="custom-checkbox"><i class="e-icon e-icon-checkmark"></i></div>
            {% if subscription_product.featured_image != blank %}
                <img loading="lazy" src="{{ subscription_product.featured_image | image_url }}" alt="{{ subscription_product.title | escape }}" />
            {% endif %}
            <p><strong>Subscribe</strong> {{ subscription_product.title }}</p>
            <div class="e-price e-price--highlight">
                <div class="e-price__main">
                    <div class="e-price__current">First bottle Free</div>
                    {% if subscription_variant.price > 0 %}
                        <div class="e-price__old">{{ subscription_variant.price | money_without_trailing_zeros }}</div>
                    {% endif %}
                </div>
            </div>
            {% if block.settings.subscription_note != blank %}
                <small>
                    {{ block.settings.subscription_note }}
                    {% if block.settings.subscription_note_mode == 'prices' %}
                        {% if recurring_price > 0 %}
                            (
                            {% if recurring_compare_at_price > recurring_price %}
                                <s>{{ recurring_compare_at_price | money_without_trailing_zeros }}</s>
                            {% endif %}
                            {{ recurring_price | money_without_trailing_zeros }}
                            )
                        {% endif %}
                    {% else %}
                        · <a href="/pages/subscriptions">{{ 'purchase-form.settings.cancel-anytime' | t }}</a>
                    {% endif %}
                </small>
            {% endif %}
        </label>
        {% if optional_layout == 'buy-form' %}
            <div class="c-optional-subscription__today">
                <p>Today you pay</p>
                <small>First bottle free</small>
                {% if main_price != blank %}
                    <div class="e-price e-price--highlight">
                        <div class="e-price__main">
                            <div class="e-price__current">{{ main_price }}</div>
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
    {% if optional_layout == 'hero' %}
        <div class="e-auto-ships">
            <i class="e-icon e-icon-rotation-2"></i>
            {{ 'purchase-form.settings.subscribe_text' | t }}
        </div>
    {% endif %}
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadScriptOnce('subscription-option', 'https://qureskincaredns-stable.com/sections/hero-product/js/subscription-option.js');
        loadScriptOnce('n-product-optional-subscription.js', '{{ 'n-product-optional-subscription.js' | asset_url }}');
    });
</script>
