{% comment %}
  Rivo loyalty is held by sapp (manual trigger in __sapp-config-frontend). Its app embed script runs one
  of the heaviest tasks on the page (~170 ms at 6-8 s, when visitors start tapping) and draws nothing on
  regular pages: the floating widget is off, and the loyalty and refer-a-friend pages run without sapp.
  What it must catch at once is a referral link (?referral_code=, any page: it shows the friend's
  discount popup), its deep links (#ba-...) and the account pages. There it starts right away, in the
  next idle moment; on every other page it starts 10 s after load, in an idle moment, so it keeps
  recording recently viewed products without competing with the visitor's first taps.
  The script has class "__init" so sapp runs it right away.
{% endcomment %}
<script class="__init">
  (() => {
    const NEEDED_NOW = /[?&]referral_code=/.test(location.search)
      || location.hash.startsWith('#ba-')
      || {{ template.name | json }} === 'customers';
    const LATE_START = 10000;
    const IDLE_TIMEOUT = 300;
    const TASK_WAIT = 15000;

    const idle = (callback) => window.requestIdleCallback
      ? window.requestIdleCallback(callback, { timeout: IDLE_TIMEOUT })
      : setTimeout(callback, 50);

    // sapp registers its tasks shortly after start, so retry until the Rivo task shows up.
    const runRivo = (waited = 0) => {
      const tasks = (window.__sapp && window.__sapp.queues && window.__sapp.queues.event) || [];
      const pending = tasks.filter((task) => {
        const src = (task.node && task.node.getAttribute('data-src')) || '';
        return src.includes('rivo-loyalty-rewards-referrals');
      });
      if (!pending.length) {
        if (waited < TASK_WAIT) setTimeout(() => runRivo(waited + 250), 250);
        return;
      }
      pending.forEach((task) => {
        if (!task.done) window.__sapp.run.task(task);
      });
    };

    if (NEEDED_NOW) {
      idle(() => runRivo());
    } else {
      setTimeout(() => idle(() => runRivo()), LATE_START);
    }
  })();
</script>
