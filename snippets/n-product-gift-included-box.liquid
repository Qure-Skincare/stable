{% doc %}
  Renders a "Gift included" box for the landing purchase form: badge, gift product
  image, name, short text and the gift price struck out next to a "Free" label.
  The price is the gift product's current price unless `price_text` overrides it.
  @param {object} block - A `gift-included` block object.
  @example
  {% render 'n-product-gift-included-box', block: block %}
{% enddoc %}
{%- assign gift_product = block.settings.product -%}
{%- assign gift_image = block.settings.image | default: gift_product.featured_image -%}
{%- assign gift_name = block.settings.name | default: gift_product.title -%}
{%- capture gift_price -%}
    {%- if block.settings.price_text != blank -%}
        {{ block.settings.price_text }}
    {%- elsif gift_product != blank -%}
        {{ gift_product.selected_or_first_available_variant.price | money_without_trailing_zeros }}
    {%- endif -%}
{%- endcapture -%}
<div class="c-gift-included-box" {{ block.shopify_attributes }}>
    {% if block.settings.badge != blank %}
        <div class="e-pill-save">{{ block.settings.badge }}</div>
    {% endif %}
    <div class="c-gift-included-box__content">
        {% if gift_image != blank %}
            <img loading="lazy" src="{{ gift_image | image_url: width: 160 }}" width="{{ gift_image.width }}" height="{{ gift_image.height }}" alt="{{ gift_name | escape }}" />
        {% endif %}
        <div>
            <strong>{{ gift_name }}</strong>
            {% if block.settings.text != blank %}
                <span>{{ block.settings.text }}</span>
            {% endif %}
        </div>
        <p>
            <span>{{ block.settings.label }}</span>
            <span>{% if gift_price != blank %}<del>{{ gift_price | strip }}</del> {% endif %}{{ block.settings.free_label }}</span>
        </p>
    </div>
</div>
