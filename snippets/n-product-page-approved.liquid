{% doc %}
  Renders a product page approved snippet for the page-header section.

  @param {object} - A section object.

  @example
  {% render 'n-product-page-approved', section: section %}
{% enddoc %}


{% for block in section.blocks %}
    {% if block.type == 'approved' %}
        <div class="c-approved-by">
            <ul>
                {% if block.settings.image_1 != blank %}
                    <li><img src="{{ block.settings.image_1 | image_url }}" alt="{{ block.settings.image_1.alt | escape }}" /></li>
                {% endif %}
                {% if block.settings.image_2 != blank %}
                    <li><img src="{{ block.settings.image_2 | image_url }}" alt="{{ block.settings.image_2.alt | escape }}" /></li>
                {% endif %}
            </ul>
            {{ block.settings.text }}
        </div>
    {% endif %}
{% endfor %}