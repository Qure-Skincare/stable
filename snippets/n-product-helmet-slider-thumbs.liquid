{% doc %}
  Renders the thumbnail navigation for the helmet product/page media carousel.

  @example
  {% render 'n-product-helmet-slider-thumbs' %}
{% enddoc %}

{% if template.name == 'page' %}
    {% assign input_media_carousel = page.metafields.custom.carousel_media.value %}
{% else %}
    {% assign input_media_carousel = product.metafields.custom.carousel_media.value %}
{% endif %}

{% if input_media_carousel != blank %}
    <div class="c-swiper-thumbs-nav">
        <div
            class="c-swiper c-swiper-thumbs"
            data-swiper='{
                "slidesPerView": "auto",
                "spaceBetween": 12
            }'
        >
            <div class="swiper-wrapper">
                {% for media in input_media_carousel.image_or_video.value %}
                    {% assign title = media | replace: 'files/', '' | replace: '.webp', '' %}
                    <div class="swiper-slide">
                        <div class="slide-thumbnail">
                            <img src="{{ media | img_url: '240x' }}" alt="{{ title }}" />
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}
