{% if array != blank %}

    <style>
        .hide {
            display: none; 
        }
    </style>

    {% assign product_counter = 0 %}
    {% assign subscription_discount_percent = blank %}
    {% assign product_prefix = 'purchase-form-products-item-' %}
    {% capture preorder-box-items %}{% endcapture %}
    {% capture product-included-dropdown %}{% endcapture %}

    {%- for __id in array -%}
        {% assign block = section.blocks | where: "id", __id | first %}
        {% if block.type == 'product_type' %}
            {% assign product_type_title = block.settings.heading | strip_newlines | strip | replace: ' ', '' | replace: ',', '_' | downcase %}
            {% if subscription_is_on == true %}
                {% assign product_type_title = product_type_title | append: '-subscription' %}
            {% endif %}
        {% endif %}
    {%- endfor -%}

    <template id="{{ section.settings.form_name }}-source-{{ section.id }}-{{ product_type_title }}">
        <ul class="c-supply-selector__list" id="{{ section.id }}-{{ product_type_title }}">
            <li class="c-supply-selector__labels">
                <ul class="supply-cards-labels">
                    {%- for __id in array -%}
                        {% assign block = section.blocks | where: "id", __id | first %}
                        {% if block.type == 'product' %}
                            {% assign product_counter = product_counter | plus: 1 %}

                            {% if subscription_is_on == true %}
                                {% if block.settings.product_discount_percent != blank %}
                                    {% assign product_prefix = 'purchase-form-products-item-subscription' %}
                                    {% assign subscription_discount_percent = block.settings.product_discount_percent %}
                                {% endif %}
                            {% endif %}

                            {% include 'get-product-data', product_handle: block.settings.product, product_prefix: product_prefix %}

                            {% if product_id %}
                                {% assign product_title_tag = block.settings.heading | strip_html | strip_newlines | strip | replace: ' ', '' | replace: ',', '_' | downcase %}

                                {% capture data-per %}{{ 'purchase-form.settings.buy-button-label' | t }} {% if product_discount != blank %} {{ 'purchase-form.settings.and' | t }} {{ 'purchase-form.settings.save' | t }} {{ product_discount }}%{% endif %}{% endcapture %}

                                {% if subscription_is_on == true and block.settings.product_selling_plan > 0 %}
                                    {% capture data-per %}{{ 'purchase-form.settings.subscribe-button-label' | t }} {% if product_discount != blank %} {{ 'purchase-form.settings.and' | t }} {{ 'purchase-form.settings.save' | t }} {{ product_discount }}%{% endif %}{% endcapture %}
                                {% endif %}

                                {% if block.settings.preorder == true %}
                                    {% capture data-per %}{{ 'purchase-form.settings.reserve-button-label' | t }} {% if product_discount != blank %} {{ 'purchase-form.settings.and' | t }} {{ 'purchase-form.settings.save' | t }} {{ product_discount }}%{% endif %}{% endcapture %}
                                {% endif %}

                                {% if block.settings.soldout == true %}
                                    {% capture data-per %}{{ 'purchase-form.settings.soldout-button-label' | t }}{% endcapture %}
                                {% endif %}

                                <li class="purchase_form_product_variant_selector{% if block.settings.preselected == true %} active{% endif %}"
                                    data-block-id="{{ block.id }}"
                                    data-tab="tab_{{ product_title_tag }}" 
                                    data-pay="{{ product_price_divided }}" 
                                    data-per="{{ data-per }}" 
                                    {% if block.settings.image != blank %}
                                    data-image="{{ block.settings.image | img_url: 'master' }}"
                                    {% endif %} 
                                    data-product_variant_id="{{ product_variant_id }}" 
                                    data-soldout="{{ block.settings.soldout }}" 
                                    data-preorder="{{ block.settings.preorder }}" 
                                    data-product-counter="{{ product_counter }}"
                                    data-product-name="{{ block.settings.heading | escape }}"
                                    {% if subscription_is_on == true and block.settings.product_selling_plan > 0 %}
                                    data-product-selling-plan="{{ block.settings.product_selling_plan }}"
                                    {% endif %}
                                    {% if block.settings.preselected == true %}
                                    data-preselected="{{ block.settings.preselected }}"
                                    {% else %}
                                    data-preselected="false"
                                    {% endif %}
                                    {% if subscription_is_on == true and block.settings.gift != blank %}
                                    data-gift="{{ all_products[block.settings.gift].variants.first.id }}"
                                    {% endif %}
                                    {% if subscription_is_on == true and block.settings.discount_code != blank %}
                                    data-discount-code="{{ block.settings.discount_code }}"
                                    {% endif %}
                                    data-product-price="{{ product_sale_price }}">

                                    <label for="{{ section.id }}-{{ product_title_tag }}">
                                        {{ block.settings.heading | replace: '(PRE-ORDER)', '' | strip }}
                                        {% if block.settings.heading contains '90' %}
                                            <div class="e-pill-badge e-pill-badge--xxs">{{ 'purchase-form.settings.best-value' | t }}</div>
                                        {% endif %}
                                    </label>
                                </li>
                            {% endif %}
                        {% endif %}
                    {%- endfor -%}
                </ul>
            </li>

            {%- for __id in array -%}
                {% assign block = section.blocks | where: "id", __id | first %}
                {% if block.type == 'product' %}
                    {% assign product_counter = product_counter | plus: 1 %}

                    {% if subscription_is_on == true %}
                        {% if block.settings.product_discount_percent != blank %}
                            {% assign product_prefix = 'purchase-form-products-item-subscription' %}
                            {% assign subscription_discount_percent = block.settings.product_discount_percent %}
                        {% endif %}
                    {% endif %}

                    {% include 'get-product-data', product_handle: block.settings.product, product_prefix: product_prefix %}

                    {% if product_id %}
                        {% assign product_title_tag = block.settings.heading | strip_html | strip_newlines | strip | replace: ' ', '' | replace: ',', '_' | downcase %}

                        {% if block.settings.total_treatments > 0 %}
                            {% if subscription_is_on == true %}
                                {% assign product_price_per_item = product_subscription_price_original | divided_by: block.settings.total_treatments | money_without_trailing_zeros %}
                            {% else %}
                                {% assign product_price_per_item = product_price_original | divided_by: block.settings.total_treatments | money_without_trailing_zeros %}
                            {% endif %}
                        {% endif %}

                        <li class="c-supply-selector__item">
                            <div class="supply-card" for="{{ section.id }}-{{ product_title_tag }}" id="{{ block.id }}-tab">
                                <input type="radio" name="purchase_form_product_variant_{{ section.settings.form_name }}" id="{{ section.id }}-{{ product_title_tag }}"{% if block.settings.preselected == true %} checked{% endif %}>
                                <div class="supply-card__content">
                                    <div class="supply-card__details">

                                        {% if product_subscription_price != blank %}
                                            <div class="e-pill-save">Save {{ product_subscription_price_diff }} Today</div>
                                        {% else %}
                                            <div class="e-pill-save">Save {{ product_price_diff }} Today</div>
                                        {% endif %}

                                        
                                        <div class="e-price">
                                            <div class="e-price__main">
                                                {% if product_subscription_price != blank %}
                                                    <div class="e-price__current igSubPrice" data-variant-id="{{ product_variant_id }}">{{ product_subscription_price }}</div>
                                                    {% if product_before_price != blank %}
                                                        <div class="e-price__old igComparePrice" data-variant-id="{{ product_variant_id }}">{{ product_before_price }}</div>
                                                    {% endif %}
                                                {% else %}
                                                    <div class="e-price__current igPrice" data-variant-id="{{ product_variant_id }}">{{ product_sale_price }}</div>
                                                    {% if product_before_price != blank %}
                                                        <div class="e-price__old igComparePrice" data-variant-id="{{ product_variant_id }}">{{ product_before_price }}</div>
                                                    {% endif %}
                                                {% endif %}
                                            </div>
                                        </div>

                                        {% if block.settings.heading contains '90' %}
                                            <p><strong>Just {{ product_price_divided_90 }}/day for first month</strong></p>
                                        {% else %}
                                            <p><strong>Just {{ product_price_divided_30 }}/day for first month</strong></p>
                                        {% endif %}

                                        {% if block.settings.included_text != blank %}
                                            {{ block.settings.included_text |  replace: '<ul>', '<ul class="c-marked-list c-marked-list--fill">' }}
                                        {% endif %}
                                    </div>
                                    <figure class="supply-card__image">
                                        {% if block.settings.image != blank %}
                                            <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                        {% endif %}
                                        <figcaption>{{ 'purchase-form.settings.per-treatment' | t: price: product_price_per_item }}</figcaption>
                                    </figure>
                                </div>

                                {% if subscription_is_on == true and block.settings.gift != blank %}
                                    <div class="supply-card__gift">
                                        <div class="gift-notice">
                                            {{ 'purchase-form.settings.gift_image_html' | t }}
                                            <p>
                                                <strong>{{ 'purchase-form.settings.free_gift' | t }}</strong> 
                                                {% if block.settings.gift_text != blank %}
                                                    {{ block.settings.gift_text }}
                                                {% else %}
                                                    {{ 'purchase-form.settings.gift' | t }}
                                                {% endif %}
                                            </p>
                                            <div class="e-pill-save"><strong>{{ 'purchase-form.settings.free' | t }}</strong></div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </li>

                        {% if block.settings.preorder == true %}
                            
                            {% capture preorder-box-items %}{{ preorder-box-items }}<div class="{{ section.settings.form_name }}-preorder-box-item {{ section.settings.form_name }}-preorder-box__{{ product_variant_id }}"></div>{% endcapture %}
                            
                            {% if block.settings.preorder_text != blank %}
                                <span class="{{ section.settings.form_name }}-product-preorder-text__{{ product_variant_id }} hide">{{ block.settings.preorder_text }}</span>
                            {% endif %}
                            {% if block.settings.preorder_date_soldout != blank %}
                                <span class="{{ section.settings.form_name }}-product-preorder_date_soldout__{{ product_variant_id }} hide">{{ block.settings.preorder_date_soldout }}</span>
                            {% endif %}
                            {% if block.settings.preorder_date_reserved != blank %}
                                <span class="{{ section.settings.form_name }}-product-preorder_date_reserved__{{ product_variant_id }} hide">{{ block.settings.preorder_date_reserved }}</span>
                            {% endif %}
                            {% if block.settings.preorder_percent != blank %}
                                <span class="{{ section.settings.form_name }}-product-preorder_percent__{{ product_variant_id }} hide">{{ block.settings.preorder_percent }}</span>
                            {% endif %}
                        {% endif %}

                    {% endif %}
                {% endif %}
            {%- endfor -%}
        </ul>

        {{ preorder-box-items }}
        {{ preorder_box }}
    </template>
{% endif %}