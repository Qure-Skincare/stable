<script class="sapp-init" type="application/json" id="sapp-config">
{
  "license": {
    "host": {{ shop.permanent_domain | json }},
    "token": {{ sapp_license_token | json }},
    "expiresAt": {{ sapp_license_expires }}
  },
  "debug": false,
  "timeouts": {
    {% comment %} "mobile":  { "preload": "1000", "scripts": "2500", "other": "2900", "async": "3500" }, {% endcomment %}
    {% comment %} "desktop": { "preload": "500", "scripts": "2500", "other": "2900", "async": "3500" } {% endcomment %}
    "mobile":  { "preload": "none", "scripts": "none", "other": "none", "async": "none" },
    "desktop": { "preload": "none", "scripts": "none", "other": "none", "async": "none" }
  },
  "queueOptions": {
    "async": { "stagger": 800 }
  },
  "dispatchSyntheticEvents": true,
  "defaultMediaTrigger": "scroll",
  "rules": [
    { 
      "match": { "innerHTML": "ShopifyAnalytics" },
      "queue": "loaded",
      "trigger": "timeout"
    },
    { 
      "match": { "id": "web-pixels-manager-setup" },
      "queue": "other",
      "trigger": "timeout"
    },
    { 
      "match": { "src": "portable-wallets" },
      "queue": "event",
      "trigger": ["scroll", "click", "touchstart", "mousemove"] 
    }
  ],
  "exceptions": {
    "id":        ["sapp-config"],
    "class":     ["sapp-init", "__init"],
    "innerHTML": {{ sapp_init_innerhtml | json }},
    "src":       {{ sapp_init_src | json }}
  }
}
</script>