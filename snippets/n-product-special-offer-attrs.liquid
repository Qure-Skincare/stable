{% doc %}
  Outputs the class and data-label attributes for a "c-special-offer" price block.
  When the sitewide sale is on, adds the "c-special-offer--bf" modifier and the active campaign label:
  Holiday offer, then BF offer, otherwise the default label.

  @param {string} label - Default label (falls back to special-offer.settings.header).

  @example
  <div {% render 'n-product-special-offer-attrs' %}>
  <div {% render 'n-product-special-offer-attrs', label: 'SPECIAL OFFER' %}>
{% enddoc %}

{%- assign default_label = 'special-offer.settings.header' | t -%}
{%- assign offer_label = label | default: default_label -%}
{%- if settings.black_friday_sitewide_turn_on -%}
    {%- if settings.holiday_offer_turn_on -%}
        {%- assign offer_label = 'special-offer.settings.holiday-header' | t -%}
    {%- elsif settings.bf_pdp_badge -%}
        {%- assign offer_label = 'special-offer.settings.bf-header' | t -%}
    {%- endif -%}
    class="c-special-offer c-special-offer--bf" data-label="{{ offer_label }}"
{%- else -%}
    class="c-special-offer" data-label="{{ offer_label }}"
{%- endif -%}
