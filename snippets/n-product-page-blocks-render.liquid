{% doc %}
  Renders sections blocks for product-header section

  @param {section} - A section object.
  @param {allowed_types} - A string value.
  @param {render} - A string value.

  @example
  {% render 'n-product-page-blocks-render', section: section, allowed_types: '', render: '' %}
{% enddoc %}

{% if render != blank %}
    {{ render }}
{% endif %}

{% for block in section.blocks %}
    {% case block.type %}
        {% when 'badge' %}
            {% render 'n-product-badge', block: block %}
        {% when 'description' %}
            {% unless section.settings.rating_type == 'trustpilot' %}
                {% render 'n-product-description', description: section.settings.description %}
            {% endunless %}
        {% when 'description-aio' %}
            {% render 'n-product-description-aio', block: block %}
        {% when 'quote' %}
            {% render 'n-product-expert-quote-tag', block: block %}
        {% when 'price' %}
            {% if black_friday_discount_percent > 0 %}
                {% render 'n-product-price-special-offer', product_sale_price: product_sale_price, product_before_price: product_before_price, product_discount: product_discount, product_black_friday_price: product_black_friday_price, black_friday_discount: black_friday_discount %}
            {%- elsif block.settings.bundle_compare != blank -%}
                {% render 'n-product-price-bundle', product_sale_price: product_sale_price, product_price: product_price_original, product_before_price: product_before_price, product_discount: product_discount, section: section, block: block %}
            {%- else -%}
                {% render 'n-product-price', product_sale_price: product_sale_price, product_before_price: product_before_price, product_discount: product_discount, section: section, block: block %}
            {%- endif -%}
        {% when 'saveup-offer' %}
            {% render 'n-product-saveup-offer' %}
        {% when 'limited-offer' %}
            {% render 'n-product-limited-time-offer', section: section, block: block %}
        {% when 'black-friday-discount' %}
            {% render 'n-product-page-black-friday-discount', section: section, block: block, black_friday_discount_percent: black_friday_discount_percent %}
        {% when 'exclusive-offer' %}
            {% include 'n-product-exclusive-offer', section: section, block: block %}
        {% when 'exclusive-offer-bundle' %}
            {% include 'n-product-exclusive-offer-bundle', section: section, block: block %}
        {% when 'upsell-popup' %}
            {% include 'n-product-upsell-popup', section: section, block: block %}
        {% when 'nextships' %}        
            {% render 'n-product-page-next-ships', section: section %}
        {% when 'optional-subscription' %}
            {% render 'n-product-optional-subscription', section: section, block: block, product: product %}
        {% when 'button' %}
            {% assign has_optional_subscription = false %}
            {% assign optional_subscription_layout = blank %}
            {% for _block in section.blocks %}
                {% if _block.type == 'optional-subscription' %}
                    {% assign has_optional_subscription = true %}
                    {% assign optional_subscription_layout = _block.settings.layout %}
                {% endif %}
            {% endfor %}
            {% render 'n-product-page-buy-button', product_price: null, product_variant_id: product_variant_id, product_price_divided: product_price_divided, section: section, product_available: product_available, static: has_optional_subscription, optional_subscription_layout: optional_subscription_layout %}
        {% when 'video' %}
            {% render 'n-page-video', section: section, block: block %}
        {% when 'section' %}
            {% render 'n-product-page-async-section', section: section, block: block %}
        {% when 'results' %}
            {% render 'n-product-page-results', section: section, block: block %}
        {% when 'link' %}
            {% render 'n-page-link-button', section: section %}
        {% when 'money-back' %}
            {% unless section.settings.rating_type == 'trustpilot' %}
                {% render 'n-product-money-back', section: section, block: block %}
            {% endunless %}
        {% endcase %}
{% endfor %}