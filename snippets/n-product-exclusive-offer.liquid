{% doc %}
  Renders a product exclusive offer snippet for the page-header section

  @param {object} - A section object.
  @param {object} - A block object.

  @example
  {% render 'n-product-exclusive-offer', section: '', block: '' %}
{% enddoc %}

{% if block == blank %}
    {% for _block in section.blocks %}
        {% if _block.type == 'exclusive-offer' %}
            {% assign block = _block %}
        {% endif %}
    {% endfor %}
{% endif %}

{% assign exclusive_offer_product2 = all_products[block.settings.product2] %}
{% assign exclusive_offer_product2_black_variant_id = blank %}
{% if exclusive_offer_product2 != blank %}
    {% for variant in exclusive_offer_product2.variants %}
        {% assign variant_title = variant.title | downcase %}
        {% assign variant_option1 = variant.option1 | downcase %}
        {% assign variant_option2 = variant.option2 | downcase %}
        {% assign variant_option3 = variant.option3 | downcase %}
        {% if variant_title contains 'black' or variant_option1 contains 'black' or variant_option2 contains 'black' or variant_option3 contains 'black' %}
            {% assign exclusive_offer_product2_black_variant_id = variant.id %}
            {% break %}
        {% endif %}
    {% endfor %}
{% endif %}
{% if exclusive_offer_product2_black_variant_id == blank and exclusive_offer_product2 != blank %}
    {% assign exclusive_offer_product2_black_variant_id = exclusive_offer_product2.selected_or_first_available_variant.id %}
{% endif %}

<div class="c-exclusive-offer">
    <div class="c-exclusive-offer__tag">

        {% if block.settings.tag != blank %}
            <div class="e-double-tag">{{ block.settings.tag | replace: '<p>', '' | replace: '</p>', '' }}</div>
        {% else %}
            {{ 'page.exclusive-offer.n_header_html' | t }}
        {% endif %}
        
    </div>
    <div class="c-exclusive-offer__list">
        <div class="c-exclusive-offer__item">
            {% include 'get-product-data', product_handle: block.settings.product, product_prefix: 'product-exclusive-offer-' %}
            {% if block.settings.image_product1 != blank %}
                <img loading="eager" src="{{ block.settings.image_product1 | img_url: '250x' }}" alt="{{ block.settings.image_product1.alt | escape }}" />
            {% endif %}
            <div>{{ product_sale_price }}</div>
        </div>
        <i class="e-icon e-icon-plus"></i>

        <div class="c-exclusive-offer__item">
            {% include 'get-product-data', product_handle: block.settings.product2, product_prefix: 'product-exclusive-offer-' %}
            {% if block.settings.image_product2 != blank %}
                <img loading="eager" src="{{ block.settings.image_product2 | img_url: '250x' }}" alt="{{ block.settings.image_product2.alt | escape }}" />
            {% endif %}
            <div><del>{{ product_sale_price }}</del> <strong>{{ 'page.exclusive-offer.free' | t }}</strong></div>
        </div>
    </div>
    <p class="c-exclusive-offer__desc">{{ block.settings.text |  replace: '<p>', '' |  replace: '</p>', '' | replace: '$299', product_sale_price }}</p>
</div>

{% if product != blank and block.settings.discount_code != blank %}
    {% assign exclusive_offer_product1 = all_products[block.settings.product] %}
    {% assign exclusive_offer_product1_variant_id = exclusive_offer_product1.variants.first.id %}
    <script class="__init">
        (function () {
            // Everything the offer needs is rendered inline — no dependency on
            // the deferred get-product-data store, so the interception arms
            // immediately even when sapp activates scripts late on a slow link.
            window.exclusive_button_label = '{{ 'page.exclusive-offer.button-label' | t }} {{ product_sale_price }}';
            window.exclusive_product_variant_id = '{{ exclusive_offer_product1_variant_id }}';
            window.exclusive_product2_black_variant_id = '{{ exclusive_offer_product2_black_variant_id }}';
            window.exclusive_offer_discount_code = '{{ block.settings.discount_code }}';

            function loadExclusiveOffer() {
                loadScriptOnce('n-product-exclusive-offer.js', '{{ 'n-product-exclusive-offer.js' | asset_url }}');
            }

            if (document.readyState === 'loading') {
                document.addEventListener("DOMContentLoaded", loadExclusiveOffer);
            } else {
                loadExclusiveOffer();
            }
        })();
    </script>
{% endif %}

{% comment %}
  The two get-product-data includes above leak product2's variables into the
  parent include scope — a buy-button block rendered after this one would
  submit product2's variant id. Re-run for the main product to restore
  product_variant_id and the other shared variables.
{% endcomment %}
{% include 'get-product-data', product_handle: block.settings.product, product_prefix: 'product-exclusive-offer-' %}