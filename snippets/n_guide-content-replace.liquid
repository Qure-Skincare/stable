{% assign quote_content_is_shown = false %}
{% assign wistia_video_is_shown = false %}
{% assign image_is_shown = false %}

{% assign processed_text = section.settings.text %}

{% assign quote_number = 0 %}
{% capture quote_content %}
    {% for block in section.blocks %}
        {% if block.type == 'quote' %}
            {% assign quote_number = quote_number | plus: 1 %}
            {% capture quote_note %}
                <div class="c-note{% if block.settings.style == 'blue' %} c-note--info{% elsif block.settings.style == 'red' %} c-note--warning{% endif %}">
                    {% if block.settings.text != blank %}
                        {{ block.settings.text }}
                    {% endif %}
                </div>
            {% endcapture %}
            {% capture quote_placeholder %}<p>[quote_{{ quote_number }}]</p>{% endcapture %}
            {% if processed_text contains quote_placeholder %}
                {% assign processed_text = processed_text | replace: quote_placeholder, quote_note %}
            {% else %}
                {{ quote_note }}
            {% endif %}
        {% endif %}
    {% endfor %}
{% endcapture %}
{% assign quote_content = quote_content | strip %}

{% capture wistia_video_content %}
    {% for block in section.blocks %}
        {% if block.type == 'wistia_video' %}
            {% if block.settings.wistia_url != blank and block.settings.image != blank %}
                <div class="c-wistia c-wistia--custom{% if block.settings.desktop %} d-none d-lg-block{% endif %}">
                    <wistia-player media-id="{{ block.settings.wistia_url }}" wistia-popover="true" popover-content="link" end-video-behavior="loop" controls-visible-on-load="false" play-button="false">
                        <div class="c-wistia__custom">
                            <figure>
                                <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                {% if block.settings.label_text != blank %}
                                    <figcaption>{{ block.settings.label_text }}</figcaption>
                                {% endif %}
                            </figure>
                        </div>
                    </wistia-player>
                </div>
            {% endif %}
        {% endif %}
    {% endfor %}
{% endcapture %}

{% capture image_content %}
    {% for block in section.blocks %}
        {% if block.type == 'image' %}
            <picture>
                <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
            </picture>
        {% endif %}
    {% endfor %}
{% endcapture %}

{% if section.settings.text contains '[quote_content]' %}
    {% assign quote_content_is_shown = true %} 
{% endif %}

{% if section.settings.text contains '[wistia_video]' %}
    {% assign wistia_video_is_shown = true %}
{% endif %}

{% if section.settings.text contains '[image]' %}
    {% assign image_is_shown = true %}
{% endif %}

{% if section.settings.text != blank %}
    
    {% if quote_content_is_shown == true %}
        {% if quote_content != blank %}
            {% assign processed_text = processed_text | replace: '<p>[quote_content]', quote_content %}
        {% else %}
            {% assign processed_text = processed_text | replace: '<p>[quote_content]', '' %}
        {% endif %}
    {% endif %}
    
    {% if wistia_video_is_shown == true %}
        {% if wistia_video_content != blank %}
            {% assign processed_text = processed_text | replace: '<p>[wistia_video]', wistia_video_content %}
        {% else %}
            {% assign processed_text = processed_text | replace: '<p>[wistia_video]', '' %}
        {% endif %}
    {% endif %}
    
    {% if image_is_shown == true %}
        {% if image_content != blank %}
            {% assign processed_text = processed_text | replace: '<p>[image]', image_content %}
        {% else %}
            {% assign processed_text = processed_text | replace: '<p>[image]', '' %}
        {% endif %}
    {% endif %}
    
    {% assign processed_text = processed_text | replace: '<p>[hr]</p>', '<hr />' %}
    
    {{ processed_text }}
{% endif %}
