{% doc %}
  Renders a trusted reviews section
{% enddoc %}

{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/trusted-reviews/trusted-reviews.css" />
{% endif %}
<section class="trusted-reviews{% if section.settings.modifier == 'trustpilot' %} trusted-reviews--trustpilot{% endif %}{% if section.settings.background_color != 'none' %} trusted-reviews--{{ section.settings.background_color }}{% endif %}" id="{{ section.settings.section_id | default: 'trusted-reviews' }}">
    <div class="container">
        {% if section.settings.modifier == 'trustpilot' %}
            <i class="e-icon e-icon-qure"></i>
            {{ section.settings.heading }}
            <div class="trustpilot-rating">
                <div class="trustpilot-rating__stars">
                    <a href="#">{{ 'sections.n_trusted-reviews.excellent' | t }}</a>
                    <div class="e-rating-stars" style="--rating: 4.7"></div>
                </div>
                <div class="trustpilot-rating__rating">
                    {{ 'sections.n_trusted-reviews.based_on_html' | t }}
                    <img src="https://qureskincaredns-stable.com/assets/images/trustpilot.webp" alt="Trustpilot" />
                </div>
            </div>
            <p class="e-disclaimer">{{ section.settings.disclaimer }}</p>
        {% else %}
            {{ section.settings.text }}
        {% endif %}
        {% if section.settings.modifier == 'trustpilot' %}
        <div
            class="c-swiper"
            data-swiper='{"slidesPerView":1.1,"spaceBetween":16,"loop":false,"pagination":{"el":".c-swiper-pagination","type":"custom"},"navigation":{"prevEl":".c-swiper-button-prev","nextEl":".c-swiper-button-next"},"breakpoints":{"768":{"slidesPerView":2},"992":{"spaceBetween":24,"slidesPerView":3 }}}'>
        {% else %}
        <div
            class="c-swiper"
            data-swiper='{
            "slidesPerView": 1.1,
            "spaceBetween": 16,
            "loop": false,
            "pagination": {
                "el": ".c-swiper-pagination",
                "type": "custom"
            },
            "navigation": {
                "prevEl": ".c-swiper-button-prev",
                "nextEl": ".c-swiper-button-next"
            },
            "breakpoints": {
                "768": {
                    "slidesPerView": 2,
                    "spaceBetween": 24
                },
                "992": {
                    "slidesPerView": 3
                }
            }
        }'>
        {% endif %}
            <div class="swiper-wrapper">
                {% for block in section.blocks %}
                    {% if block.type == 'slider' %}
                        <div class="swiper-slide{% if forloop.index == 1 %} active{% endif %}">
                            <div class="c-trusted-review-card">
                                {% if block.settings.image != blank %}
                                    <picture>
                                        <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                    </picture>
                                {% endif %}
                                {% if block.settings.flag != blank and block.settings.username != blank %}
                                    <div class="e-author">
                                        <img loading="lazy" src="{{ block.settings.flag | image_url }}" alt="{{ block.settings.flag.alt | escape }}" />
                                        {{ block.settings.username }}
                                    </div>
                                {% endif %}
                                {% if block.settings.verified_customer != blank %}
                                    <div class="e-verified-customer">
                                        <div class="e-checkmark"></div>
                                        {{ block.settings.verified_customer }}
                                    </div>
                                {% endif %}
                                {% if block.settings.badge != blank %}
                                    <div class="e-pill-badge e-pill-badge--sm">{{ block.settings.badge }}</div>
                                {% endif %}
                                {% if block.settings.text != blank %}
                                    <article>
                                        {{ block.settings.text }}
                                    </article>
                                {% endif %}
                                {% if block.settings.product_url != blank %}
                                    <a href="{{ block.settings.product_url }}">
                                        {% if block.settings.product_image != blank %}
                                            <img loading="lazy" src="{{ block.settings.product_image | image_url }}" alt="{{ block.settings.product_image.alt | escape }}" />
                                        {% endif %}
                                        {% if block.settings.product_text != blank %}
                                            <small>{{ block.settings.product_text }}</small>
                                        {% endif %}
                                        {% if block.settings.product_title != blank %}
                                            <span>{{ block.settings.product_title }}</span>
                                        {% endif %}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            <div class="c-swiper-nav">
                <button class="c-swiper-button-prev" aria-label="prev"></button>
                <div class="c-swiper-pagination"></div>
                <button class="c-swiper-button-next" aria-label="next"></button>
            </div>
        </div>
        {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_url }}" class="btn btn--primary" type="button">{{ section.settings.button_label }}</a>
        {% endif %}
    </div>
</section>

{% schema %}
{
    "name": "t:sections.n_trusted-reviews.name",
        "settings": [
            {
                "type": "checkbox",
                "id": "use_own_file",
                "label": "t:common.use-own-file",
                "default": false
            },
            {
                "type": "select",
                "id": "background_color",
                "label": "t:common.background-color",
                "default": "none",
                "options": [
                    {
                        "value": "none",
                        "label": "t:common.none"
                    },
                    {
                        "value": "light",
                        "label": "t:common.light"
                    }
                ]
            },
            {
                "type": "select",
                "id": "modifier",
                "label": "t:common.modifier",
                "default": "none",
                "options": [
                    {
                        "value": "none",
                        "label": "t:common.none"
                    },
                    {
                        "value": "trustpilot",
                        "label": "t:common.trustpilot"
                    }
                ]
            },
            {
                "type": "text",
                "id": "section_id",
                "label": "t:common.section_id"
            },
            {
                "type": "richtext",
                "id": "heading",
                "label": "t:common.header"
            },
            {
                "type": "text",
                "id": "disclaimer",
                "label": "t:common.disclaimer"
            },
            {
                "type": "richtext",
                "id": "text",
                "label": "t:common.text"
            },
            {
                "type": "text",
                "id": "button_label",
                "label": "t:common.button-label"
            },
            {
                "type": "url",
                "id": "button_url",
                "label": "t:common.button-url"
            }
    ],
    "blocks": [
        {
            "type": "slider",
            "name": "t:common.slider",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "image_picker",
                    "id": "flag",
                    "label": "t:common.flag"
                },
                {
                    "type": "text",
                    "id": "username",
                    "label": "t:common.username"
                },
                {
                    "type": "text",
                    "id": "verified_customer",
                    "label": "t:common.verified-customer",
                    "default": "Verified customer"
                },
                {
                    "type": "text",
                    "id": "badge",
                    "label": "t:common.badge"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                },
                {
                    "type": "url",
                    "id": "product_url",
                    "label": "t:common.product-url"
                },
                {
                    "type": "image_picker",
                    "id": "product_image",
                    "label": "t:common.product-image"
                },
                {
                    "type": "text",
                    "id": "product_text",
                    "label": "t:common.product-text"
                },
                {
                    "type": "text",
                    "id": "product_title",
                    "label": "t:common.product-title"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_trusted-reviews.name"
        }
    ]
}
{% endschema %}