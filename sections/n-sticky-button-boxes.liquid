{% doc %}
  Renders a sticky CTA section.
{% enddoc %}

{% include 'get-product-data', product_handle: product.handle, product_prefix: 'sticky-button-' %}



<!-- BUNDLE CTA BAR -->
<section class="bundle-cta-bar">
    <details class="bundle-cta-bar__content" open>
        <summary class="bundle-cta-bar__summary">
            Bundle &amp; Save up to 30%
            <i class="e-icon e-icon-chevron"></i>
        </summary>
        <div class="bundle-cta-bar__container container">
            <ul class="bundle-cta-bar__progress" style="--bundle-progress: 50%">
                <li>
                    <img src="https://qureskincaredns-stable.com/sections/isolated/sticky-cta/images/build-your-own-1.webp" alt="Product 1" />
                    <button type="button"><i class="e-icon e-icon-cross"></i></button>
                </li>
                <li>
                    <img src="https://qureskincaredns-stable.com/sections/isolated/sticky-cta/images/build-your-own-2.webp" alt="Product 2" />
                    <button type="button"><i class="e-icon e-icon-cross"></i></button>
                </li>
                <li>
                    <span>25%</span>
                </li>
                <li>
                    <span>30%</span>
                </li>
            </ul>
            <div class="bundle-cta-bar__amount">
                Subtotal:
                <div class="e-price">
                    <div class="e-price__main">
                        <div class="e-price__current">{$dyn}</div>
                        <div class="e-price__old">{$dyn}</div>
                    </div>
                </div>
            </div>
            <div class="bundle-cta-bar__button">
                <button class="btn btn--primary" type="button">
                    CHECKOUT
                    <i class="e-icon e-icon-lock"></i>
                </button>
            </div>
        </div>
    </details>
</section>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadScriptOnce("bundle-cta-bar", "https://qureskincaredns-stable.com/sections/new/bundle-cta-bar/bundle-cta-bar.js");
    });
</script>
<!-- BUNDLE CTA BAR END -->

{%  schema  %}  
{
  "name": "t:sections.sticky-button.name",
  "class": "cta-bar-position",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.header"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:common.text"
    },
    {
        "type": "checkbox",
        "id": "limited",
        "label": "t:common.limited",
        "default": false
    },
    {
      "type": "text",
      "id": "button-label",
      "label": "t:common.button-label"
    },
    {
      "type": "text",
      "id": "button-url",
      "label": "t:common.button-url"
    }
  ],
  "presets": [
    {
      "name": "t:sections.sticky-button.name"
    }
  ]
}
{% endschema %}