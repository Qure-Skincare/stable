{% comment %}
  Sticky bundle CTA bar.
  Shows up to 4 selected bundle products with tiered discounts (15/20/25/30%).
  Powered by assets/n-bundle-selection.js which syncs with [data-bundle-button] cards.
{% endcomment %}

{% include 'get-product-data', product_handle: product.handle, product_prefix: 'sticky-button-' %}

<link rel="stylesheet" href="{{ 'n-bundle-selection.css' | asset_url }}">

<!-- BUNDLE CTA BAR -->
<section class="bundle-cta-bar">
    <details class="bundle-cta-bar__content" open>
        <summary class="bundle-cta-bar__summary">
            {{ section.settings.heading | default: 'Bundle &amp; Save up to 30%' }}
            <i class="e-icon e-icon-chevron"></i>
        </summary>
        <div class="bundle-cta-bar__container container">
            <ul class="bundle-cta-bar__progress" data-bundle-progress style="--bundle-progress: 0%">
                {% assign tier_percents = '15,20,25,30' | split: ',' %}
                {% for percent in tier_percents %}
                    <li data-bundle-slot="{{ forloop.index }}">
                        <span class="bundle-cta-bar__discount">{{ percent }}%</span>
                        <div class="bundle-cta-bar__product">
                            <img data-bundle-slot-image alt="" width="100" height="100" />
                            <button type="button" data-bundle-remove aria-label="Remove from bundle">
                                <i class="e-icon e-icon-cross"></i>
                            </button>
                        </div>
                    </li>
                {% endfor %}
            </ul>
            <div class="bundle-cta-bar__amount" data-bundle-amount>
                Subtotal:
                <div class="e-price">
                    <div class="e-price__main">
                        <div class="e-price__current" data-bundle-current></div>
                        <div class="e-price__old" data-bundle-original></div>
                    </div>
                </div>
            </div>
            <div class="bundle-cta-bar__button">
                <button class="btn btn--primary" type="button" data-bundle-cta disabled>
                    {{ section.settings['button-label'] | default: 'CHECKOUT' }}
                    <i class="e-icon e-icon-lock"></i>
                </button>
            </div>
        </div>
    </details>
</section>
<script>
    window.NBundleSelectionConfig = window.NBundleSelectionConfig || {
        moneyFormat: {{ shop.money_format | json }},
        moneyFormatNoTrailing: {{ shop.money_without_trailing_zeros_format | json }}
    };
    document.addEventListener("DOMContentLoaded", function () {
        loadScriptOnce("bundle-cta-bar", "https://qureskincaredns-stable.com/sections/new/bundle-cta-bar/bundle-cta-bar.js");
        loadScriptOnce("n-bundle-selection", "{{ 'n-bundle-selection.js' | asset_url }}");
    });
</script>
<!-- BUNDLE CTA BAR END -->

{%  schema  %}
{
  "name": "t:sections.sticky-button.name",
  "class": "cta-bar-position",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.header"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:common.text"
    },
    {
        "type": "checkbox",
        "id": "limited",
        "label": "t:common.limited",
        "default": false
    },
    {
      "type": "text",
      "id": "button-label",
      "label": "t:common.button-label"
    },
    {
      "type": "text",
      "id": "button-url",
      "label": "t:common.button-url"
    }
  ],
  "presets": [
    {
      "name": "t:sections.sticky-button.name"
    }
  ]
}
{% endschema %}
