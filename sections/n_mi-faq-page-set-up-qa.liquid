{% doc %}
    Renders a set up qa section for microinfusion faq page 2.
{% enddoc %}

<!-- SET UP -->
{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/set-up/set-up.css" />
{% endif %}
<section class="set-up set-up--qa">
    <div class="container">
        {% if section.settings.wistia_url != blank %}
            <div class="c-wistia c-wistia--custom">
                <wistia-player media-id="{{ section.settings.wistia_url }}" wistia-popover="true" popover-content="link" end-video-behavior="loop" controls-visible-on-load="false" play-button="false">
                    <div class="c-wistia__custom">
                        <picture>
                            {% if section.settings.image != blank %}
                                <source media="(min-width:768px)" srcset="{{ section.settings.image | image_url }}" />
                            {% endif %}
                            {% if section.settings.image_mobile != blank %}
                                <img loading="lazy" src="{{ section.settings.image_mobile | image_url }}" alt="{{ section.settings.image_mobile.alt | escape }}" />
                            {% endif %}
                        </picture>
                    </div>
                </wistia-player>
            </div>
        {% endif %}
        {{ section.settings.text }}
        <ol>
            {% for block in section.blocks %}
                {% if block.type == 'items' %}
                    <li>
                        <picture>
                            {% if block.settings.image != blank %}
                                <source media="(min-width:768px)" srcset="{{ block.settings.image | image_url }}" />
                            {% endif %}
                            {% if block.settings.image_mobile != blank %}
                                <img loading="lazy" src="{{ block.settings.image_mobile |  image_url }}" alt="{{ block.settings.image_mobile.alt | escape }}" />
                            {% endif %}
                        </picture>
                        {{ block.settings.text }}
                    </li>
                {% endif %}
            {% endfor %}
        </ol>
    </div>
</section>
<!-- SET UP END -->

{% schema %}
{
    "name": "t:sections.n_mi-faq-page-set-up-qa.name",
    "settings": [
        {
            "type": "checkbox",
            "id": "use_own_file",
            "label": "t:common.use-own-file",
            "default": false
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:common.image"
        },
        {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "t:common.image-mobile"
        },
        {
            "type": "text",
            "id": "wistia_url",
            "label": "t:common.wistia-url"
        }
    ],
    "blocks": [
        {
            "type": "items",
            "name": "t:common.items",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "image_picker",
                    "id": "image_mobile",
                    "label": "t:common.image-mobile"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        }
    ]
}
{% endschema %}