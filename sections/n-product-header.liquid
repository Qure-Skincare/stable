{% doc %}
  Renders a product header section
{% enddoc %}

{%- liquid
  if product == blank
    if section.settings.product != blank
      assign product = section.settings.product
    endif
  endif
-%}

{% include 'get-product-data' %}

{% assign slider_element_id = section.settings.section_id | default: 'hero-product' | prepend: '#' %}

{% assign gallery_first_image = blank %}
{% for _block in section.blocks %}
    {% if _block.type == 'optional-subscription' and _block.settings.checked_image != blank %}
        {% assign gallery_first_image = _block.settings.checked_image %}
    {% endif %}
{% endfor %}

<section class="hero-product{% if section.settings.reverse == true %} hero-product--reverse{% endif %}{% if section.settings.secondary == true %} hero-product--secondary{% endif %}{% if section.settings.background == true %} hero-product--bg{% endif %}" id="{{ section.settings.section_id }}">
    <div class="hero-product__container container">
        <div class="hero-product__gallery">
            {% if section.settings.image != blank %}
                <img loading="lazy" src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt | escape }}" />
            {% else %}
                {% render 'n-product-page-slider', product: product, page: page, element_id: slider_element_id, slidesPerView: 1, spaceBetween: 16, first_image: gallery_first_image %}
                {% render 'n-product-page-slider-thumbs', product: product, page: page, slidesPerView: 'auto', spaceBetween: 12, first_image: gallery_first_image %}
                {% render 'n-product-page-slider-sticky-video', section: section %}
            {% endif %}
        </div>
        <div class="hero-product__main">

            {% render 'n-product-page-approved', section: section, product: product %}

            {% if section.settings.rating != blank and section.settings.rating_type != 'trustpilot' %}
                {% render 'n-product-rating', product: product, rating_type: section.settings.rating_type %}
            {% endif %}

            {% if section.settings.seo_heading != blank %}
                <p>{{ section.settings.seo_heading }}</p>
            {% endif %}

            {% if section.settings.badge_text != blank %}
                <div class="e-pill-badge">{{ section.settings.badge_text }}</div>
            {% endif %}

            {% if section.settings.heading != blank %}
                {% if section.settings.heading_level == 'h2' %}
                    <h2>{{ section.settings.heading }}</h2>
                {% else %}
                    <h1>{{ section.settings.heading }}</h1>
                {% endif %}
            {% endif %}

            {% render 'n-product-page-trustpilot', section: section, product: product %}

            {% include 'n-product-page-blocks-render' %}
        </div>
        <div class="hero-product__extra">
            {% render 'n-product-page-stats', section: section %}
            {% include 'n-product-upsell-card' %}
            {% include 'n-product-page-cross-sell', product: product %}
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'accordion' %}
                        {% render 'n-product-page-collapsed', product: product, page: page, section: section %}
                {% endcase %}
            {% endfor %}
            {% render 'n-product-page-trustpilot', section: section, extra: true %}
            {% render 'n-product-page-jumpto', section: section %}
        </div>
    </div>
</section>

{% if product %}
    {% render 'n-product-data-json', product: product %} 
{% endif %}

