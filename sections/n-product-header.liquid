{% doc %}
  Renders a product header section
{% enddoc %}

{% include 'get-product-data' %}

<section class="hero-product{% if section.settings.reverse == true %} hero-product--reverse{% endif %}" id="hero-product">
    <div class="hero-product__container container">
        <div class="hero-product__gallery">
            {% if section.settings.image != blank %}
                <img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt | escape }}" />
            {% else %}
                {% render 'n-product-page-slider', product: product, page: page, element_id: '#hero-product', slidesPerView: 1, spaceBetween: 16 %}
                {% render 'n-product-page-slider-thumbs', product: product, page: page, slidesPerView: 'auto', spaceBetween: 12 %}
                {% render 'n-product-page-slider-sticky-video', section: section %}
            {% endif %}
        </div>
        <div class="hero-product__main">

            {% render 'n-product-page-approved', section: section %}

            {%- if product != blank -%}
                {% if section.settings.rating != blank %}
                    {% render 'n-product-rating', product: product %}
                {% endif %}
            {%- else -%}
                {% render 'n-page-rating', section: section %}
            {%- endif -%}


            {% if section.settings.seo_heading != blank %}
                <p>{{ section.settings.seo_heading }}</p>
            {% endif %}

            {% if section.settings.heading != blank %}
                <h1>{{ section.settings.heading }}</h1>
            {% endif %}

            {% include 'n-product-page-blocks-render' %}
        </div>
        <div class="hero-product__extra">
            {% include 'n-product-page-cross-sell', product: product %}
            {% render 'n-product-page-collapsed', product: product, page: page %}
            {% render 'n-product-page-jumpto', section: section %}
        </div>
    </div>
</section>

{% if product %}
    {% render 'n-product-data-json', product: product %} 
{% endif %}

