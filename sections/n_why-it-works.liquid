{% doc %}
  Renders a why it works section.
{% enddoc %}

{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/why-it-works/why-it-works.css" />
{% endif %}
<section class="why-it-works" id="why_it_works">
    <div class="container">
        {% if section.settings.text != blank %}
            <article class="why-it-works__text">
                {{ section.settings.text }}
            </article>
        {% endif %}
        
        <div class="why-it-works__main">
            <div class="why-it-works__according">
                <div class="c-accordion c-accordion--lines">
                    <div class="c-accordion__list">
                        {% for block in section.blocks %}
                            {% if block.type == 'accordion' %}
                                <details class="c-accordion__item" id="{{ block.settings.section_id | handleize }}">
                                    {% if block.settings.heading != blank %}
                                        <summary class="c-accordion__summary">
                                            <i class="e-icon e-icon-{{ block.settings.icon }}"></i>
                                            {{ block.settings.heading }}
                                        </summary>
                                    {% endif %}
                                    {% if block.settings.text != blank %}
                                        <article class="c-accordion__content">
                                            {{ block.settings.text }}
                                        </article>
                                    {% endif %}
                                </details>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="why-it-works__components">
                <div class="c-product-components{% if section.settings.modifier != 'none' %} c-product-components--{{ section.settings.modifier }}{% endif %}">
                    {% if section.settings.image_mobile != blank %}
                        <picture>
                            {% if section.settings.image != blank %}
                                <source media="(min-width: 768px)" srcset="{{ section.settings.image | image_url }}" />
                            {% endif %}
                            <img loading="lazy" src="{{ section.settings.image_mobile | image_url }}" alt="{{ section.settings.image_mobile.alt | escape }}" />
                        </picture>
                    {% elsif section.settings.image != blank %}
                        <img loading="lazy" src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt | escape}}" />
                    {% endif %}
                    {% for block in section.blocks %}
                        {% if block.type == 'component' %}
                            <div class="e-component-pointer{% if block.settings.modifier != 'none' %} e-component-pointer--{{ block.settings.modifier }}{% endif %}">
                                <hr />
                                <div>
                                    <strong>{{ block.settings.heading }}</strong>
                                    <small>{{ block.settings.text }}</small>
                                </div>
                            </div>
                        {% elsif block.type == 'accordion' and block.settings.heading != blank and block.settings.section_id != blank %}
                            <div class="e-component-pointer{% if block.settings.component != 'none' %} e-component-pointer--{{ block.settings.component }}{% endif %}">
                                <hr />
                                <a href="#{{ block.settings.section_id | handleize }}">{{ block.settings.heading }}</a>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
                {% if section.settings.badge_text != blank %}
                    <div class="e-pill-badge e-pill-badge--sm e-pill-badge--fill">
                        <i class="e-icon e-icon-snow"></i>
                        {{ section.settings.badge_text }}
                    </div>
                {% endif %}
                {% if section.settings.disclaimer != blank %}
                    <p class="e-declaimer">{{ section.settings.disclaimer }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</section>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadScriptOnce("why-it-works", "https://qureskincaredns-stable.com/sections/why-it-works/why-it-works.js");
    });
</script>

