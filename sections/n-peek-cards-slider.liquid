{% doc %}
    Renders a reusable peek cards slider section.
{% enddoc %}

<!-- PEEK CARDS SLIDER -->
<section class="peek-cards-slider{% if section.settings.background_color != 'none' %} peek-cards-slider--{{ section.settings.background_color }}{% endif %}{% if section.settings.modifier != 'none' %} peek-cards-slider--{{ section.settings.modifier }}{% endif %}"{% if section.settings.section_id != blank %} id="{{ section.settings.section_id }}"{% endif %}>
    <div class="container">
        <article class="peek-cards-slider__content">
            {{ section.settings.heading }}
            {% if section.settings.quote_image != blank or section.settings.quote_text != blank %}
                <div class="e-experts-quote-inline">
                    <img loading="lazy" src="{{ section.settings.quote_image | image_url }}" alt="{{ section.settings.quote_image.alt | escape }}" />
                    {{ section.settings.quote_text }}
                </div>
            {% endif %}
            {% if section.settings.button_url != blank and section.settings.button_label != blank %}
                <a class="btn btn--primary" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a>
            {% endif %}

            <div
                class="c-swiper"
                data-swiper='{
                        "slidesPerView": 1.1,
                        "spaceBetween": 16,
                        "loop": false,
                        "pagination": {
                            "el": ".c-swiper-pagination",
                            "type": "custom"
                        },
                        "navigation": {
                            "prevEl": ".c-swiper-button-prev",
                            "nextEl": ".c-swiper-button-next"
                        },
                        "breakpoints": {
                            "768": {
                                "slidesPerView": 1.5
                            },
                            "992": {
                                "slidesPerView": 2.15
                            }
                        }
                    }'>
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        {% if block.type == 'slider' %}
                            <div class="swiper-slide">
                                <div class="changes-tile">
                                    {% if block.settings.image != blank %}
                                        <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                    {% endif %}
                                    {{ block.settings.text | replace: '<em>', '<span>' | replace: '</em>', '</span>' }}
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="c-swiper-nav">
                    <button class="c-swiper-button-prev" aria-label="prev"></button>
                    <div class="c-swiper-pagination"></div>
                    <button class="c-swiper-button-next" aria-label="next"></button>
                </div>
            </div>
        </article>
    </div>
</section>
<!-- PEEK CARDS SLIDER END -->

{% schema %}
{
  "name": "t:sections.n_peek-cards-slider.name",
  "settings": [
    {
        "type": "select",
        "id": "modifier",
        "label": "t:common.modifier",
        "default": "changes",
        "options": [
            { 
                "value": "none", 
                "label": "t:common.none" 
            },
            { 
                "value": "changes", 
                "label": "t:sections.n_peek-cards-slider.settings.modifier.options.changes" 
            }
        ]
    },
    {
        "type": "select",
        "id": "background_color",
        "label": "t:common.background-color",
        "default": "none",
        "options": [
            { 
                "value": "none", 
                "label": "t:common.none" 
            },
            { 
                "value": "bg", 
                "label": "t:sections.n_peek-cards-slider.settings.background_color.options.bg" 
            }
        ]
    },
    {
        "type": "text",
        "id": "section_id",
        "label": "t:common.section_id"
    },
    {
        "type": "richtext",
        "id": "heading",
        "label": "t:common.header"
    },
    {
        "type": "richtext",
        "id": "text",
        "label": "t:common.text"
    },
    {
        "type": "image_picker",
        "id": "quote_image",
        "label": "t:common.quote-image"
    },
    {
        "type": "richtext",
        "id": "quote_text",
        "label": "t:common.quote"
    },
    {
        "type": "text",
        "id": "button_label",
        "label": "t:common.button-label"
    },
    {
        "type": "url",
        "id": "button_url",
        "label": "t:common.button-url"
    }
  ],
  "blocks": [
    {
        "type": "slider",
        "name": "t:common.slider",
        "settings": [
            {
                "type": "image_picker",
                "id": "image",
                "label": "t:common.image"
            },
            {
                "type": "richtext",
                "id": "text",
                "label": "t:common.text"
            }
        ]
    }
  ],
  "presets": [
    {
        "name": "t:sections.n_peek-cards-slider.name"
    }
  ]
}
{% endschema %}
