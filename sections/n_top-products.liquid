{% doc %}
  Renders a row of top product tiles, each with an image, name, and optional pill badge.
{% enddoc %}

<!-- TOP PRODUCTS -->
{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/top-products/top-products.css" />
{% endif %}

<section class="top-products">
    <div class="container">
        {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        <ul>
            {% for block in section.blocks %}
                {% if block.type == 'product_tile' %}
                    <li {{ block.shopify_attributes }}>
                        <a href="{{ block.settings.url | default: '#' }}">
                            <figure>
                                {% if block.settings.image != blank %}
                                    <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                {% endif %}
                                <figcaption>
                                    {% if block.settings.name != blank %}
                                        <small>{{ block.settings.name }}</small>
                                    {% endif %}
                                    {% if block.settings.badge_text != blank %}
                                        <span class="e-pill-badge e-pill-badge--xs{% if block.settings.badge_fill %} e-pill-badge--fill{% endif %}">{{ block.settings.badge_text }}</span>
                                    {% endif %}
                                </figcaption>
                            </figure>
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
</section>
<!-- TOP PRODUCTS END -->

{% schema %}
{
    "name": "t:sections.n_top-products.name",
    "settings": [
        {
            "type": "checkbox",
            "id": "use_own_file",
            "label": "t:common.use-own-file",
            "default": false
        },
        {
            "type": "text",
            "id": "heading",
            "label": "t:common.header"
        }
    ],
    "blocks": [
        {
            "type": "product_tile",
            "name": "t:sections.n_top-products.blocks.product_tile.name",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "text",
                    "id": "name",
                    "label": "t:sections.n_top-products.blocks.product_tile.settings.name"
                },
                {
                    "type": "url",
                    "id": "url",
                    "label": "t:common.link"
                },
                {
                    "type": "text",
                    "id": "badge_text",
                    "label": "t:sections.n_top-products.blocks.product_tile.settings.badge_text"
                },
                {
                    "type": "checkbox",
                    "id": "badge_fill",
                    "label": "t:sections.n_top-products.blocks.product_tile.settings.badge_fill",
                    "default": false
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_top-products.name"
        }
    ]
}
{% endschema %}
