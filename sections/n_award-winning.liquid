<!-- AWARD WINNING -->
<section class="award-winning">
    <div class="container">
        {{ section.settings.heading }}
        <div
            class="c-swiper"
            data-swiper='{
                "slidesPerView": 1.5,
                "centeredSlides": true,
                "spaceBetween": 16,
                "initialSlide": 1,
                "loop": false,
                "breakpoints": {
                    "768": {
                        "slidesPerView": 3,
                        "centeredSlides": false,
                        "spaceBetween": 0
                    }
                }
            }'>
            <div class="swiper-wrapper">
                {% for block in section.blocks %}
                    <div class="swiper-slide">
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                        {% endif %}
                        {{ block.settings.text }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
<!-- AWARD WINNING END -->

{% schema %}
{
    "name": "t:sections.n_award-winning.name",
    "settings": [
        {
            "type": "richtext",
            "id": "heading",
            "label": "t:common.header"
        }
    ],
    "blocks": [
        {
            "type": "slide",
            "name": "t:common.slider",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_award-winning.name"
        }
    ]
}
{% endschema %}
