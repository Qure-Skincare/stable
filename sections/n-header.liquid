{% doc %}
  Renders header section

  @example
  {% section 'n-header' %}
{% enddoc %}

{% assign black_friday_turn_on = settings.black_friday_turn_on %}

{% if section.settings.exception != blank %}
    {% assign exception_list = section.settings.exception | split: ',' %}
    {% assign path_lower = request.path | downcase %}

    {% for exception in exception_list %}
        {% assign exception = exception | downcase %}
        {% capture _exception %}{{ exception | replace: ' ', '' }}{% endcapture %}
        {% if exception != blank and path_lower contains _exception %}
            {% assign is_exception = true %}
            {% break %}
        {% endif %}
    {% endfor %}
{% endif %}
{% unless is_exception %}

{% liquid
  # nav-tab blocks output their menu item wrapped in <!--nav-menu--> markers,
  # followed by their dropdown panel. Split them into the top menu and the panels area.
  capture nav_blocks
    content_for 'blocks'
  endcapture

  assign nav_parts = nav_blocks | split: '<!--nav-menu-->'
  assign nav_menu = ''
  assign nav_panels = ''
  for part in nav_parts
    if part contains '<!--/nav-menu-->'
      assign menu_and_panel = part | split: '<!--/nav-menu-->'
      assign nav_menu = nav_menu | append: menu_and_panel[0]
      assign nav_panels = nav_panels | append: menu_and_panel[1]
    else
      assign nav_panels = nav_panels | append: part
    endif
  endfor
%}

<!-- HEADER -->
