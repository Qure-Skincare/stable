<!-- HEADER END -->

<script src="https://qureskincaredns-stable.com/sections/header-new/header-new.js" defer="defer"></script>

{% if request.design_mode %}
    <script>
        // Theme editor: open the dropdown that contains the selected block
        document.addEventListener('shopify:block:select', (e) => {
            const pane = e.target.closest('#header .header__content');
            document.querySelectorAll('#header .header__content.show-on-hover').forEach((el) => {
                if (el !== pane) el.classList.remove('show-on-hover');
            });
            if (pane) pane.classList.add('show-on-hover');
        });
        document.addEventListener('shopify:block:deselect', () => {
            document.querySelectorAll('#header .header__content.show-on-hover').forEach((el) => el.classList.remove('show-on-hover'));
        });
    </script>
{% endif %}
{% endunless %}


{% schema %}
{
    "name": "t:sections-group.header.name",
    "blocks": [
        { "type": "nav-tab" },
        { "type": "nav-mobile-button" }
    ],
    "settings": [
        {
            "type": "textarea",
            "id": "exception",
            "label": "t:common.exception"
        }
    ]
}
{% endschema %}