{% doc %}
  Renders a grid of experts with a photo, name, and role.
{% enddoc %}

<!-- EXPERTS GRID -->
{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/experts-grid/experts-grid.css" />
{% endif %}

<section class="experts-grid">
    <div class="container">
        <article>
            {% if section.settings.heading != blank %}
                <h2>{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.text != blank %}
                {{ section.settings.text }}
            {% endif %}
            <ul>
                {% for block in section.blocks %}
                    {% if block.type == 'expert' %}
                        <li {{ block.shopify_attributes }}>
                            {% if block.settings.image != blank %}
                                <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                            {% endif %}
                            <div>
                                {% if block.settings.name != blank %}
                                    <strong>{{ block.settings.name }}</strong>
                                {% endif %}
                                {% if block.settings.role != blank %}
                                    <small>{{ block.settings.role }}</small>
                                {% endif %}
                            </div>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </article>
    </div>
</section>
<!-- EXPERTS GRID END -->

{% schema %}
{
    "name": "t:sections.n_experts-grid.name",
    "settings": [
        {
            "type": "checkbox",
            "id": "use_own_file",
            "label": "t:common.use-own-file",
            "default": false
        },
        {
            "type": "text",
            "id": "heading",
            "label": "t:common.header"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text"
        }
    ],
    "blocks": [
        {
            "type": "expert",
            "name": "t:sections.n_experts-grid.blocks.expert.name",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "text",
                    "id": "name",
                    "label": "t:sections.n_experts-grid.blocks.expert.settings.name"
                },
                {
                    "type": "text",
                    "id": "role",
                    "label": "t:sections.n_experts-grid.blocks.expert.settings.role"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_experts-grid.name"
        }
    ]
}
{% endschema %}
