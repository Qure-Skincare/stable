{% doc %}
  Renders a grid of experts with a photo, name, and role.
  Enable the "Awards" setting to show the awards row and the "--awards" variant (Q icon badge on each expert).
  Enable "Slider" to render the experts as a c-swiper carousel instead of a static grid.
{% enddoc %}

<!-- EXPERTS GRID -->
{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/experts-grid/experts-grid.css" />
{% endif %}

<section class="experts-grid{% if section.settings.awards %} experts-grid--awards{% endif %}"{% if section.settings.section_id != blank %} id="{{ section.settings.section_id }}"{% endif %}>
    <div class="container">
        <article>
            {% if section.settings.heading != blank %}
                <h2>{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.text != blank %}
                {{ section.settings.text }}
            {% endif %}
            {% if section.settings.awards %}
                <ol>
                    {% for block in section.blocks %}
                        {% if block.type == 'award' %}
                            <li {{ block.shopify_attributes }}>
                                {% if block.settings.image != blank %}
                                    <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                {% endif %}
                            </li>
                        {% endif %}
                    {% endfor %}
                </ol>
            {% endif %}
            {% if section.settings.slider %}
                {% assign item_tag = 'div' %}
                {% assign item_class = 'swiper-slide' %}
            {% else %}
                {% assign item_tag = 'li' %}
                {% assign item_class = '' %}
            {% endif %}
            {% capture experts_items %}
                {% for block in section.blocks %}
                    {% if block.type == 'expert' %}
                        <{{ item_tag }}{% if item_class != blank %} class="{{ item_class }}"{% endif %} {{ block.shopify_attributes }}>
                            <figure>
                                {% if block.settings.image != blank %}
                                    <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                {% endif %}
                                {% if section.settings.awards %}
                                    <figcaption><i class="e-icon e-icon-q"></i></figcaption>
                                {% endif %}
                            </figure>
                            <div>
                                {% if block.settings.name != blank %}
                                    <strong>{{ block.settings.name }}</strong>
                                {% endif %}
                                {% if block.settings.role != blank %}
                                    <small>{{ block.settings.role }}</small>
                                {% endif %}
                            </div>
                        </{{ item_tag }}>
                    {% endif %}
                {% endfor %}
            {% endcapture %}
            {% if section.settings.slider %}
                <div
                    class="c-swiper"
                    data-swiper='{
                        "slidesPerView": 2,
                        "spaceBetween": 16,
                        "loop": false,
                        "pagination": {
                            "el": ".c-swiper-pagination",
                            "type": "custom"
                        },
                        "navigation": {
                            "prevEl": ".c-swiper-button-prev",
                            "nextEl": ".c-swiper-button-next"
                        },
                        "breakpoints": {
                            "768": {
                                "slidesPerView": 3,
                                "spaceBetween": 24
                            }
                        }
                    }'>
                    <div class="swiper-wrapper">
                        {{ experts_items }}
                    </div>
                    <div class="c-swiper-nav">
                        <button class="c-swiper-button-prev"></button>
                        <div class="c-swiper-pagination"></div>
                        <button class="c-swiper-button-next"></button>
                    </div>
                </div>
            {% else %}
                <ul>
                    {{ experts_items }}
                </ul>
            {% endif %}
        </article>
    </div>
</section>
<!-- EXPERTS GRID END -->

{% schema %}
{
    "name": "t:sections.n_experts-grid.name",
    "settings": [
        {
            "type": "text",
            "id": "section_id",
            "label": "t:common.section_id"
        },
        {
            "type": "checkbox",
            "id": "use_own_file",
            "label": "t:common.use-own-file",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "awards",
            "label": "t:sections.n_experts-grid.settings.awards",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "slider",
            "label": "t:common.slider",
            "default": false
        },
        {
            "type": "text",
            "id": "heading",
            "label": "t:common.header"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text"
        }
    ],
    "blocks": [
        {
            "type": "expert",
            "name": "t:sections.n_experts-grid.blocks.expert.name",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "text",
                    "id": "name",
                    "label": "t:sections.n_experts-grid.blocks.expert.settings.name"
                },
                {
                    "type": "text",
                    "id": "role",
                    "label": "t:sections.n_experts-grid.blocks.expert.settings.role"
                }
            ]
        },
        {
            "type": "award",
            "name": "t:sections.n_experts-grid.blocks.award.name",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_experts-grid.name"
        }
    ]
}
{% endschema %}
