<!-- EXPERT REVIEWS -->
<section class="expert-reviews">
    <div class="container">
        {{ section.settings.text }}

        <div class="c-swiper c-swiper-videos" data-swiper='{ "effect": "fade" }'>
            <div class="swiper-wrapper">
                {% for block in section.blocks %}
                    {% if block.type == 'slider' %}
                        <div class="swiper-slide">
                            <div class="c-wistia c-wistia--custom">
                                <wistia-player media-id="{{ block.settings.wistia_url }}" wistia-popover="true" popover-content="link" end-video-behavior="loop" controls-visible-on-load="false" play-button="false">
                                    <div class="c-wistia__custom">
                                        <picture>
                                            {% if block.settings.image != blank %}
                                                <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                            {% endif %}
                                        </picture>
                                        <div class="e-pill-badge e-pill-badge--sm">
                                            <i class="e-icon e-icon-watch"></i>
                                            <div><strong>{{ 'sections.n_expert-reviews.watch' | t }}</strong> {{ block.settings.button_label }}</div>
                                        </div>
                                    </div>
                                </wistia-player>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <div class="expert-reviews__content">
            <div class="c-swiper c-swiper-thumbs" data-swiper='{ "slidesPerView": "auto", "spaceBetween": 8, "breakpoints": { "768": { "spaceBetween": 10 } } }'>
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        <div class="swiper-slide">
                            {% if block.settings.thumbnail != blank %}
                                <img src="{{ block.settings.thumbnail | image_url }}" alt="{{ block.settings.thumbnail.alt | escape }}" />
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="c-swiper" data-swiper-thumbs=".expert-reviews .c-swiper-thumbs" data-swiper-events="autoplayTimeLeft" data-swiper='{ "slidesPerView": 1, "spaceBetween": 16, "loop": true, "autoplay": { "delay": 7000, "disableOnInteraction": false } }'>
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        <div class="swiper-slide">
                            {{ block.settings.text }}
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% if section.settings.sub_text != blank %}
                <small>{{ section.settings.sub_text }}</small>
            {% endif %}
        </div>
    </div>
</section>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadScriptOnce("expert-reviews", "https://qureskincaredns-stable.com/sections/expert-reviews/expert-reviews.js");
    });
</script>
<!-- EXPERT REVIEWS END -->

{% schema %}
{
    "name": "t:sections.n_expert-reviews.name",
    "settings": [
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.header"
        },
        {
            "type": "text",
            "id": "sub_text",
            "label": "t:common.sub-text"
        }
    ],
    "blocks": [
        {
            "type": "slider",
            "name": "t:common.slider",
            "settings": [
                {
                    "type": "text",
                    "id": "wistia_url",
                    "label": "t:common.wistia-url"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "text",
                    "id": "button_label",
                    "label": "t:common.button-label"
                },
                {
                    "type": "image_picker",
                    "id": "thumbnail",
                    "label": "t:common.image"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_expert-reviews.name"
        }
    ]
}
{% endschema %}
