{% doc %}
  Renders a hero banner section
{% enddoc %}


{% if section.settings.use_own_file %}
    <link href="https://qureskincaredns-stable.com/sections/hero-banner/hero-banner.css" rel="stylesheet" type="text/css"> 
{% endif %}
    {% liquid
        if section.settings.image != blank
            assign image_src = section.settings.image | image_url
        else
            assign image_src = section.settings.image_url | strip
        endif
        if section.settings.image_mobile != blank
            assign image_mobile_src = section.settings.image_mobile | image_url
            assign image_mobile_alt = section.settings.image_mobile.alt
        else
            assign image_mobile_src = section.settings.image_mobile_url | strip
            assign image_mobile_alt = ''
        endif
        if section.settings.label_image != blank
            assign label_src = section.settings.label_image | image_url: width: 300
            assign label_alt = section.settings.label_image.alt
        else
            assign label_src = section.settings.label_image_url | strip
            assign label_alt = ''
        endif
        if label_alt == blank
            assign label_alt = section.settings.label_image_alt
        endif
    %}
    <section class="hero-banner{% if section.settings.modifier != 'none' %} hero-banner--{{ section.settings.modifier }}{% endif %}">
        {% if image_src != blank %}
            <picture>
                <source media="(min-width:768px)" srcset="{{ image_src }}">
                {% if image_mobile_src != blank %}
                    <img src="{{ image_mobile_src }}" alt="{{ image_mobile_alt | escape }}">
                {% endif %}
            </picture>
        {% endif %}

        {% for block in section.blocks %}
            {% if block.type == 'web-video' %}
                <div class="qure-birthday-video">
                    <video autoplay="" loop="" muted="" playsinline="">
                        {% if block.settings.video_url != blank %}
                            <source src="{{ block.settings.video_url }}" type="video/webm" />
                        {% endif %}
                    </video>
                </div>
            {% endif %}
        {% endfor %}

        <div class="container">
            <article>
                {% if label_src != blank %}
                    <img src="{{ label_src }}" alt="{{ label_alt | escape }}" width="432" height="92">
                {% endif %}
                {% if section.settings.text != blank %}
                    {{ section.settings.text
                    | replace: '<p>[small]', '<small>'
                    | replace: '[/small]</p>', '</small>'
                    | replace: '[accent]', '<span>'
                    | replace: '[/accent]', '</span>' }}
                {% endif %}

                {% assign has_text_block = false %}
                {% for block in section.blocks %}
                    {% if block.type == 'text'%}
                        {% assign has_text_block = true %}
                    {% endif %}
                {% endfor %}
                {% if has_text_block %}
                    <ul>
                        {% for block in section.blocks %}
                            {% if block.type == 'text'%}
                                <li>
                                    {{ block.settings.text 
                                    | replace: '<p>[small]', '<small>' 
                                    | replace: '[/small]', '</small>' 
                                    | replace: '<p>', '' 
                                    | replace: '</p>', ''}}

                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                {% endif %}

            </article>
        </div>
    </section>


{% schema %}
{
    "name": "t:sections.n_hero-banner.name",
        "settings": [
        {
            "type": "checkbox",
            "id": "use_own_file",
            "label": "t:common.use-own-file",
            "default": false
        },
        {
            "type": "select",
            "id": "modifier",
            "label": "t:common.modifier",
            "default": "none",
            "options": [
                {
                    "value": "none",
                    "label": "t:sections.n_hero-banner.settings.modifier-options.none"
                },
                {
                    "value": "holidays",
                    "label": "t:sections.n_hero-banner.settings.modifier-options.holidays"
                },
                {
                    "value": "easter",
                    "label": "t:sections.n_hero-banner.settings.modifier-options.easter"
                },
                {
                    "value": "qure-birthday",
                    "label": "t:sections.n_hero-banner.settings.modifier-options.qure-birthday"
                },
                {
                    "value": "bf",
                    "label": "t:sections.n_hero-banner.settings.modifier-options.bf"
                }
            ]
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text",
            "info": "t:sections.n_hero-banner.settings.text_info"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:common.image"
        },
        {
            "type": "text",
            "id": "image_url",
            "label": "t:sections.n_hero-banner.settings.image_url"
        },
        {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "t:common.image-mobile"
        },
        {
            "type": "text",
            "id": "image_mobile_url",
            "label": "t:sections.n_hero-banner.settings.image_mobile_url"
        },
        {
            "type": "image_picker",
            "id": "label_image",
            "label": "t:sections.n_hero-banner.settings.label_image"
        },
        {
            "type": "text",
            "id": "label_image_url",
            "label": "t:sections.n_hero-banner.settings.label_image_url"
        },
        {
            "type": "text",
            "id": "label_image_alt",
            "label": "t:sections.n_hero-banner.settings.label_image_alt"
        }
    ],
    "blocks": [
        {
            "type": "text",
            "name": "t:common.text",
            "settings": [
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        },
        {
            "type": "web-video",
            "name": "t:common.web-video",
            "settings": [
                {
                    "type": "text",
                    "id": "video_url",
                    "label": "t:common.video-url"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_hero-banner.name"
        }
    ]
}
{% endschema %}