{% doc %}
  Renders the Micro-Infusion buy block: product copy, a subscription supply option with
  server-rendered pricing, and a working add-to-cart button (subscription selling plan).
{% enddoc %}

<!-- BASE SECTION MI BUY -->
{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/base-section/base-section.css" />
{% endif %}

{% if section.settings.product != blank %}
    {% assign subscription_discount_percent = section.settings.subscription_discount_percent %}
    {% include 'get-product-data', product_handle: section.settings.product.handle %}

    {%- assign mi_selling_plan = section.settings.selling_plan_id -%}
    {%- if mi_selling_plan == blank -%}
        {%- assign mi_selling_plan = section.settings.product.selling_plan_groups.first.selling_plans.first.id -%}
    {%- endif -%}

    <section class="base-section base-section--reverse base-section--mi-buy">
        <div class="container">
            <article>
                {{ section.settings.heading }}
                {% if section.settings.image != blank %}
                    <picture>
                        <img loading="lazy" src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt | escape }}" />
                    </picture>
                {% endif %}
                {% if section.settings.text != blank %}
                    <div>{{ section.settings.text }}</div>
                {% endif %}
                <div class="c-buy-block">
                    <div class="mi-supply">
                        <input type="radio" name="mi-supply" checked />
                        {% if section.settings.supply_badge != blank %}
                            <span class="e-pill-badge e-pill-badge--xs e-pill-badge--fill">{{ section.settings.supply_badge }}</span>
                        {% endif %}
                        <div class="mi-supply__main">
                            {{ section.settings.supply_title }}
                            <div class="e-price">
                                <div class="e-price__main">
                                    <div class="e-price__current">{{ product_subscription_price | default: product_price }}</div>
                                    {% if product_price_compare_original > 0 %}
                                        <div class="e-price__old">{{ product_price_compare }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        <div class="mi-supply__desc">
                            {{ section.settings.per_treatment }}
                            <ul class="c-marked-list">
                                {% for block in section.blocks %}
                                    {% if block.type == 'feature' and block.settings.text != blank %}
                                        <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                    <div class="c-order-button">
                        {%- comment -%} _source attributes the order to this block; data-collect-variant-id feeds the impression/click beacons (qure-skincare.js) {%- endcomment -%}
                        <button type="button" class="btn btn--primary" data-collect-variant-id="{{ product_variant_id }}" data-cart-items='[{"id":{{ product_variant_id }},"quantity":1{% if mi_selling_plan != blank %},"selling_plan":{{ mi_selling_plan }}{% endif %},"properties":{"_source":"home_mi_buy"}}]'{% if product_available == false %} disabled{% endif %}>{{ section.settings.button_label | default: 'Add to Cart' }}</button>
                    </div>
                    {% if section.settings.disclaimer != blank %}
                        <small>{{ section.settings.disclaimer }}</small>
                    {% endif %}
                </div>
            </article>
        </div>
    </section>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".base-section--mi-buy .c-order-button button").forEach(function (button) {
                button.addEventListener("click", function () {
                    if (!window.CartDrawer || typeof window.CartDrawer.addToCartJson !== "function") return;
                    var items;
                    try { items = JSON.parse(button.getAttribute("data-cart-items")); } catch (e) { return; }
                    window.CartDrawer.addToCartJson(items);
                });
            });
        });
    </script>
{% endif %}
<!-- BASE SECTION MI BUY END -->

{% schema %}
{
    "name": "t:sections.n_mi-buy.name",
    "settings": [
        {
            "type": "checkbox",
            "id": "use_own_file",
            "label": "t:common.use-own-file",
            "default": false
        },
        {
            "type": "product",
            "id": "product",
            "label": "t:sections.n_mi-buy.settings.product"
        },
        {
            "type": "richtext",
            "id": "heading",
            "label": "t:common.header"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:common.image"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text"
        },
        {
            "type": "text",
            "id": "supply_badge",
            "label": "t:sections.n_mi-buy.settings.supply_badge"
        },
        {
            "type": "text",
            "id": "supply_title",
            "label": "t:sections.n_mi-buy.settings.supply_title",
            "default": "3 Month Supply"
        },
        {
            "type": "richtext",
            "id": "per_treatment",
            "label": "t:sections.n_mi-buy.settings.per_treatment"
        },
        {
            "type": "range",
            "id": "subscription_discount_percent",
            "label": "t:sections.n_mi-buy.settings.subscription_discount_percent",
            "min": 0,
            "max": 90,
            "step": 1,
            "unit": "%",
            "default": 0
        },
        {
            "type": "text",
            "id": "selling_plan_id",
            "label": "t:sections.n_mi-buy.settings.selling_plan_id"
        },
        {
            "type": "text",
            "id": "button_label",
            "label": "t:common.button-label",
            "default": "Add to Cart"
        },
        {
            "type": "text",
            "id": "disclaimer",
            "label": "t:sections.n_mi-buy.settings.disclaimer"
        }
    ],
    "blocks": [
        {
            "type": "feature",
            "name": "t:sections.n_mi-buy.blocks.feature.name",
            "settings": [
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_mi-buy.name"
        }
    ]
}
{% endschema %}
