{% doc %}
  Renders an across image banner section
{% enddoc %}

{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/across-image-banner/across-image-banner.css" />
{% endif %}
{%- liquid
    assign mod = section.settings.modifier
    assign banner_class = 'across-image-banner'
    if mod == 'hero_reverse'
        assign banner_class = 'across-image-banner across-image-banner--hero across-image-banner--reverse'
    elsif mod == 'holidays-secondary' or mod == 'fathers-day' or mod == 'fourth-of-july' or mod == 'qure-birthday' or mod == 'summer'
        assign banner_class = banner_class | append: ' across-image-banner--holidays across-image-banner--' | append: mod
    elsif mod != 'none' and mod != blank
        assign banner_class = banner_class | append: ' across-image-banner--' | append: mod
    endif
-%}
<section class="{{ banner_class }}">
        <picture>
            {% if section.settings.image != blank %}
                <source media="(min-width:768px)"
                    srcset="{{ section.settings.image | image_url: width: 768 }} 768w,
                            {{ section.settings.image | image_url: width: 1024 }} 1024w,
                            {{ section.settings.image | image_url: width: 1440 }} 1440w,
                            {{ section.settings.image | image_url: width: 1920 }} 1920w"
                    sizes="100vw" />
            {% endif %}
            {% if section.settings.image_mobile != blank %}
                <img loading="eager" fetchpriority="high"
                    src="{{ section.settings.image_mobile | image_url: width: 800 }}"
                    srcset="{{ section.settings.image_mobile | image_url: width: 360 }} 360w,
                            {{ section.settings.image_mobile | image_url: width: 480 }} 480w,
                            {{ section.settings.image_mobile | image_url: width: 768 }} 768w,
                            {{ section.settings.image_mobile | image_url: width: 1080 }} 1080w"
                    sizes="100vw"
                    width="{{ section.settings.image_mobile.width }}"
                    height="{{ section.settings.image_mobile.height }}"
                    alt="{{ section.settings.image_mobile.alt | escape }}" />
            {% endif %}
        </picture>
        <div class="container">
            <article>

                {% for block in section.blocks %}
                    {% if block.type == 'stars_image' %}
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                        {% endif %}
                    {% endif %}
                {% endfor %}

                {% for block in section.blocks %}
                    {% if block.type == 'badge' %}
                        {% if block.settings.badge_text != blank %}
                            <div class="e-pill-badge e-pill-badge--xs">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />{% endif %}{{ block.settings.badge_text }}</div>
                        {% endif %}
                    {% endif %}
                {% endfor %}

                {% if section.settings.rating != blank %}
                    <div class="c-rating c-rating--bg">
                        <div class="e-rating-stars" style="--rating: {{ section.settings.rating }}"></div>
                        <a href="#"><strong>{{ section.settings.rating }}</strong>{{ section.settings.rating_text }}</a>
                    </div>
                {% endif %}

                {% if section.settings.heading != blank %}
                    {{ section.settings.heading 
                    | replace: '[qure]', '<i class="e-icon e-icon-qure"></i>' 
                    | replace: '[thin_cross]', '<i class="e-icon e-icon-thin-cross"></i>'
                    | replace: '[flex]', '<i class="e-icon e-icon-flex"></i>'
                    }}
                {% endif %}

                {% if section.settings.text != blank %}
                    {{ section.settings.text }}
                {% endif %}

                {% assign has_app_store = false %}
                {% for block in section.blocks %}
                    {% if block.type == 'app_store' %}
                        {% assign has_app_store = true %}
                    {% endif %}
                {% endfor %}
                {% if has_app_store %}
                    <div class="c-app-stores c-app-stores--row">
                        {% for block in section.blocks %}
                            {% if block.type == 'app_store' and block.settings.link_url != blank and block.settings.image != blank %}
                                <a href="{{ block.settings.link_url }}" target="_blank" rel="nofollow">
                                    <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                {% for block in section.blocks %}
                    {% if block.type == 'rating' %}
                        <div class="trustpilot-rating">
                            <ul>
                                <li><i class="e-icon e-icon-trustpilot"></i></li>
                                <li><i class="e-icon e-icon-trustpilot"></i></li>
                                <li><i class="e-icon e-icon-trustpilot"></i></li>
                                <li><i class="e-icon e-icon-trustpilot"></i></li>
                                <li><i class="e-icon e-icon-trustpilot"></i></li>
                            </ul>
                            {% if block.settings.rating_text != blank %}
                                <div>{{ block.settings.rating_text | replace : '<p>', '' | replace : '</p>', '' }}</div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}

                {%  assign has_bundle = false %}
                {% for block in section.blocks %}
                    {% if block.type == 'bundle' %}
                        {% assign has_bundle = true %}
                    {% endif %}
                {% endfor %}
                {% if has_bundle %}
                    <div class="special-bundle">
                        {% for block in section.blocks %}
                            {% if block.type == 'bundle' %}
                                <a href="{{ block.settings.link_url }}"><img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" /></a>
                                {{ block.settings.text }}
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                {% if section.settings.button_label != blank and section.settings.button_url != blank %}
                    <a href="{{ section.settings.button_url }}" class="btn {% if section.settings.modifier == 'doctorly' %}btn--primary-white{% else %}btn--primary{% endif %}">{{ section.settings.button_label }}</a>
                {% endif %}

                {% for block in section.blocks %}
                    {% if block.type == 'disclaimer' %}
                        {% if block.settings.text != blank %}
                            <small>{{ block.settings.text }}</small>
                        {% endif %}
                    {% endif %}
                {% endfor %}

                {% for block in section.blocks%}
                    {% if block.type == 'box' %}
                        {% if block.settings.outside_badge == false %}
                            <div class="c-certified-box">
                            <ul>
                                {% if block.settings.image_1 != blank %}
                                    <li><img loading="lazy" src="{{ block.settings.image_1 | image_url }}" alt="{{ block.settings.image_1.alt | escape }}" /></li>
                                {% endif %}
                                {% if block.settings.image_2 != blank %}
                                    <li><img loading="lazy" src="{{ block.settings.image_2 | image_url }}" alt="{{ block.settings.image_2.alt | escape }}" /></li>
                                {% endif %}
                                {% if block.settings.badge_text != blank %}
                                    <li>{{ block.settings.badge_text }}</li>
                                {% endif %}
                            </ul>
                            {% if block.settings.text != blank %}
                                {{ block.settings.text }}
                            {% endif %}
                        </div>
                        {% endif %}
                    {% endif %}
                {% endfor %}

                {% assign has_buy_button = false %}
                {% for block in section.blocks %}
                    {% if block.type == 'buy_button' %}
                        {% assign has_buy_button = true %}
                    {% endif %}
                {% endfor %}
                {% if has_buy_button %}
                    {% for block in section.blocks %}
                        {% if block.type == 'buy_button' %}
                            {% if block.settings.button_label != blank and block.settings.button_url != blank %}
                                <form class="c-buy-block" action="{{ block.settings.button_url }}">
                                    <button class="btn btn--primary" type="submit">{{ block.settings.button_label }}</button>
                                    <ul class="e-features-list">
                                        {% for block in section.blocks %}
                                            {% if block.type == 'icon_with_text' %}
                                                {% if block.settings.text != blank %}
                                                    <li>
                                                        <i class="e-icon e-icon-{{ block.settings.icon }}"></i>
                                                        {{ block.settings.text }}
                                                    </li>
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                    </ul>
                                </form>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% if section.settings.sub_text != blank %}
                    <small>{{ section.settings.sub_text | replace : '<p>', '' | replace : '</p>', '' }}</small>
                {% endif %}

            </article>

            {% assign has_pill = false %}
            {% for block in section.blocks %}
                {% if block.type == 'pill' %}
                    {% assign has_pill = true %}
                {% endif %}
            {% endfor %}
            {% if has_pill %}
                <ul>
                    {% for block in section.blocks %}
                        {% if block.type == 'pill' %}
                            {% if block.settings.text != blank %}
                                <li class="e-pill-badge e-pill-badge--sm">{{ block.settings.text }}</li>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </ul>
            {% endif %}
            {% for block in section.blocks %}
                {% if block.type == 'bottles' %}
                    {% if block.settings.image != blank %}
                        <div class="hero-mi-bottles">
                            <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                            {% if block.settings.label != blank %}
                                <span>{{ block.settings.label }}</span>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endif %}
            {% endfor %}

            {% for block in section.blocks %}
                {% if block.type == 'image' %}
                    {% if block.settings.image != blank %}
                        <figure>
                            <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                        </figure>
                    {% endif %}
                {% endif %}
            {% endfor %}

            {% for block in section.blocks %}
                {% if block.type == 'treatment_result_badge' %}
                    <div class="treatment-result-badge">
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                        {% endif %}
                        {% if block.settings.text != blank %}{{ block.settings.text }}{% endif %}
                    </div>
                {% endif %}
            {% endfor %}

            {% for block in section.blocks %}
                {% if block.type == 'percent_value' %}
                    <div class="e-discount-badge" data-text-top="Up to" data-text-bottom="Off">
                        <span>{{ block.settings.percent_value }}%</span>
                    </div>
                {% endif %}
            {% endfor %}

            {% assign badges_group = false %}
            {% for block in section.blocks%}
                {% if block.type == 'badge_group' %}
                    {% assign badges_group = true %}
                {% endif %}
            {% endfor %}
            {% if badges_group %}
                <ul class="badges-group">
                    {% for block in section.blocks %}
                        {% if block.type == 'badge_group' %}
                            <li>
                                {% if block.settings.badge_text != blank %}
                                    <div class="e-pill-badge e-pill-badge--fill"><span class="e-checkmark"></span>{{ block.settings.badge_text }}</div>
                                {% endif %}
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            {% endif %}

            {% for block in section.blocks%}
                {% if block.type == 'box' %}
                    {% if block.settings.outside_box == true %}
                        <div class="c-certified-box">
                        <ul>
                            {% if block.settings.image_1 != blank %}
                                <li><img loading="lazy" src="{{ block.settings.image_1 | image_url }}" alt="{{ block.settings.image_1.alt | escape }}" /></li>
                            {% endif %}
                            {% if block.settings.image_2 != blank %}
                                <li><img loading="lazy" src="{{ block.settings.image_2 | image_url }}" alt="{{ block.settings.image_2.alt | escape }}" /></li>
                            {% endif %}
                            {% if block.settings.badge_text != blank %}
                                <li>{{ block.settings.badge_text }}</li>
                            {% endif %}
                        </ul>
                        {% if block.settings.text != blank %}
                            {{ block.settings.text }}
                        {% endif %}
                    </div>
                    {% endif %}
                {% endif %}
            {% endfor %}

        </div>

        {% for block in section.blocks %}
            {% if block.type == 'video' %}
                {% if block.settings.video_url != blank %}
                    <div class="qure-birthday-video">
                        <video autoplay="" loop="" muted="" playsinline="">
                            <source src="{{ block.settings.video_url }}" type="video/webm" />
                        </video>
                    </div>
                {% endif %}
            {% endif %}
        {% endfor %}
    </section>


