{% doc %}
  Renders an announcement bar gamification section: reward progress tiers
  (shared with the cart drawer via get-cart-global-data) and the global
  special-offer countdown.
{% enddoc %}


{% if section.settings.exception != blank %}
    {% assign exception_list = section.settings.exception | split: ',' %}
    {% assign path_lower = request.path | downcase %}

    {% for exception in exception_list %}
        {% assign exception = exception | downcase %}
        {% capture _exception %}{{ exception | replace: ' ', '' }}{% endcapture %}
        {% if exception != blank and path_lower contains _exception %}
            {% assign is_exception = true %}
            {% break %}
        {% endif %}
    {% endfor %}
{% endif %}


{% unless is_exception %}
  {% include 'get-cart-global-data' %}

  {% assign shipping_progress = 0 %}
  {% if global_bar_shipping_limit > 0 %}
    {% assign shipping_progress = global_total_price_devided | times: 100 | divided_by: global_bar_shipping_limit | at_most: 100 %}
  {% endif %}

  {% assign gift2_progress = 0 %}
  {% if global_bar_gift2_limit > global_bar_shipping_limit %}
    {% assign gift2_extra = global_total_price_devided | minus: global_bar_shipping_limit | at_least: 0 %}
    {% assign gift2_diff = global_bar_gift2_limit | minus: global_bar_shipping_limit %}
    {% assign gift2_progress = gift2_extra | times: 100 | divided_by: gift2_diff | at_most: 100 %}
  {% endif %}

  <!-- ANNOUNCEMENT BAR -->
  <div id="announcement-bar" class="announcement-bar" data-section-id="{{ section.id }}">
      <div class="announcement-bar-content">
          <div class="bf-reward-progress">
              {% if global_bar_percent == 100 %}
                <p class="bf-reward-progress__text">{{ 'cart.drawer.settings.bar_header_completed_html' | t }}</p>
              {% else %}
                <p class="bf-reward-progress__text">{{ 'cart.drawer.settings.bar_header_html' | t: add_more: global_bar_add_more, product_title: global_bar_product_title, product_price: global_bar_product_price }}</p>
              {% endif %}

              <div class="bf-reward-progress__unlocked">
                  <ul>
                      {% if global_bar_shipping_limit > 0 %}
                          <li{% if global_total_price_devided >= global_bar_shipping_limit %} class="unlocked"{% endif %}>
                              {% if global_total_price_devided >= global_bar_shipping_limit %}
                                <i class="e-icon e-icon-checkmark"></i>
                              {% else %}
                                <div style="--reward-progress: {{ shipping_progress }}%"></div>
                              {% endif %}
                              <small>{{ global_bar_shipping_title }}</small>
                              <span><i class="e-icon e-icon-truck"></i></span>
                          </li>
                      {% endif %}
                      {% if global_bar_gift2_limit > 0 %}
                          <li{% if global_total_price_devided >= global_bar_gift2_limit %} class="unlocked"{% endif %}>
                              {% if global_total_price_devided >= global_bar_gift2_limit %}
                                <i class="e-icon e-icon-checkmark"></i>
                              {% else %}
                                <div style="--reward-progress: {{ gift2_progress }}%"></div>
                              {% endif %}
                              <small>{{ global_bar_gift2_title }}</small>
                              <span><i class="e-icon e-icon-pillow-fill"></i></span>
                          </li>
                      {% endif %}
                  </ul>
              </div>

              {% if settings.black_friday_turn_on %}
                <div class="bf-reward-progress__countdown">
                    <p>{{ 'cart.drawer.settings.bf_sale_ends_in' | t }}</p>
                    <div class="e-countdown"{% if settings.black_friday_countdown_from != blank %} data-deadline="{{ settings.black_friday_countdown_from }}"{% endif %} data-offer-days="{{ settings.black_friday_countdown_days }}">
                        <div data-key="{{ 'product.settings.limited-offer.days' | t }}">00</div>
                        <div data-key="{{ 'product.settings.limited-offer.hours' | t }}">00</div>
                        <div data-key="{{ 'product.settings.limited-offer.minutes' | t }}">00</div>
                        <div data-key="{{ 'product.settings.limited-offer.seconds' | t }}">00</div>
                    </div>
                </div>
              {% endif %}
          </div>
      </div>
  </div>

  <script>
      document.addEventListener("DOMContentLoaded", function () {
          loadScriptOnce("n-announcement-bar-gamification.js", "{{ 'n-announcement-bar-gamification.js' | asset_url }}");
          {% if settings.black_friday_turn_on %}
            loadScriptOnce("n-announcement-bar.js", "{{ 'n-announcement-bar.js' | asset_url }}");
          {% endif %}
      });
  </script>
  <!-- ANNOUNCEMENT BAR END -->
{% endunless %}

{% schema %}
{
  "name": "t:sections.announcement-bar-gamification.name",
  "settings": [
    {
      "type": "textarea",
      "id": "exception",
      "label": "t:common.exception"
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar-gamification.name"
    }
  ]
}
{% endschema %}
