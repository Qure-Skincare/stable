{% include 'get-cart-global-data' %}

<!-- FLYOUT CART -->

<style>
   /* While the cart settles, only the checkout area is locked — item rows
      stay clickable so remove/qty actions are never swallowed. */
   #cart-dynamic-content.is-loading .flyout-cart__footer {
      pointer-events: none;
   }
   #cart-dynamic-content.is-loading .flyout-cart__list,
   #cart-dynamic-content.is-loading .flyout-cart__footer,
   #cart-dynamic-content.is-loading .flyout-cart__gifts {
      opacity: .5;
      transition: opacity .15s;
   }
   /* While an item is being added, the stale empty-state and upsells are
      hidden and a skeleton row stands in for the incoming item. */
   #cart-dynamic-content.is-adding .flyout-cart__placeholder,
   #cart-dynamic-content.is-adding .flyout-cart__upsells {
      display: none;
   }
   #cart-dynamic-content.is-adding .flyout-cart__count {
      visibility: hidden;
   }
   /* Skeleton styled as a cart item card: image square + two text lines,
      with a soft shimmer sweeping across. */
   #cart-dynamic-content.is-adding .flyout-cart__body::before {
      content: '';
      display: block;
      height: 104px;
      margin: 16px 20px;
      border: 1px solid #ececec;
      border-radius: 12px;
      background-color: #fff;
      background-image:
         linear-gradient(100deg, rgba(255,255,255,0) 30%, rgba(255,255,255,.85) 50%, rgba(255,255,255,0) 70%),
         linear-gradient(#f1f1f1, #f1f1f1),
         linear-gradient(#f1f1f1, #f1f1f1),
         linear-gradient(#f1f1f1, #f1f1f1);
      background-repeat: no-repeat;
      background-size: 220px 100%, 72px 72px, 45% 14px, 28% 14px;
      background-position: -220px 0, 16px 15px, 104px 24px, 104px 52px;
      animation: cart-skeleton 1.3s ease-in-out infinite;
   }
   @keyframes cart-skeleton {
      to {
         background-position: calc(100% + 220px) 0, 16px 15px, 104px 24px, 104px 52px;
      }
   }
</style>

<dialog class="flyout-cart offcanvas offcanvas-end" id="cartCanvas">
   <div id="cart-dynamic-content" class="flyout-cart__dynamic">
      {% render 'n-footer-cart-drawer-timer', timer: global_timer %}
      <div class="flyout-cart__wrapper">
         <div class="flyout-cart__header">
               <div>{{ 'cart.drawer.settings.header' | t }} <span class="flyout-cart__count">({{ cart.item_count }})</span></div>
               <button
                  class="flyout-cart__close"
                  type="button"
                  onclick="cartCanvas.close()"
               >
                  <i class="e-icon e-icon-cross"></i>
               </button>
         </div>
         <div class="flyout-cart__content">
            {% include 'n-footer-cart-drawer-gift' %}
            {% include 'n-footer-cart-drawer-bar' %}
            <div class="flyout-cart__body">
               {% if cart.item_count == 0 %}
                  {% render 'n-footer-cart-drawer-empty' %}
               {% else %}
                  <div class="flyout-cart__list">
                     {% for item in cart.items %}
                        {% include 'get-cart-item-data' %}
                        {% include 'n-footer-cart-drawer-item' %}
                     {% endfor %}
                  </div>
                  {% include 'n-footer-cart-drawer-upsells' %}
               {% endif %}
            </div>
         </div>
         {% if cart.item_count > 0 %}
               {% include 'n-footer-cart-drawer-summary' %}
         {% endif %}
      </div>
   </div>
</dialog>
<!-- FLYOUT CART END -->

<script>
   const footer_cart_drawer_template = '{{ template }}';
   
   {% if global_black_friday_discount != blank %}
   const footer_cart_drawer_discount = '{{ global_black_friday_discount }}';
   {% endif %}

   document.addEventListener("DOMContentLoaded", function () {
      loadScriptOnce('footer-cart-drawer-counter', '{{ 'n-footer-cart-drawer-counter.js' | asset_url }}');
   });
</script>

<script src="{{ 'n-morphdom-umd.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'n-footer-cart-drawer.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.footer-cart-drawer.name",
  "settings": [

  ]
}
{% endschema %}