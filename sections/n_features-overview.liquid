{% doc %}
  Renders a features overview section with product component pointers and a benefit grid.
{% enddoc %}

<section class="features-overview"{% if section.settings.section_id != blank %} id="{{ section.settings.section_id }}"{% endif %}>
    <div class="container">
        {{ section.settings.heading }}

        {% if section.settings.text != blank %}
            <article>
                {{ section.settings.text }}
            </article>
        {% endif %}

        {% if section.settings.image != blank %}
            <div class="c-product-components{% if section.settings.modifier != 'none' %} c-product-components--{{ section.settings.modifier }}{% endif %}">
                <img loading="lazy" src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt | escape }}" />

                {% for block in section.blocks %}
                    {% if block.type == 'component' %}
                        {% if block.settings.heading != blank or block.settings.text != blank %}
                            <div class="e-component-pointer{% if block.settings.modifier != 'none' %} e-component-pointer--{{ block.settings.modifier }}{% endif %}">
                                <hr />
                                <div>
                                    {% if block.settings.heading != blank %}
                                        <strong>{{ block.settings.heading }}</strong>
                                    {% endif %}
                                    {% if block.settings.text != blank %}
                                        <small>{{ block.settings.text }}</small>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}

        {% assign benefit_blocks = section.blocks | where: 'type', 'benefit' %}
        {% if benefit_blocks.size > 0 %}
            <ul class="c-benefit-grid">
                {% for block in section.blocks %}
                    {% if block.type == 'benefit' %}
                        {% if block.settings.heading != blank or block.settings.text != blank %}
                            <li class="c-benefit-grid__item">
                                {% if block.settings.icon != blank and block.settings.icon != 'none' %}
                                    <span class="c-benefit-grid__icon"><i class="e-icon e-icon-{{ block.settings.icon }}"></i></span>
                                {% endif %}
                                <div class="c-benefit-grid__content">
                                    {% if block.settings.heading != blank %}
                                        <strong class="c-benefit-grid__title">{{ block.settings.heading }}</strong>
                                    {% endif %}
                                    {% if block.settings.text != blank %}
                                        <p class="c-benefit-grid__text">{{ block.settings.text }}</p>
                                    {% endif %}
                                </div>
                            </li>
                        {% endif %}
                    {% endif %}
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</section>

{% schema %}
{
    "name": "t:sections.n_features-overview.name",
    "settings": [
        {
            "type": "text",
            "id": "section_id",
            "label": "t:common.section_id"
        },
        {
            "type": "select",
            "id": "modifier",
            "label": "t:common.modifier",
            "default": "none",
            "options": [
                {
                    "value": "none",
                    "label": "t:common.none"
                },
                {
                    "value": "blue-serum",
                    "label": "t:common.blue-serum"
                }
            ]
        },
        {
            "type": "richtext",
            "id": "heading",
            "label": "t:common.header"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:common.image"
        }
    ],
    "blocks": [
        {
            "type": "component",
            "name": "t:common.component",
            "settings": [
                {
                    "type": "select",
                    "id": "modifier",
                    "label": "t:common.modifier",
                    "default": "none",
                    "options": [
                        {
                            "value": "none",
                            "label": "t:common.none"
                        },
                        {
                            "value": "reverse",
                            "label": "t:common.reverse"
                        }
                    ]
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.header"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        },
        {
            "type": "benefit",
            "name": "t:common.benefit",
            "settings": [
                {
                    "type": "select",
                    "id": "icon",
                    "label": "t:common.icon",
                    "default": "none",
                    "options": [
                        {
                            "value": "none",
                            "label": "t:common.none"
                        },
                        {
                            "value": "fine-lines",
                            "label": "t:common.fine-lines"
                        },
                        {
                            "value": "verified-shield",
                            "label": "t:common.verified-shield"
                        },
                        {
                            "value": "antioxidant",
                            "label": "t:common.antioxidant"
                        },
                        {
                            "value": "droplet",
                            "label": "t:common.droplet"
                        }
                    ]
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.header"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_features-overview.name"
        }
    ]
}
{% endschema %}
