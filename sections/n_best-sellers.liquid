{% doc %}
    Renders a top rated section.
{% enddoc %}


<!-- BEST SELLERS -->
<section class="best-sellers" id="best-sellers">
    <div class="container">
        {{ section.settings.heading }}
        <div class="best-sellers__list">
            {% for block in section.blocks %}
                {% if block.type == 'hover_image' %}
                    {% if block.settings.product != blank %}
                        {% include 'get-product-data', product_handle: block.settings.product, product_prefix: 'best-sellers-' %}
                    {% endif %}
                    <div class="best-sellers__item">
                        <div class="c-product-tile">
                            <a class="c-product-tile__image" style="--image-on-hover: url({{ block.settings.hover_image | image_url }})" href="{{ product_url }}">
                                {% if block.settings.image != blank %}
                                    <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                {% endif %}
                                {% if block.settings.image_text != 'none' %}
                                    {% if block.settings.image_text == 'bestseller' %}
                                        <div class="e-pill-badge e-pill-badge--xs e-pill-badge--fill">{{ 'sections.n_index-top-rated.settings.best-seller-text' | t }}</div>
                                    {% elsif block.settings.image_text == 'trending' %}
                                        <div class="e-pill-badge e-pill-badge--xs" style="--badge-base-color: #ff5429">{{ 'sections.n_index-top-rated.settings.trending-text' | t }}</div>
                                    {% elsif block.settings.image_text == 'hsa-fsa' %}
                                        <div class="e-pill-badge e-pill-badge--sm e-pill-badge--fill" style="--badge-fill-color: #f6f6f7; --badge-base-color: #212428"><span class="e-checkmark"></span>{{ 'sections.n_best-sellers.blocks.hover_image.settings.hsa-fsa' | t }}</div>
                                    {% endif %}
                                {% endif %}
                            </a>
                            <div class="c-product-tile__rating">
                                <div class="e-rating-stars" style="--rating: {{ product_rating }}"></div>
                                <a href="{{ product_url }}">{{ product_rating_count }} {{ 'sections.n_collection.reviews' | t }}</a>
                            </div>
                            <a class="c-product-tile__name" href="{{ product_url }}">{{ block.settings.heading }}</a>
                            <div class="c-product-tile__price">
                                <div class="e-price">
                                    <div class="e-price__main">
                                        <div class="e-price__current">{{ product_sale_price }}</div>
                                    </div>
                                </div>
                            </div>
                            <a class="c-product-tile__button" href="{{ product_url }}">
                                <button class="btn btn--primary">{{ 'sections.n_best-sellers.blocks.hover_image.settings.buy-now' | t }}</button>
                            </a>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
<!-- BEST SELLERS END -->


{% schema %}
{
    "name": "t:sections.n_best-sellers.name",
    "settings": [
        {
            "type": "richtext",
            "id": "heading",
            "label": "t:common.header"
        }
    ],
    "blocks": [
        {
            "type": "hover_image",
            "name": "t:common.hover-image",
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.header"
                },
                {
                    "type": "product",
                    "id": "product",
                    "label": "t:common.product"
                },
                {
                    "type": "select",
                    "id": "image_text",
                    "label": "t:common.image-text",
                    "default": "none",
                    "options": [
                        {
                            "value": "none",
                            "label": "t:common.none"
                        },
                        {
                            "value": "bestseller",
                            "label": "t:common.best-seller"
                        },
                        {
                            "value": "trending",
                            "label": "t:common.trending"
                        },
                        {
                            "value": "hsa-fsa",
                            "label": "t:sections.n_best-sellers.blocks.hover_image.settings.hsa-fsa"
                        }
                    ]
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "image_picker",
                    "id": "hover_image",
                    "label": "t:common.hover-image"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_best-sellers.name"
        }
    ]
}
{% endschema %}
