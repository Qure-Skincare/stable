                        <a href="#">1,375 Reviews</a>
                    </div>
                    <a class="c-product-tile__name" href="#">Q-Rejuvalight Pro Facewear</a>
                    <div class="c-product-tile__price">
                        <div class="e-price">
                            <div class="e-price__main">
                                <div class="e-price__current">{$dyn}</div>
                            </div>
                        </div>
                    </div>
                    <form class="c-product-tile__button" action="#">
                        <button class="btn btn--primary">Buy Now</button>
                    </form>
                </div>
            </div>
            <div class="best-sellers__item">
                <div class="c-product-tile">
                    <a class="c-product-tile__image" style="--image-on-hover: url(/assets/images/top-products/neck-and-deck-hover.webp)" href="#">
                        <img src="assets/images/top-products/neck-and-deck.webp" alt="Pay Directly With Your HSA/FSA Card" />
                        <div class="e-pill-badge e-pill-badge--sm e-pill-badge--fill" style="--badge-fill-color: #f6f6f7; --badge-base-color: #212428">
                            <span class="e-checkmark"></span>
                            HSA/FSA
                        </div>
                    </a>
                    <div class="c-product-tile__rating">
                        <div class="e-rating-stars" style="--rating: 4.5"></div>
                        <a href="#">106 Reviews</a>
                    </div>
                    <a class="c-product-tile__name" href="#">Neck &amp; Décolletage LED Device</a>
                    <div class="c-product-tile__price">
                        <div class="e-price">
                            <div class="e-price__main">
                                <div class="e-price__current">{$dyn}</div>
                            </div>
                        </div>
                    </div>
                    <form class="c-product-tile__button" action="#">
                        <button class="btn btn--primary">Buy Now</button>
                    </form>
                </div>
            </div>
            <div class="best-sellers__item">
                <div class="c-product-tile">
                    <a class="c-product-tile__image" style="--image-on-hover: url(/sections/complete-system/images/micro-infusion-hover.webp)" href="#">
