                </div>
            </div>
        </div>
    </div>
</section>
<!-- BEST SELLERS END -->


{% schema %}
{
    "name": "t:sections.n_best-sellers.name",
    "settings": [
        {
            "type": "checkbox",
            "id": "use_own_file",
            "label": "t:common.use-own-file",
            "default": false
        },
        {
            "type": "text",
            "id": "heading",
            "label": "t:common.header"
        }
    ],
    "blocks": [
        {
            "type": "hover_image",
            "name": "t:common.hover-image",
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.header"
                },
                {
                    "type": "product",
                    "id": "product",
                    "label": "t:common.product"
                },
                {
                    "type": "select",
                    "id": "image_text",
                    "label": "t:common.image-text",
                    "default": "none",
                    "options": [
                        {
                            "value": "none",
                            "label": "t:common.none"
                        },
                        {
                            "value": "bestseller",
                            "label": "t:common.best-seller"
                        },
                        {
                            "value": "trending",
                            "label": "t:common.trending"
                        }
                    ]
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                
                {
                    "type": "image_picker",
                    "id": "hover_image",
                    "label": "t:common.hover-image"
                },
                {
                    "type": "url",
                    "id": "url",
                    "label": "t:common.link-url"
                },
                {
                    "type": "text",
                    "id": "rating_text",
                    "label": "t:common.rating-text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_best-sellers.name"
        }
    ]
}
{% endschema %}