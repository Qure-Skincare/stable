{% doc %}
    Renders a dynamic faq section for page led-mask-offer-2.
{% enddoc %}

<!-- HAVE QUESTIONS -->
{% if section.settings.use_own_file %}
   <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/have-questions/have-questions.css" />
{% endif %}
<div class="have-questions" id="faq">
    <div class="container">
        {{ section.settings.heading }}
        <div class="c-accordion c-accordion--lines">
            <div class="c-accordion__list">
                {% for block in section.blocks %}
                    {% if block.type == 'accordion' %}
                        <details class="c-accordion__item">
                            {% if block.settings.heading != blank %}
                                <summary class="c-accordion__summary">{{ block.settings.heading }}</summary>
                            {% endif %}
                            <article class="c-accordion__content">
                                {% if block.settings.show_technical_specs %}
                                    {% render 'n-page-led-mask-offer-2-faq-technical-specs' %}
                                {% elsif block.settings.text != blank %}
                                    {{ block.settings.text }}
                                {% endif %}
                            </article>
                        </details>
                    {% endif %}
                {% endfor %}
            </div>
            {% if section.settings.button_label != blank and section.settings.button_url != blank %}
                <div class="c-accordion__ask-us">
                    {{ section.settings.text }}<a href="{{ section.settings.button_url }}" class="btn btn-sm btn--secondary">{{ section.settings.button_label }}<i class="e-icon e-icon-arrow"></i></a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% if section.blocks.size > 0 %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {% for block in section.blocks %}
                {% if block.type == 'accordion' and block.settings.show_technical_specs != true %}
                {
                    "@type": "Question",
                    "name": {{ block.settings.heading | json }},
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": {{ block.settings.text | strip_html | json }}
                    }
                }{% unless forloop.last %},{% endunless %}
                {% endif %}
            {% endfor %}
        ]
    }
    </script>
{% endif %}
<!-- HAVE QUESTIONS END -->

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
      {
         "type": "checkbox",
         "id": "use_own_file",
         "label": "t:common.use-own-file",
         "default": false
      },
      {
          "type": "richtext",
          "id": "heading",
          "label": "t:common.header",
          "default": "<h2>Have questions?</h2>"
      },
      {
          "type": "text",
          "id": "text",
          "label": "t:common.text",
          "default": "Don't see your question? "
      },
      {
          "type": "text",
          "id": "button_label",
          "label": "t:common.button-label",
          "default": "Ask us "
      },
      {
          "type": "url",
          "id": "button_url",
          "label": "t:common.button-url"
      }
  ],
  "blocks": [
      {
          "type": "accordion",
          "name": "t:common.accordion",
          "settings": [
              {
                  "type": "text",
                  "id": "heading",
                  "label": "t:common.header"
              },
              {
                  "type": "checkbox",
                  "id": "show_technical_specs",
                  "label": "t:common.show-technical-specs",
                  "default": false
              },
              {
                  "type": "richtext",
                  "id": "text",
                  "label": "t:common.text"
              }
          ]
      }
  ]
}
{% endschema %}
