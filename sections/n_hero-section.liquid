{% doc %}
  Renders a hero section
{% enddoc %}

{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/hero-section/hero-section.css" />
{% endif %}
<section class="hero-section{% if section.settings.modifier != 'none' %} hero-section--{{ section.settings.modifier }}{% endif %}"{% if section.settings.hidden == true %} style="display:none"{% endif %}>
    <div class="container">
        <picture class="hero-section__image">
            {% if section.settings.image != blank %}
                <source media="(min-width:768px)" srcset="{{ section.settings.image | image_url }}" />
            {% endif %}
            {% if section.settings.image_mobile != blank %}
                <img {% if section.settings.hidden %}loading="lazy"{% else %}loading="eager" fetchpriority="high"{% endif %} src="{{ section.settings.image_mobile | image_url }}" alt="{{ section.settings.image_mobile.alt | escape }}" />
            {% endif %}
        </picture>
        <article class="hero-section__content">
            {% assign approved_by_count = 0 %}
            {% assign has_note = false %}
            {% assign has_benefits = false %}
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'approved-by' %}
                        {% assign approved_by_count = approved_by_count | plus: 1 %}
                    {% when 'note' %}
                        {% assign has_note = true %}
                    {% when 'benefit' %}
                        {% assign has_benefits = true %}
                {% endcase %}
            {% endfor %}

            <div class="hero-section__content-header">
                {% if section.settings.show_logo %}
                    {% render '__svg-logo' %}
                {% endif %}

                {% if approved_by_count > 0 and section.settings.approved_position == 'before_text' %}
                    <div class="c-approved-by{% if approved_by_count > 3 %} c-approved-by--secondary{% endif %}">
                        <ul>
                            {% for block in section.blocks %}
                                {% if block.type == 'approved-by' %}
                                    <li><img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" /></li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                        <p>
                            {% if section.settings.rating != blank %}
                                <span class="e-rating-stars" style="--rating: {{ section.settings.rating }}"></span>
                                <strong>{{ section.settings.rating }}/5</strong>{% if section.settings.rating_text != blank %}<br />{% endif %}
                            {% endif %}
                            {% if section.settings.rating_text != blank %}
                                {{ section.settings.rating_text }}
                            {% else %}
                                {% for block in section.blocks %}
                                    {% if block.type == 'approved-by' and block.settings.text != blank %}
                                        {{ block.settings.text | replace: '<p>', '' | replace: '</p>', '' }}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        </p>
                    </div>
                {% endif %}

                {% if section.settings.text != blank %}
                    {{ section.settings.text }}
                {% endif %}

                {% if approved_by_count > 0 and section.settings.approved_position == 'after_text' %}
                    <div class="c-approved-by{% if approved_by_count > 3 %} c-approved-by--secondary{% endif %}">
                        <ul>
                            {% for block in section.blocks %}
                                {% if block.type == 'approved-by' %}
                                    <li><img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" /></li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                        <p>
                            {% if section.settings.rating != blank %}
                                <span class="e-rating-stars" style="--rating: {{ section.settings.rating }}"></span>
                                <strong>{{ section.settings.rating }}/5</strong>{% if section.settings.rating_text != blank %}<br />{% endif %}
                            {% endif %}
                            {% if section.settings.rating_text != blank %}
                                {{ section.settings.rating_text }}
                            {% else %}
                                {% for block in section.blocks %}
                                    {% if block.type == 'approved-by' and block.settings.text != blank %}
                                        {{ block.settings.text | replace: '<p>', '' | replace: '</p>', '' }}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        </p>
                    </div>
                {% endif %}

                {% if section.settings.marked_list != blank and section.settings.marked_list_position == 'header' %}
                    {{ section.settings.marked_list | replace: '<ul>', '<ul class="c-marked-list">' }}
                {% endif %}
            </div>
            {% if section.settings.button_url != blank and section.settings.button_label != blank %}
                <div class="hero-section__content-button">
                    {% if section.settings.button_line %}
                        <hr />
                    {% endif %}
                    {% if section.settings.alert != blank %}
                        <div class="c-info-bar c-info-bar--alert c-info-bar--fill">{{ section.settings.alert | replace: '<p>', '' | replace: '</p>', '' }}</div>
                    {% endif %}
                    {% if section.settings.badge_text != blank %}
                        <div class="e-pill-badge e-pill-badge--sm">{{ section.settings.badge_text }}</div>
                    {% endif %}
                        <a href="{{ section.settings.button_url }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
                    {% if section.settings.wistia_url != blank and section.settings.wistia_mode == 'popover_button' %}
                        <div class="c-wistia c-wistia--custom">
                            <wistia-player media-id="{{ section.settings.wistia_url }}" wistia-popover="true" popover-content="link" end-video-behavior="loop" controls-visible-on-load="false" play-button="false">
                                <div class="c-wistia__custom">
                                    <a class="btn btn--secondary" href="javascript:;">{{ section.settings.video_button_label }}</a>
                                </div>
                            </wistia-player>
                        </div>
                    {% endif %}
                    {% if section.settings.sub_text != blank %}
                        <div class="c-info-bar">{{ section.settings.sub_text | replace: '<p>', '' | replace: '</p>', '' }}</div>
                    {% endif %}
                </div>
            {% endif %}
            {% if has_note or has_benefits or section.settings.video_image_cover != blank or section.settings.marked_list != blank and section.settings.marked_list_position == 'footer' %}
                <div class="hero-section__content-footer">
                    {% if has_benefits %}
                        <ul>
                            {% for block in section.blocks %}
                                {% if block.type == 'benefit' %}
                                    <li {{ block.shopify_attributes }}>
                                        {% if block.settings.image != blank %}
                                            <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                        {% endif %}
                                        {% if block.settings.text != blank %}
                                            <span>{{ block.settings.text }}</span>
                                        {% endif %}
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% for block in section.blocks %}
                        {% if block.type == 'note' %}
                            {% if block.settings.text != blank %}
                                <div class="c-note">
                                    <i class="e-icon e-icon-stars"></i>
                                    {{ block.settings.text }}
                                </div>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                    {% if section.settings.marked_list != blank and section.settings.marked_list_position == 'footer' %}
                        {{ section.settings.marked_list | replace: '<ul>', '<ul class="c-marked-list">' }}
                    {% endif %}
                    {% if section.settings.video_image_cover != blank and section.settings.wistia_mode == 'modal' %}
                        <picture
                            data-label-text="Watch: How To Use"
                            data-bs-toggle="modal"
                            data-bs-target="#hero-video-{{ section.id }}"
                        >
                            <img loading="lazy" src="{{ section.settings.video_image_cover | image_url }}" alt="{{ section.settings.video_image_cover.alt | escape }}" />
                        </picture>
                    {% endif %}
                </div>
            {% endif %}
        </article>
    </div>
</section>
{% if section.settings.wistia_url != blank and section.settings.wistia_mode == 'modal' %}
    <div class="modal fade filter-modal" id="hero-video-{{ section.id }}" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="hero-video-label-{{ section.id }}" style="display: none;" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-md filter-dialog">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <button type="button" class="btn btn-close" data-bs-dismiss="modal"
                        aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="modal-body">
                    <style>
                        wistia-player[media-id='{{ section.settings.wistia_url }}']:not(:defined) {
                            background: center / contain no-repeat url('https://fast.wistia.com/embed/medias/{{ section.settings.wistia_url }}/swatch');
                            display: block;
                            filter: blur(5px);
                            padding-top: 177.78%;
                        }
                    </style>
                    <div class="filter-modal-video">
                        <wistia-player media-id="{{ section.settings.wistia_url }}" seo="false" aspect="0.5625"
                            unique-id="wistia-{{ section.settings.wistia_url }}-23"></wistia-player>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}

{% schema %}
{
    "name": "t:sections.n_hero-section.name",
    "settings": [
        {
            "type": "checkbox",
            "id": "use_own_file",
            "label": "t:common.use-own-file",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "hidden",
            "label": "t:common.hidden",
            "default": false
        },
        {
            "type": "select",
            "id": "modifier",
            "label": "t:common.modifier",
            "default": "none",
            "options": [
                {
                    "value": "none",
                    "label": "t:common.none"
                },
                {
                    "value": "secondary",
                    "label": "t:common.secondary"
                },
                {
                    "value": "extended",
                    "label": "t:common.extended"
                },
                {
                    "value": "third",
                    "label": "t:common.third"
                }
            ]
        },
        {
            "type": "checkbox",
            "id": "show_logo",
            "label": "t:common.show-logo",
            "default": false
        },
        {
            "type": "select",
            "id": "approved_position",
            "label": "t:common.approved-position",
            "default": "before_text",
            "options": [
                {
                    "value": "before_text",
                    "label": "t:common.before-text"
                },
                {
                    "value": "after_text",
                    "label": "t:common.after-text"
                }
            ]
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text"
        },
        {
            "type": "text",
            "id": "rating",
            "label": "t:common.rating"
        },
        {
            "type": "inline_richtext",
            "id": "rating_text",
            "label": "t:common.rating-text"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:common.image"
        },
        {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "t:common.image-mobile"
        },
        {
            "type": "url",
            "id": "button_url",
            "label": "t:common.button-url"
        },
        {
            "type": "text",
            "id": "button_label",
            "label": "t:common.button-label"
        },
        {
            "type": "checkbox",
            "id": "button_line",
            "label": "t:common.button-line",
            "default": false
        },
        {
            "type": "richtext",
            "id": "alert",
            "label": "t:common.alert"
        },
        {
            "type": "richtext",
            "id": "sub_text",
            "label": "t:common.sub-text"
        },
        {
            "type": "richtext",
            "id": "marked_list",
            "label": "t:common.marked-list"
        },
        {
            "type": "select",
            "id": "marked_list_position",
            "label": "t:common.marked-list-position",
            "default": "footer",
            "options": [
                {
                    "value": "header",
                    "label": "t:common.header"
                },
                {
                    "value": "footer",
                    "label": "t:common.footer"
                }
            ]
        },
        {
            "type": "text",
            "id": "badge_text",
            "label": "t:common.badge-text"
        },
        {
            "type": "text",
            "id": "wistia_url",
            "label": "t:common.wistia-url"
        },
        {
            "type": "select",
            "id": "wistia_mode",
            "label": "t:common.wistia-mode",
            "default": "modal",
            "options": [
                {
                    "value": "modal",
                    "label": "t:common.modal"
                },
                {
                    "value": "popover_button",
                    "label": "t:common.popover-button"
                }
            ]
        },
        {
            "type": "text",
            "id": "video_button_label",
            "label": "t:common.video-button-label",
            "default": "Watch Video"
        },
        {
            "type": "image_picker",
            "id": "video_image_cover",
            "label": "t:common.video-image-cover"
        }
    ],
    "blocks": [
        {
            "type": "approved-by",
            "name": "t:common.approved-by",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        },
        {
            "type": "note",
            "name": "t:common.note",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        },
        {
            "type": "benefit",
            "name": "t:common.benefit",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_hero-section.name"
        }
    ]
}
{% endschema %}