{% doc %}
  Renders an expert reviews section
{% enddoc %}

<!-- EXPERT REVIEWS -->
{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/expert-reviews/expert-reviews.css" />
{% endif %}
<section class="expert-reviews expert-reviews--old-page">
    <div class="container">
        {{ section.settings.text }}
        {% if section.settings.wistia_url != blank %}
            <div class="c-wistia c-wistia--custom">
                <wistia-player media-id="{{ section.settings.wistia_url }}" wistia-popover="true" popover-content="link" end-video-behavior="loop" controls-visible-on-load="false" play-button="false">
                    <div class="c-wistia__custom">
                        {% if section.settings.image != blank %}
                            <picture>
                                <img loading="lazy" src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt | escape }}" />
                            </picture>
                        {% endif %}
                        {% if section.settings.button_label != blank %}
                            <div class="e-pill-badge e-pill-badge--sm">
                                <i class="e-icon e-icon-watch"></i>
                                <div>{{ section.settings.button_label | replace: '<p>', '' | replace: '</p>', '' }}</div>
                            </div>
                        {% endif %}
                    </div>
                </wistia-player>
            </div>
        {% endif %}
        
        <div class="expert-reviews__content">
            <div
                class="c-swiper c-swiper-thumbs"
                data-swiper='{
                        "slidesPerView": "auto",
                        "spaceBetween": 8,
                        "breakpoints": {
                            "768": {
                                "spaceBetween": 10
                            }
                        }
                    }'>
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        {% if block.type == 'slider' %}
                            {% if block.settings.image != blank %}
                                <div class="swiper-slide">
                                    <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                </div>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            <div
                class="c-swiper"
                data-swiper-thumbs=".expert-reviews .c-swiper-thumbs"
                data-swiper-events="autoplayTimeLeft"
                data-swiper='{
                        "slidesPerView": 1,
                        "spaceBetween": 16,
                        "loop": true,
                        "autoplay": {
                            "delay": 7000,
                            "disableOnInteraction": false
                        }
                    }'>
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        {% if block.type == 'slider' %}
                            {% if block.settings.text != blank %}
                                <div class="swiper-slide">
                                    {{ block.settings.text }}
                                </div>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% for block in section.blocks %}
                {% if block.type == 'disclaimer' %}
                    {% if block.settings.text != blank %}
                        <small>{{ block.settings.text }}</small>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
<!-- EXPERT REVIEWS END -->

{% schema %}
{
    "name": "t:sections.n_hair-growth-helmet-expert-reviews.name",
        "settings": [
            {
                "type": "checkbox",
                "id": "use_own_file",
                "label": "t:common.use-own-file",
                "default": false
            },
            {
                "type": "richtext",
                "id": "text",
                "label": "t:common.text"
            },
            {
                "type": "text",
                "id": "wistia_url",
                "label": "t:common.wistia-url"
            },
            {
                "type": "image_picker",
                "id": "image",
                "label": "t:common.image"
            },
            {
                "type": "richtext",
                "id": "button_label",
                "label": "t:common.button-label"
            }
    ],
    "blocks": [
        {
            "type": "slider",
            "name": "t:common.slider",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        },
        {
            "type": "disclaimer",
            "name": "t:common.disclaimer",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_hair-growth-helmet-expert-reviews.name"
        }
    ]
}
{% endschema %}
