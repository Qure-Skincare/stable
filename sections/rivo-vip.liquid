  var cfg;
  try { cfg = JSON.parse(cfgEl.textContent); } catch (e) { console.error('[qv-tiers] bad config', e); return; }

  var grid = root.querySelector('[data-qv-grid]');
  var source = root.querySelector('[data-qv-source]');
  var note = root.querySelector('[data-qv-note]');
  var progressEl = root.querySelector('[data-qv-progress]');
  var busy = false, lastSig = null, tries = 0;

  var CHECK = '<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.4"/><path d="M8.2 12.3l2.6 2.6 5-5.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var CROSS = '<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.4"/><path d="M9.3 9.3l5.4 5.4M14.7 9.3l-5.4 5.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';

  var FALLBACK_ICONS = [
    '<svg viewBox="0 0 12 15" fill="none"><path d="M5.78947 14C7.05972 14 8.27794 13.4954 9.17614 12.5972C10.0743 11.699 10.5789 10.4808 10.5789 9.21053C10.5789 7.84211 9.89474 6.54211 8.52632 5.44737C7.1579 4.35263 6.13158 2.71053 5.78947 1C5.44737 2.71053 4.42105 4.35263 3.05263 5.44737C1.68421 6.54211 1 7.84211 1 9.21053C1 10.4808 1.5046 11.699 2.4028 12.5972C3.30101 13.4954 4.51923 14 5.78947 14Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    '<svg viewBox="0 0 14 16" fill="none"><path d="M6.6 0.75L12.45 3.99987V11.6727L6.6 14.9227L0.75 11.6727V3.99987L6.6 0.75Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/><path d="M6.60094 3.78125L10.2409 5.58168V9.95415L6.60094 11.7547L2.96094 9.95415V5.58168L6.60094 3.78125Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/><path d="M6.60156 0.734375L6.60156 3.65938" stroke="currentColor" stroke-width="1"/><path d="M12.4521 4.0625L10.2422 5.68735" stroke="currentColor" stroke-width="1"/><path d="M12.2896 11.6406L10.2422 10.0156" stroke="currentColor" stroke-width="1"/><path d="M6.60156 14.7063L6.60156 11.7812" stroke="currentColor" stroke-width="1"/><path d="M0.75 11.6406L2.95997 10.0156" stroke="currentColor" stroke-width="1"/><path d="M0.75 4.0625L2.95999 5.68735" stroke="currentColor" stroke-width="1"/></svg>',
    '<svg viewBox="0 0 15 15" fill="none"><path d="M7.5 1L14 5.875L7.5 13.9999L1 5.875L7.5 1Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M1 5.85333L4.25 3.6963L7.5 1L10.75 3.6963L14 5.85333" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/><path d="M1 5.85156H14" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/><path d="M7.58594 1V5.85333" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/><path d="M4.29297 3.77344L7.5863 5.85344" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/><path d="M10.7059 3.77344L7.58594 5.85344" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/><path d="M7.58594 5.85156V13.9983" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/><path d="M1 5.85156L7.58667 13.9983" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/><path d="M14.0859 5.94531L7.58594 13.7453" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/></svg>',
    '<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="13" stroke="currentColor" stroke-width="1"/><path d="M24 15l2.6 5.6 6 .9-4.3 4.3 1 6.1-5.3-2.9-5.3 2.9 1-6.1-4.3-4.3 6-.9L24 15Z" stroke="currentColor" stroke-width="0.8" stroke-linejoin="round"/></svg>'
  ];

  var EMPTY = ['', '-', '–', '—', 'n/a', 'na', 'no', 'false', 'x', '✕', '✗'];

  function txt(el) { return el ? (el.textContent || '').replace(/ /g, ' ').replace(/\s+/g, ' ').trim() : ''; }
  function norm(v) { return String(v || '').toLowerCase().replace(/\s+/g, ' ').trim(); }
  function esc(v) {
    return String(v || '').replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function first(scope, list) {
    for (var i = 0; i < list.length; i++) {
      if (!list[i]) { continue; }
      var el = null;
      try { el = scope.querySelector(list[i]); } catch (e) { el = null; }
      if (el) { return el; }
    }
    return null;
  }
  function csvSet(value) {
    var out = {};
    String(value || '').split(',').forEach(function (item) {
      var key = norm(item);
      if (key) { out[key] = true; }
    });
    return out;
  }

  var YES = csvSet(cfg.yesTokens);
  var BOLD = csvSet(cfg.boldRows);

  var CELL_IMG = {};
  (cfg.cellImages || []).forEach(function (entry) {
    if (!entry || !entry.src) { return; }
    var tier = parseInt(entry.tier, 10) || 1;
    CELL_IMG[norm(entry.row) + '::' + tier] = { src: entry.src, label: entry.label || '', row: entry.row || '' };
  });
  function imgFor(rowLabel, tierIndex) {
    return CELL_IMG[norm(rowLabel) + '::' + (tierIndex + 1)] || null;
  }
  function giftForTier(tierIndex, data) {
    var found = null;
    Object.keys(CELL_IMG).forEach(function (key) {
      if (found) { return; }
      var parts = key.split('::');
      if (parseInt(parts[1], 10) === tierIndex + 1) { found = CELL_IMG[key]; }
    });
    if (!found) { return null; }
    var label = found.label;
    if (!label && found.row && data) {
      var row = data.rows.filter(function (r) { return norm(r.label) === norm(found.row); })[0];
      if (row && row.values[tierIndex]) { label = txt(row.values[tierIndex]); }
    }
    return { src: found.src, label: label || '' };
  }
  /* gift under a progress tier: perk image entry first, then the Rivo gift row's value */
  function progressGift(data, tierIndex) {
    var own = giftForTier(tierIndex, data);
    if (own && own.label) { return own; }
    if (!cfg.giftRow) { return own; }
    var row = data.rows.filter(function (r) { return norm(r.label) === norm(cfg.giftRow); })[0];
    var cell = row && row.values[tierIndex];
    if (!cell) { return own; }
    var raw = txt(cell);
    if (!raw || YES[norm(raw)] || !isIncluded(cell, raw)) { return own; }
    return { src: own ? own.src : '', label: raw };
  }
  function parseMoney(str) {
    var m = /[\d,.]+/.exec(String(str || ''));
    return m ? parseFloat(m[0].replace(/,/g, '')) : NaN;
  }

  function tierCfg(i) { return cfg.tiers[i] || cfg.tiers[cfg.tiers.length - 1]; }

  function columnKey(el) {
    if (!el) { return ''; }
    for (var i = 0; i < el.classList.length; i++) {
      if (/^rivo-tier-column-/.test(el.classList[i])) { return el.classList[i]; }
    }
    return '';
  }
  function hasCheckMark(cell) {
    if (cell.querySelector('[class*="no-mark"], [class*="cross"], [class*="times"]')) { return false; }
    return !!cell.querySelector('svg, [class*="check"], [class*="tick"], [class*="yes"]');
  }
  function isIncluded(cell, raw) {
    if (cell.querySelector('.rivo-tier-no-mark, [class*="no-mark"], [class*="cross"]')) { return false; }
    if (cell.querySelector('img')) { return true; }
    if (EMPTY.indexOf(norm(raw)) === -1) { return true; }
    return hasCheckMark(cell);
  }

  /* ---------- read the live Rivo table ---------- */
  function extract(table) {
    var heads = [].slice.call(table.querySelectorAll('.rivo-vip-tier-table-thead-tier-cell'));
    var names = [].slice.call(table.querySelectorAll('.rivo-vip-tier-table-row-perk-name'));
    var cells = [].slice.call(table.querySelectorAll('.rivo-vip-tier-table-row-perk-value'));
    if (!heads.length || !names.length) { return null; }

    var tiers = heads.map(function (head, i) {
      var key = columnKey(head);
      var img = head.querySelector('img');
      var imgSrc = img ? (img.getAttribute('src') || img.getAttribute('data-src') || '').trim() : '';
      return {
        index: i,
        key: key,
        name: txt(first(head, ['.rivo-th-tier-name', '[class*="tier-name"]'])) || txt(head),
        threshold: txt(first(head, ['.rivo-th-tier-threshold', '[class*="tier-threshold"]'])),
        iconSrc: imgSrc || null,
        cells: cells.filter(function (cell) { return key && cell.classList.contains(key); })
      };
    });

    var rows = names.map(function (nameEl, j) {
      return {
        label: txt(nameEl),
        values: tiers.map(function (tier) { return tier.cells[j] || null; })
      };
    }).filter(function (row) { return !!row.label; });

    return { tiers: tiers, rows: rows };
  }

  /* ---------- markup ---------- */
  function iconMarkup(tier) {
    var conf = tierCfg(tier.index);
    var src = conf.icon;
    var inner = src
      ? '<img data-qv-tier-icon="' + tier.index + '" src="' + esc(src) + '" alt="" loading="lazy">'
      : (FALLBACK_ICONS[tier.index] || FALLBACK_ICONS[FALLBACK_ICONS.length - 1]);
    var dark = conf.iconStyle === 'dark' ? ' qv-tier-icon--dark' : '';
    return '<span class="qv-tier-icon' + dark + '">' + inner + '</span>';
  }
  function pillIconMarkup(tier) {
    var conf = tierCfg(tier.index);
    var src = conf.icon;
    return src
      ? '<img data-qv-tier-icon="' + tier.index + '" src="' + esc(src) + '" alt="" loading="lazy">'
      : (FALLBACK_ICONS[tier.index] || FALLBACK_ICONS[FALLBACK_ICONS.length - 1]);
  }
  function wireIconFallback(container) {
    if (!container) { return; }
    var imgs = container.querySelectorAll('img[data-qv-tier-icon]');
    Array.prototype.forEach.call(imgs, function (img) {
      img.addEventListener('error', function onErr() {
        img.removeEventListener('error', onErr);
        var idx = parseInt(img.getAttribute('data-qv-tier-icon'), 10) || 0;
        var wrap = document.createElement('span');
        wrap.innerHTML = FALLBACK_ICONS[idx] || FALLBACK_ICONS[FALLBACK_ICONS.length - 1];
        if (wrap.firstChild) { img.replaceWith(wrap.firstChild); }
      });
    });
  }
  function nameMarkup(tier) {
    var short = (tierCfg(tier.index).short || '').trim();
    if (!short || norm(short) === norm(tier.name)) {
      return '<span class="qv-tier-name">' + esc(tier.name) + '</span>';
    }
    return '<span class="qv-tier-name qv-tier-name--dual">' +
      '<span class="qv-name-full">' + esc(tier.name) + '</span>' +
      '<span class="qv-name-short">' + esc(short) + '</span>' +
    '</span>';
  }
  function headMarkup(tier) {
    var conf = tierCfg(tier.index);
    return '<div class="qv-cell qv-cell--tier qv-cell--head" data-qv-col="' + tier.index + '" style="background:' + esc(conf.bg) + '">' +
      iconMarkup(tier) +
      nameMarkup(tier) +
      (tier.threshold ? '<span class="qv-tier-threshold">' + esc(tier.threshold) + '</span>' : '') +
      (cfg.currentLabel ? '<span class="qv-tier-current-badge">' + esc(cfg.currentLabel) + '</span>' : '') +
    '</div>';
  }
  function valueMarkup(cell, rowLabel, tierIndex) {
    var override = imgFor(rowLabel, tierIndex);
    var raw = cell ? txt(cell) : '';

    if (override) {
      var text = override.label || (YES[norm(raw)] ? '' : raw);
      return '<span class="qv-val">' +
        '<img class="qv-val-img" src="' + esc(override.src) + '" alt="" loading="lazy">' +
        (text ? '<span class="qv-val-text">' + esc(text) + '</span>' : '') +
      '</span>';
    }

    if (!cell) { return '<span class="qv-val"><span class="qv-mark">' + CROSS + '</span></span>'; }
    var img = cell.querySelector('img');
    if (!isIncluded(cell, raw)) {
      return '<span class="qv-val"><span class="qv-mark">' + CROSS + '</span></span>';
    }
    var parts = '';
    if (img) {
      parts += '<img class="qv-val-img" src="' + esc(img.getAttribute('src')) + '" alt="" loading="lazy">';
    } else if (hasCheckMark(cell)) {
      parts += '<span class="qv-mark">' + CHECK + '</span>';
    }
    if (raw && !YES[norm(raw)]) {
      var pts = /^[\d,.]+\s*points?$/i.test(raw) ? ' qv-val-text--points' : '';
      parts += '<span class="qv-val-text' + pts + '">' + esc(raw) + '</span>';
    }
    if (!parts) { parts = '<span class="qv-mark">' + CHECK + '</span>'; }
    return '<span class="qv-val">' + parts + '</span>';
  }
  function build(data) {
    var html = '<div class="qv-cell qv-cell--label qv-cell--head"></div>';
    html += data.tiers.map(headMarkup).join('');

    data.rows.forEach(function (row, r) {
      var bold = BOLD[norm(row.label)] ? ' qv-cell--bold' : '';
      var last = r === data.rows.length - 1 ? ' qv-cell--last' : '';
      html += '<div class="qv-cell qv-cell--label">' + esc(row.label) + '</div>';
      row.values.forEach(function (cell, i) {
        html += '<div class="qv-cell qv-cell--tier' + bold + last + '" data-qv-col="' + i + '" style="background:' + esc(tierCfg(i).bg) + '">' +
          valueMarkup(cell, row.label, i) + '</div>';
      });
    });

    grid.style.setProperty('--qv-cols', String(data.tiers.length));
    root.style.setProperty('--qv-cols', String(data.tiers.length));
    grid.innerHTML = html;
    wireIconFallback(grid);
  }

  /* ---------- current tier highlight ---------- */
  function alpineStore(name) {
    try { if (window.Alpine && typeof window.Alpine.store === 'function') { return window.Alpine.store(name); } } catch (e) {}
    return null;
  }
  function currentTierIndex(data, info) {
    var c = alpineStore('customer');
    var tierInfo = c && c.current_vip_tier_info;
    var name = tierInfo && tierInfo.tier && tierInfo.tier.name;
    if (name) {
      for (var i = 0; i < data.tiers.length; i++) {
        if (norm(data.tiers[i].name) === norm(name)) { return i; }
      }
    }
    return info && info.currentIndex >= 0 ? info.currentIndex : -1;
  }
  function markCurrent(idx) {
    var cells = grid.querySelectorAll('[data-qv-col]');
    Array.prototype.forEach.call(cells, function (cell) {
      cell.classList.toggle('qv-cell--current', idx >= 0 && parseInt(cell.getAttribute('data-qv-col'), 10) === idx);
    });
  }

  /* ---------- read the live Rivo progress bar ---------- */
  function splitProgressLabel(label) {
    var m = /[$£€]\s?[\d,.]+/.exec(label || '');
    var amount = m ? m[0] : '';
    return { name: (amount ? label.replace(amount, '') : label || '').trim(), value: parseMoney(amount) };
  }
  function extractProgress(rivoRoot, tiers) {
    var box = first(rivoRoot, ['.rivo-vip-tier-progress-container', '[class*="tier-progress-container"]']);
    if (!box || window.getComputedStyle(box).display === 'none') { return null; }

    var bar = first(box, ['.rivo-account-progress-bar', '[class*="account-progress-bar"]']);
    var pct = 0;
    if (bar) {
      var m = /([\d.]+)\s*%/.exec((bar.getAttribute('style') || ''));
      if (m) { pct = Math.max(0, Math.min(100, parseFloat(m[1]) || 0)); }
    }

    var cur = splitProgressLabel(txt(first(box, ['.rivo-account-progress-current-tier-label-container', '[class*="current-tier-label"]'])));
    var next = splitProgressLabel(txt(first(box, ['.rivo-account-progress-next-tier-label-container', '[class*="next-tier-label"]'])));

    function indexByName(name) {
      var target = norm(name);
      if (!target) { return -1; }
      for (var i = 0; i < tiers.length; i++) {
        if (norm(tiers[i].name) === target) { return i; }
      }
      return -1;
    }

    return {
      pct: pct,
      currentIndex: indexByName(cur.name),
      nextIndex: indexByName(next.name),
      currentValue: cur.value,
      nextValue: next.value,
      nextName: next.name
    };
  }

  /* ---------- build the clean progress stepper ---------- */
  function buildProgress(data, info) {
    if (!progressEl) { return; }
    if (!info || info.currentIndex < 0) { progressEl.hidden = true; return; }

    var remaining = null;
    if (info.nextIndex >= 0 && !isNaN(info.currentValue) && !isNaN(info.nextValue)) {
      remaining = Math.round((1 - info.pct / 100) * (info.nextValue - info.currentValue));
    }
    var highlightIndex = info.nextIndex >= 0 ? info.nextIndex : info.currentIndex;

    var html = '';
    var hasGift = false;
    data.tiers.forEach(function (tier, i) {
      var cls = 'qv-progress-node';
      if (i === info.currentIndex) cls += ' qv-progress-node--current';
      if (i === highlightIndex) cls += ' qv-progress-node--next';

      html += '<div class="' + cls + '">';
      html += '<span class="qv-progress-pill">' + pillIconMarkup(tier) + '<span class="qv-progress-pill-name">' + esc(tier.name) + '</span></span>';

      var below = '';
      if (tier.threshold) {
        below += '<p class="qv-progress-caption qv-progress-threshold">' + esc(tier.threshold) + '</p>';
      }
      if (i === info.currentIndex && info.nextIndex >= 0 && remaining !== null && !isNaN(remaining) && remaining > 0) {
        below += '<p class="qv-progress-caption qv-progress-away">You are $' + remaining.toLocaleString() + ' away from ' + esc(info.nextName) + '</p>';
      }
      var gift = progressGift(data, i);
      if (gift && gift.label) {
        hasGift = true;
        below += '<div class="qv-progress-gift">' +
          (gift.src ? '<img src="' + esc(gift.src) + '" alt="" loading="lazy">' : '') +
          '<span class="qv-progress-gift-name">' + esc(gift.label.replace(/^free\s+/i, '')) + '</span>' +
          (cfg.giftBadge ? '<span class="qv-progress-gift-badge">' + esc(cfg.giftBadge) + '</span>' : '') +
        '</div>';
      }
      if (below) {
        html += '<div class="qv-progress-below">' + below + '</div>';
      }

      html += '</div>';
      if (i < data.tiers.length - 1) {
        var fillPct = i < info.currentIndex ? 100 : (i === info.currentIndex ? info.pct : 0);
        html += '<div class="qv-progress-line"><span class="qv-progress-line-fill" style="width:' + fillPct + '%"></span></div>';
      }
    });
    progressEl.innerHTML = '<div class="qv-progress-track' + (hasGift ? ' qv-progress-track--gifts' : '') + '">' + html + '</div>';
    progressEl.hidden = false;
    wireIconFallback(progressEl);
    fitProgress();
  }

  /* phones: reserve only the space the captions and gift cards actually need */
  var MOBILE = window.matchMedia('(max-width: 767px)');
  function fitProgress() {
    var track = progressEl && progressEl.querySelector('.qv-progress-track');
    if (!track || progressEl.hidden) { return; }
    if (!MOBILE.matches) { track.style.removeProperty('padding-bottom'); return; }
    track.style.setProperty('padding-bottom', '0px');
    var bottom = track.getBoundingClientRect().bottom;
    var lowest = bottom;
    Array.prototype.forEach.call(track.querySelectorAll('.qv-progress-below'), function (el) {
      lowest = Math.max(lowest, el.getBoundingClientRect().bottom);
    });
    track.style.setProperty('padding-bottom', Math.ceil(lowest - bottom + 8) + 'px');
  }

  /* ---------- run ---------- */
  function hard(el, props) {
    if (!el) { return; }
    Object.keys(props).forEach(function (k) { el.style.setProperty(k, props[k], 'important'); });
  }
  var CLIP = {
    'position': 'absolute', 'width': '1px', 'height': '1px', 'min-height': '0',
    'margin': '0', 'padding': '0', 'border': '0', 'overflow': 'hidden',
    'clip-path': 'inset(50%)', 'opacity': '0', 'pointer-events': 'none'
  };

  function clipSources() {
    if (source) {
      var toClip = source.querySelectorAll(
        [cfg.sel.title, cfg.sel.subtitle, cfg.sel.table, 'table', 'thead', 'tbody', '[class*="tier-table"]', '[class*="tier-column"]']
          .filter(Boolean).join(', ')
