  }

  function apply() {
    clipSources();

    var rivoRoot = first(root, [cfg.sel.root, '#rivo-vip-tiers', '[id*="vip-tier"]']) || source;
    var table = rivoRoot ? first(rivoRoot, [cfg.sel.table, '.rivo-vip-tier-table', 'table']) : null;
    if (!table) { if (note) { note.hidden = false; } return false; }

    var data = extract(table);
    if (!data || !data.tiers.length) { if (note) { note.hidden = false; } return false; }
    if (note) { note.hidden = true; }

    busy = true;

    var sig = txt(table) + '|' + data.tiers.length;
    if (sig !== lastSig) {
      lastSig = sig;
