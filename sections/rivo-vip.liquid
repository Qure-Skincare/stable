{%- comment -%}
  RIVO: VIP TIERS — comparison table mirror (v16)
  Mirrors Rivo's live VIP tier table into a 3-column comparison grid.
  Install in sections/ and add the Rivo VIP Tiers app block.
{%- endcomment -%}

{%- liquid
  assign label_w = section.settings.label_col_width | default: 220
  assign radius = section.settings.panel_radius | default: 16
-%}

<div class="qv-tiers qv-tiers-{{ section.id }}" id="qv-tiers-{{ section.id }}" data-qv-root>

  {%- if section.settings.section_title != blank or section.settings.section_subtitle != blank -%}
    <div class="qv-head">
      {%- if section.settings.section_title != blank -%}
        <h2 class="qv-title">{{ section.settings.section_title }}</h2>
      {%- endif -%}
      {%- if section.settings.section_subtitle != blank -%}
        <p class="qv-sub">{{ section.settings.section_subtitle }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="qv-progress" data-qv-progress hidden></div>

  <div class="qv-panel" data-qv-panel>
    <div class="qv-grid" data-qv-grid></div>
  </div>

  {%- if section.settings.legend != blank -%}
    <p class="qv-legend">{{ section.settings.legend }}</p>
  {%- endif -%}

  {%- if request.design_mode -%}
    <div class="qv-note" data-qv-note hidden>
      Rivo's VIP Tiers block isn't rendering yet. Add the Rivo app block to this section
      and make sure VIP Tiers is enabled in Rivo &rarr; Loyalty page.
    </div>
  {%- endif -%}

  <div class="qv-source" data-qv-source>
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</div>

<script type="application/json" id="qv-cfg-{{ section.id }}">
{
  "boldRows": {{ section.settings.bold_rows | default: '' | json }},
  "yesTokens": {{ section.settings.yes_tokens | default: 'yes, true, included, ✓' | json }},
  "hideExternal": {{ section.settings.hide_external | default: true | json }},
  "giftRow": {{ section.settings.progress_gift_row | default: 'Free Product' | json }},
  "giftBadge": {{ section.settings.progress_gift_badge | default: 'Free Gift!' | json }},
  "currentLabel": {{ section.settings.current_tier_label | default: 'Your tier' | json }},
  "cellImages": [
    {%- assign emitted = 0 -%}
    {%- for i in (1..4) -%}
      {%- assign k_img = 'perk_img_' | append: i -%}
      {%- assign k_row = 'perk_img_row_' | append: i -%}
      {%- assign k_tier = 'perk_img_tier_' | append: i -%}
      {%- assign k_label = 'perk_img_label_' | append: i -%}
      {%- assign img = section.settings[k_img] -%}
      {%- if img != blank -%}
        {%- if emitted > 0 -%},{%- endif -%}
        {%- assign emitted = emitted | plus: 1 -%}
        {
          "row": {{ section.settings[k_row] | default: '' | json }},
          "tier": {{ section.settings[k_tier] | default: 1 | json }},
          "label": {{ section.settings[k_label] | default: '' | json }},
          "src": {{ img | image_url: width: 300 | json }}
        }
      {%- endif -%}
    {%- endfor -%}
  ],
  "tiers": [
    {
      "bg": {{ section.settings.tier1_bg | default: '#FFFFFF' | json }},
      "short": {{ section.settings.tier1_short | default: '' | json }},
      "iconStyle": {{ section.settings.tier1_icon_style | default: 'light' | json }},
      "icon": {% if section.settings.tier1_icon %}{{ section.settings.tier1_icon | image_url: width: 240 | json }}{% else %}null{% endif %}
    },
    {
      "bg": {{ section.settings.tier2_bg | default: '#F7F7F8' | json }},
      "short": {{ section.settings.tier2_short | default: '' | json }},
      "iconStyle": {{ section.settings.tier2_icon_style | default: 'light' | json }},
      "icon": {% if section.settings.tier2_icon %}{{ section.settings.tier2_icon | image_url: width: 240 | json }}{% else %}null{% endif %}
    },
    {
      "bg": {{ section.settings.tier3_bg | default: '#EDF2FA' | json }},
      "short": {{ section.settings.tier3_short | default: '' | json }},
      "iconStyle": {{ section.settings.tier3_icon_style | default: 'dark' | json }},
      "icon": {% if section.settings.tier3_icon %}{{ section.settings.tier3_icon | image_url: width: 240 | json }}{% else %}null{% endif %}
    },
    {
      "bg": {{ section.settings.tier4_bg | default: '#F4F1EA' | json }},
      "short": {{ section.settings.tier4_short | default: '' | json }},
      "iconStyle": {{ section.settings.tier4_icon_style | default: 'light' | json }},
      "icon": {% if section.settings.tier4_icon %}{{ section.settings.tier4_icon | image_url: width: 240 | json }}{% else %}null{% endif %}
    }
  ],
  "sel": {
    "root": {{ section.settings.sel_root | default: '#rivo-vip-tiers' | json }},
    "title": {{ section.settings.sel_title | default: '.rivo-lp-section-title' | json }},
    "subtitle": {{ section.settings.sel_subtitle | default: '.rivo-lp-section-subtitle' | json }},
    "container": {{ section.settings.sel_container | default: '.rivo-vip-tier-container' | json }},
    "table": {{ section.settings.sel_table | default: '.rivo-vip-tier-table' | json }}
  }
}
</script>

<style>
.qv-tiers-{{ section.id }} {
  --qv-ink: {{ section.settings.ink | default: '#1B1D21' }};
  --qv-muted: {{ section.settings.muted | default: '#6B7280' }};
  --qv-line: {{ section.settings.line | default: '#E5E7EB' }};
  --qv-panel-bg: {{ section.settings.panel_bg | default: '#FFFFFF' }};
  --qv-icon-ring: {{ section.settings.icon_ring | default: '#D9DCE1' }};
  --qv-icon-dark: {{ section.settings.icon_dark | default: '#17171B' }};
  --qv-mark: {{ section.settings.mark_color | default: '#4B5563' }};
  --qv-progress-fill: {{ section.settings.progress_fill_brand | default: '#FF5429' }};
  --qv-current: {{ section.settings.current_tier_color | default: '#FF5429' }};
  --qv-current-badge-bg: {{ section.settings.current_badge_bg | default: '#FDE8DD' }};
  --qv-current-badge-text: {{ section.settings.current_badge_text | default: '#C1502E' }};
  --qv-label-w: {{ label_w }}px;
  --qv-radius: {{ radius }}px;
  --qv-serif: {{ section.settings.serif_stack | default: "'Canela', Georgia, 'Times New Roman', serif" }};
  --qv-sans: {{ section.settings.sans_stack | default: "'TT Commons', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif" }};
  --qv-cols: 3;

  position: relative;
  box-sizing: border-box;
  width: 100%;
  padding: {{ section.settings.pad_top | default: 72 }}px 24px {{ section.settings.pad_bottom | default: 88 }}px;
  background: {{ section.settings.section_bg | default: '#FFFFFF' }};
  color: var(--qv-ink);
  font-family: var(--qv-sans);
}
.qv-tiers-{{ section.id }} *, .qv-tiers-{{ section.id }} *::before, .qv-tiers-{{ section.id }} *::after { box-sizing: border-box; }

/* ---------- header ---------- */
.qv-tiers-{{ section.id }} .qv-head { max-width: 760px; margin: 0 auto 40px; text-align: center; }
.qv-tiers-{{ section.id }} .qv-title {
  margin: 0 0 14px; font-family: var(--qv-serif); font-size: 38px; font-weight: 300;
  line-height: 42px; letter-spacing: -.01em; color: var(--qv-ink);
}
.qv-tiers-{{ section.id }} .qv-sub { margin: 0; font-size: 16px; line-height: 1.5; color: var(--qv-ink); }

/* ---------- panel ---------- */
.qv-tiers-{{ section.id }} .qv-panel {
  max-width: {{ section.settings.max_width | default: 1180 }}px; margin: 0 auto;
  background: var(--qv-panel-bg);
  border: 1px solid var(--qv-line); border-radius: var(--qv-radius); overflow: hidden;
}
.qv-tiers-{{ section.id }} .qv-grid {
  display: grid;
  grid-template-columns: var(--qv-label-w) repeat(var(--qv-cols), minmax(0, 1fr));
  align-items: stretch;
}

/* ---------- cells ---------- */
.qv-tiers-{{ section.id }} .qv-cell {
  display: flex; align-items: center; min-width: 0;
  padding: {{ section.settings.row_pad | default: 14 }}px 18px;
}
.qv-tiers-{{ section.id }} .qv-cell--label {
  justify-content: flex-start; padding-left: 20px; padding-right: 16px;
  font-size: 15px; line-height: 1.35; color: var(--qv-ink);
}
.qv-tiers-{{ section.id }} .qv-cell--tier {
  justify-content: center; text-align: center; border-left: 1px solid var(--qv-line);
  font-size: 18px; line-height: 1.35; color: var(--qv-ink);
}
.qv-tiers-{{ section.id }} .qv-cell--bold { font-weight: 600; }

/* ---------- current tier highlight ---------- */
.qv-tiers-{{ section.id }} .qv-cell--current {
  border-left-color: transparent;
  box-shadow: inset 1.5px 0 0 var(--qv-current), inset -1.5px 0 0 var(--qv-current);
}
/* rounded ends, same radius as the gift cards */
.qv-tiers-{{ section.id }} .qv-cell--head.qv-cell--current {
  border-radius: 14px 14px 0 0;
  box-shadow: inset 1.5px 0 0 var(--qv-current), inset -1.5px 0 0 var(--qv-current), inset 0 1.5px 0 var(--qv-current);
}
.qv-tiers-{{ section.id }} .qv-cell--last.qv-cell--current {
  border-radius: 0 0 14px 14px;
  box-shadow: inset 1.5px 0 0 var(--qv-current), inset -1.5px 0 0 var(--qv-current), inset 0 -1.5px 0 var(--qv-current);
}
/* pill label at the top of the current column, styled like the Free Gift badges */
.qv-tiers-{{ section.id }} .qv-cell--head { position: relative; }
.qv-tiers-{{ section.id }} .qv-cell--head.qv-cell--current { padding-top: calc({{ section.settings.head_pad_top | default: 34 }}px + 36px); }
.qv-tiers-{{ section.id }} .qv-tier-current-badge {
  display: none; position: absolute; top: 16px; left: 50%; transform: translateX(-50%);
  padding: 4px 12px; border-radius: 999px; white-space: nowrap;
  background: var(--qv-current-badge-bg); color: var(--qv-current-badge-text);
  font-size: 14px; font-weight: 600; line-height: 1.3;
}
.qv-tiers-{{ section.id }} .qv-cell--current .qv-tier-current-badge { display: block; }

/* ---------- tier header ---------- */
.qv-tiers-{{ section.id }} .qv-cell--head {
  flex-direction: column; justify-content: flex-end;
  padding-top: {{ section.settings.head_pad_top | default: 34 }}px; padding-bottom: 26px;
}
.qv-tiers-{{ section.id }} .qv-cell--label.qv-cell--head { padding: 0; }
.qv-tiers-{{ section.id }} .qv-tier-icon {
  display: grid; place-items: center;
  width: {{ section.settings.icon_circle | default: 88 }}px; height: {{ section.settings.icon_circle | default: 88 }}px;
  margin-bottom: 16px; border-radius: 50%;
  border: 1px solid var(--qv-icon-ring); background: #FFFFFF; color: var(--qv-ink);
  overflow: hidden;
}

.qv-tier-icon svg path {
  stroke-width: 0.8 !important;
}
.qv-tiers-{{ section.id }} .qv-tier-icon--dark {
  background: var(--qv-icon-dark); border-color: var(--qv-icon-dark); color: #FFFFFF;
}
.qv-tiers-{{ section.id }} .qv-tier-icon img,
.qv-tiers-{{ section.id }} .qv-tier-icon svg {
  display: block; width: 56%; height: 56%; object-fit: contain;
}
.qv-tiers-{{ section.id }} .qv-tier-name {
  font-family: var(--qv-serif); font-size: 26px; font-weight: 400; line-height: 1.15;
  letter-spacing: -.01em; color: var(--qv-ink);
}
.qv-tiers-{{ section.id }} .qv-tier-threshold {
  margin-top: 6px; font-size: 15px; font-weight: 600; color: var(--qv-ink);
}
.qv-tiers-{{ section.id }} .qv-tier-badge {
  margin-top: 8px; padding: 4px 10px; border-radius: 999px;
  border: 1px solid var(--qv-ink); font-size: 11px; font-weight: 700;
  letter-spacing: .04em; text-transform: uppercase;
}

/* ---------- value marks ---------- */
.qv-tiers-{{ section.id }} .qv-val { display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
.qv-tiers-{{ section.id }} .qv-mark { display: inline-flex; flex: 0 0 auto; color: var(--qv-mark); }
.qv-tiers-{{ section.id }} .qv-mark svg { display: block; width: 20px; height: 20px; }
.qv-tiers-{{ section.id }} .qv-val-img {
  flex: 0 0 auto;
  width: {{ section.settings.perk_img_size | default: 46 }}px;
  height: {{ section.settings.perk_img_size | default: 46 }}px;
  object-fit: contain; border-radius: 6px;
}
.qv-tiers-{{ section.id }} .qv-val-text { min-width: 0; }
/* "150 points" style values stay on one line */
.qv-tiers-{{ section.id }} .qv-val-text--points { white-space: nowrap; }

/* ---------- misc ---------- */
.qv-tiers-{{ section.id }} .qv-legend {
  max-width: {{ section.settings.max_width | default: 1180 }}px; margin: 20px auto 0;
  font-size: 13px; line-height: 1.5; color: var(--qv-muted);
}
.qv-tiers-{{ section.id }} .qv-note {
  max-width: 60ch; margin: 24px auto 0; padding: 16px 18px;
  border: 1px dashed var(--qv-muted); font-size: 13px; line-height: 1.6; color: var(--qv-muted);
}
/* the live Rivo block stays mounted but clipped (never display:none — Alpine
   needs it); its progress bar and tier table are both read into custom
   markup below instead of being shown directly */
.qv-tiers-{{ section.id }} .qv-source {
  position: absolute !important; width: 1px !important; height: 1px !important;
  margin: 0 !important; padding: 0 !important; overflow: hidden !important;
  clip-path: inset(50%) !important; opacity: 0 !important; pointer-events: none !important;
}

/* ---------- VIP progress stepper (mirrors Rivo's live progress bar) ---------- */
.qv-tiers-{{ section.id }} .qv-progress {
  max-width: {{ section.settings.max_width | default: 1180 }}px; margin: 0 auto 40px;
  text-align: center;
}
.qv-tiers-{{ section.id }} .qv-progress[hidden] { display: none; }
.qv-tiers-{{ section.id }} .qv-progress-title {
  margin: 0 0 28px; font-family: var(--qv-serif); font-style: italic; font-weight: 400;
  font-size: 30px; line-height: 1.2; color: var(--qv-ink);
}
.qv-tiers-{{ section.id }} .qv-progress-track {
  display: flex; align-items: center; justify-content: center; gap: 0;
  padding-bottom: 48px;
}
/* room for the gift cards under the tiers */
.qv-tiers-{{ section.id }} .qv-progress-track--gifts { padding-bottom: 150px; }
.qv-tiers-{{ section.id }} .qv-progress-node {
  position: relative; display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
}
.qv-tiers-{{ section.id }} .qv-progress-pill {
  display: inline-flex; align-items: center; gap: 8px; padding: 7px 16px;
  border: 1px solid var(--qv-ink); border-radius: 999px; background: var(--qv-panel-bg);
  font-size: 14px; font-weight: 600; color: var(--qv-ink); white-space: nowrap;
}
.qv-tiers-{{ section.id }} .qv-progress-pill img,
.qv-tiers-{{ section.id }} .qv-progress-pill svg { display: block; width: 16px; height: 16px; object-fit: contain; flex: 0 0 auto; }
.qv-tiers-{{ section.id }} .qv-progress-line {
  flex: 1 1 auto; height: 3px; background: var(--qv-ink);
  position: relative; min-width: 16px;
}
.qv-tiers-{{ section.id }} .qv-progress-line-fill {
  position: absolute; left: 0; top: 0; height: 100%; background: var(--qv-progress-fill);
}
.qv-tiers-{{ section.id }} .qv-progress-below {
  position: absolute; left: 50%; top: 100%; transform: translateX(-50%);
  margin-top: 12px; display: flex; flex-direction: column; align-items: center; gap: 12px;
  width: max-content; max-width: 200px;
}
.qv-tiers-{{ section.id }} .qv-progress-caption {
  margin: 0; font-size: 13px; line-height: 1.4; color: var(--qv-muted);
}
/* "you are $X away" text hidden on desktop; shown on mobile for the current tier */
.qv-tiers-{{ section.id }} .qv-progress-away { display: none; }
.qv-tiers-{{ section.id }} .qv-progress-gift {
  display: flex; flex-direction: column; align-items: center; gap: 8px; margin: 0; padding: 12px 16px;
  border: 1px solid var(--qv-line); border-radius: 14px; background: var(--qv-panel-bg);
  color: var(--qv-ink); text-align: center;
}
.qv-tiers-{{ section.id }} .qv-progress-gift img { width: 40px; height: 40px; object-fit: contain; border-radius: 6px; }
.qv-tiers-{{ section.id }} .qv-progress-gift-name {
  font-size: 15px; font-weight: 600; line-height: 1.25; white-space: nowrap;
}
.qv-tiers-{{ section.id }} .qv-progress-gift-badge {
  padding: 4px 12px; border-radius: 999px;
  background: {{ section.settings.progress_gift_bg | default: '#FDE8DD' }};
  color: {{ section.settings.progress_gift_text | default: '#C1502E' }};
  font-size: 14px; font-weight: 600; line-height: 1.3; white-space: nowrap;
}

/* short tier names only swap in on phones, and only when one was provided */
.qv-tiers-{{ section.id }} .qv-name-short { display: none; }

/* ---------- tablet: same table, tighter ---------- */
@media (max-width: 900px) and (min-width: 768px) {
  .qv-tiers-{{ section.id }} { padding: 48px 16px 56px; }
  .qv-tiers-{{ section.id }} .qv-title { font-size: 32px; }
  .qv-tiers-{{ section.id }} .qv-grid { grid-template-columns: 170px repeat(var(--qv-cols), minmax(0, 1fr)); }
  .qv-tiers-{{ section.id }} .qv-cell { padding: 12px 10px; font-size: 14px; }
  .qv-tiers-{{ section.id }} .qv-cell--label { padding-left: 14px; font-size: 14px; }
  .qv-tiers-{{ section.id }} .qv-tier-icon { width: 64px; height: 64px; margin-bottom: 12px; }
  .qv-tiers-{{ section.id }} .qv-tier-name { font-size: 20px; }
  .qv-tiers-{{ section.id }} .qv-tier-threshold { font-size: 13px; }
}

/* ---------- phone: everything shrinks to fit, no horizontal scroll ---------- */
@media (max-width: 767px) {
  .qv-tiers-{{ section.id }} {
    --qv-mobile-pad-x: 12px;
    padding: {{ section.settings.pad_top_mobile | default: 40 }}px var(--qv-mobile-pad-x) {{ section.settings.pad_bottom_mobile | default: 48 }}px;
  }
  .qv-tiers-{{ section.id }} .qv-head { margin-bottom: 24px; }
  .qv-tiers-{{ section.id }} .qv-title { font-size: {{ section.settings.title_size_mobile | default: 34 }}px; margin-bottom: 10px; }
  .qv-tiers-{{ section.id }} .qv-sub { font-size: 16px; line-height: 1.45; }

  /* edge-to-edge on phones: bleed past the section's own side padding, no side border/radius */
  .qv-tiers-{{ section.id }} .qv-panel {
    overflow: hidden;
    width: auto;
    margin-left: calc(-1 * var(--qv-mobile-pad-x));
    margin-right: calc(-1 * var(--qv-mobile-pad-x));
    border: none;
    border-top: 1px solid var(--qv-line);
    border-radius: 0;
  }
  .qv-tiers-{{ section.id }} .qv-grid {
    min-width: 0;
    grid-template-columns: {{ section.settings.label_col_mobile | default: 30 }}% repeat(var(--qv-cols), minmax(0, 1fr));
  }

  .qv-tiers-{{ section.id }} .qv-cell {
    padding: {{ section.settings.row_pad_mobile | default: 26 }}px 6px;
    font-size: {{ section.settings.value_text_mobile | default: 15 }}px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .qv-tiers-{{ section.id }} .qv-cell--label {
    padding-left: 12px; padding-right: 8px;
    font-size: {{ section.settings.label_text_mobile | default: 14 }}px;
    color: var(--qv-muted);
  }
  .qv-tiers-{{ section.id }} .qv-cell--tier { font-size: 16px; }

  .qv-tiers-{{ section.id }} .qv-cell--head { padding-top: 20px; padding-bottom: 16px; }
  .qv-tiers-{{ section.id }} .qv-cell--head.qv-cell--current { padding-top: 50px; }
  .qv-tiers-{{ section.id }} .qv-tier-current-badge { top: 12px; padding: 3px 8px; font-size: 11px; }
  {%- if section.settings.hide_icons_mobile %}
  .qv-tiers-{{ section.id }} .qv-tier-icon { display: none; }
  {%- else %}
  .qv-tiers-{{ section.id }} .qv-tier-icon { width: 40px; height: 40px; margin-bottom: 8px; }
  {%- endif %}
  {%- if section.settings.hide_threshold_mobile %}
  .qv-tiers-{{ section.id }} .qv-tier-threshold { display: none; }
  {%- else %}
  .qv-tiers-{{ section.id }} .qv-tier-threshold { margin-top: 6px; font-size: 16px; line-height: 1.3; font-weight: 400}
  {%- endif %}
  .qv-tiers-{{ section.id }} .qv-tier-name {
    font-size: {{ section.settings.tier_name_size_mobile | default: 24 }}px;
    font-weight: 600; line-height: 1.2;
  }
  .qv-tiers-{{ section.id }} .qv-tier-name--dual .qv-name-full { display: none; }
  .qv-tiers-{{ section.id }} .qv-tier-name--dual .qv-name-short { display: inline; font-weight: 300; font-size: 24px; }

  .qv-tiers-{{ section.id }} .qv-val { flex-direction: column; gap: 8px; }
  .qv-tiers-{{ section.id }} .qv-mark svg { width: 22px; height: 22px; }
  .qv-tiers-{{ section.id }} .qv-val-img { width: 36px; height: 36px; }
  .qv-tiers-{{ section.id }} .qv-val-text { font-size: {{ section.settings.value_text_mobile | default: 15 }}px; font-weight: 500; }
  .qv-tiers-{{ section.id }} .qv-legend { font-size: 15px; }

  .qv-tiers-{{ section.id }} .qv-progress-title { font-size: 24px; margin-bottom: 20px; }
  .qv-tiers-{{ section.id }} .qv-progress { margin-bottom: 24px; }

  /* progress bar: compact circles for non-target tiers, full pill for next tier */
  .qv-tiers-{{ section.id }} .qv-progress-track { overflow: visible; justify-content: center; padding: 0 8px 60px; }
  .qv-tiers-{{ section.id }} .qv-progress-track--gifts { padding-bottom: 170px; }
  /* fixed width so neighbouring gift cards can't overlap */
  .qv-tiers-{{ section.id }} .qv-progress-gift { width: 100px; padding: 10px 8px; gap: 6px; }
  .qv-tiers-{{ section.id }} .qv-progress-gift-name { font-size: 13px; white-space: normal; overflow-wrap: break-word; }
  .qv-tiers-{{ section.id }} .qv-progress-gift-badge { font-size: 12px; padding: 3px 8px; }
  .qv-tiers-{{ section.id }} .qv-progress-pill {
    padding: 10px; border-radius: 50%; gap: 0;
  }
  .qv-tiers-{{ section.id }} .qv-progress-pill-name { display: none; }
  .qv-tiers-{{ section.id }} .qv-progress-pill svg,
  .qv-tiers-{{ section.id }} .qv-progress-pill img { width: 22px; height: 22px; }
  .qv-tiers-{{ section.id }} .qv-progress-node--next .qv-progress-pill {
    padding: 7px 16px; border-radius: 999px; gap: 8px;
  }
  .qv-tiers-{{ section.id }} .qv-progress-node--next .qv-progress-pill-name { display: inline; }
  .qv-tiers-{{ section.id }} .qv-progress-node--current .qv-progress-away { display: block; }
  .qv-tiers-{{ section.id }} .qv-progress-node--current .qv-progress-threshold { display: none; }
  .qv-tiers-{{ section.id }} .qv-progress-line { min-width: 24px; }
  .qv-tiers-{{ section.id }} .qv-progress-below { max-width: 140px; }
  /* pin edge captions inward so they don't overflow the viewport */
  .qv-tiers-{{ section.id }} .qv-progress-node:first-child .qv-progress-below {
    left: 0; transform: none; align-items: flex-start; text-align: left;
  }
  .qv-tiers-{{ section.id }} .qv-progress-node:last-child .qv-progress-below {
    left: auto; right: 0; transform: none; align-items: flex-end; text-align: right;
  }
}

/* very narrow phones — one more step down so 4 tiers still fit */
@media (max-width: 380px) {
  .qv-tiers-{{ section.id }} .qv-cell { padding-left: 4px; padding-right: 4px; font-size: 14px; }
