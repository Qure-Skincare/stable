  .qv-tiers-{{ section.id }} .qv-val-text { font-size: 14px; }
  .qv-tiers-{{ section.id }} .qv-tier-name { font-size: 20px; }
}
</style>

<script>
(function () {
  var root = document.getElementById('qv-tiers-{{ section.id }}');
