{% doc %}
  Renders a set up toggle section
{% enddoc %}

<!-- SET UP TOGGLE -->
<section class="set-up-toggle">
    <div class="container">
        {% assign tab_index = 0 %}
        {% for block in section.blocks %}
            {% if block.type == 'tab' %}
                {% assign tab_id = block.settings.label | strip | handleize %}
                {% if tab_id != blank %}
                    {% assign tab_index = tab_index | plus: 1 %}
                    <input type="radio" name="set-up-toggle-radio" id="set-up-toggle-{{ tab_id }}"{% if tab_index == 1 %} checked{% endif %} />
                {% endif %}
            {% endif %}
        {% endfor %}
        {% for block in section.blocks %}
            {% if block.type == 'tab' %}
                {% assign tab_id = block.settings.label | strip | handleize %}
                {% if tab_id != blank %}
                    {% if block.settings.wistia_url != blank %}
                        <div class="c-wistia c-wistia--custom c-wistia--{{ tab_id }}">
                            <wistia-player media-id="{{ block.settings.wistia_url }}" wistia-popover="true" popover-content="link" end-video-behavior="loop" controls-visible-on-load="false" play-button="false">
                                <div class="c-wistia__custom">
                                    {% if block.settings.video_image_mobile != blank %}
                                        <picture>
                                            {% if block.settings.video_image != blank %}
                                                <source media="(min-width:768px)" srcset="{{ block.settings.video_image | image_url }}" />
                                            {% endif %}
                                            <img loading="lazy" src="{{ block.settings.video_image_mobile | image_url }}" alt="{{ block.settings.video_image_mobile.alt | escape }}" />
                                        </picture>
                                    {% endif %}
                                </div>
                            </wistia-player>
                        </div>
                    {% endif %}
                {% endif %}
            {% endif %}
        {% endfor %}
        <ul class="set-up-toggle__switcher">
            {% for block in section.blocks %}
                {% if block.type == 'tab' %}
                    {% assign tab_id = block.settings.label | strip | handleize %}
                    {% if tab_id != blank %}
                        <li>
                            <label for="set-up-toggle-{{ tab_id }}">
                                {{ block.settings.label }}
                                {% if block.settings.image != blank %}
                                    <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                {% endif %}
                            </label>
                        </li>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </ul>
        {{ section.settings.text }}
        {% for block in section.blocks %}
            {% if block.type == 'tab' %}
                {% assign tab_id = block.settings.label | strip | handleize %}
                {% if tab_id != blank %}
                    <ol class="set-up-toggle__steps set-up-toggle__steps--{{ tab_id }}">
                        {% for block in section.blocks %}
                            {% if block.type == 'step' %}
                                {% assign step_tab_id = block.settings.tab_id | strip | handleize %}
                                {% if step_tab_id == tab_id %}
                                    <li>
                                        {% if block.settings.image_mobile != blank %}
                                            <picture>
                                                {% if block.settings.image != blank %}
                                                    <source media="(min-width:768px)" srcset="{{ block.settings.image | image_url }}" />
                                                {% endif %}
                                                <img loading="lazy" src="{{ block.settings.image_mobile | image_url }}" alt="{{ block.settings.image_mobile.alt | escape }}" />
                                            </picture>
                                        {% endif %}
                                        {{ block.settings.text }}
                                    </li>
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    </ol>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
</section>
<!-- SET UP TOGGLE END -->

{% schema %}
{
    "name": "t:sections.n_set-up-toggle.name",
    "settings": [
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text"
        }
    ],
    "blocks": [
        {
            "type": "tab",
            "name": "t:common.tab",
            "settings": [
                {
                    "type": "text",
                    "id": "label",
                    "label": "t:common.label-text"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "text",
                    "id": "wistia_url",
                    "label": "t:common.wistia-url"
                },
                {
                    "type": "image_picker",
                    "id": "video_image",
                    "label": "t:common.video-image-cover"
                },
                {
                    "type": "image_picker",
                    "id": "video_image_mobile",
                    "label": "t:common.image-mobile"
                }
            ]
        },
        {
            "type": "step",
            "name": "t:common.step",
            "settings": [
                {
                    "type": "text",
                    "id": "tab_id",
                    "label": "t:common.tab-id"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "image_picker",
                    "id": "image_mobile",
                    "label": "t:common.image-mobile"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_set-up-toggle.name"
        }
    ]
}
{% endschema %}
