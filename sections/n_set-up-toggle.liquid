{% doc %}
  Renders a set up toggle section
{% enddoc %}

<!-- SET UP TOGGLE -->
<section class="set-up-toggle">
    <div class="container">
        {% assign tab_index = 0 %}
        {% for block in section.blocks %}
            {% if block.type == 'tab' %}
                {% assign tab_index = tab_index | plus: 1 %}
                {% if tab_index == 1 %}
                    {% assign pane = 'first' %}
                {% else %}
                    {% assign pane = 'second' %}
                {% endif %}
                <input type="radio" name="set-up-toggle-radio" id="set-up-toggle-{{ pane }}"{% if tab_index == 1 %} checked{% endif %} />
            {% endif %}
        {% endfor %}
        {% assign tab_index = 0 %}
        {% for block in section.blocks %}
            {% if block.type == 'tab' %}
                {% assign tab_index = tab_index | plus: 1 %}
                {% if tab_index == 1 %}
                    {% assign pane = 'first' %}
                {% else %}
                    {% assign pane = 'second' %}
                {% endif %}
                {% if block.settings.wistia_url != blank %}
                    <div class="c-wistia c-wistia--custom c-wistia--{{ pane }}">
                        <wistia-player media-id="{{ block.settings.wistia_url }}" wistia-popover="true" popover-content="link" end-video-behavior="loop" controls-visible-on-load="false" play-button="false">
                            <div class="c-wistia__custom">
                                {% if block.settings.video_image_mobile != blank %}
                                    <picture>
                                        {% if block.settings.video_image != blank %}
                                            <source media="(min-width:768px)" srcset="{{ block.settings.video_image | image_url }}" />
                                        {% endif %}
                                        <img loading="lazy" src="{{ block.settings.video_image_mobile | image_url }}" alt="{{ block.settings.video_image_mobile.alt | escape }}" />
                                    </picture>
                                {% endif %}
                            </div>
                        </wistia-player>
                    </div>
                {% endif %}
            {% endif %}
        {% endfor %}
        <ul class="set-up-toggle__switcher">
            {% assign tab_index = 0 %}
            {% for block in section.blocks %}
                {% if block.type == 'tab' %}
                    {% assign tab_index = tab_index | plus: 1 %}
                    {% if tab_index == 1 %}
                        {% assign pane = 'first' %}
                    {% else %}
                        {% assign pane = 'second' %}
                    {% endif %}
                    <li>
                        <label for="set-up-toggle-{{ pane }}">
                            {{ block.settings.label }}
                            {% if block.settings.image != blank %}
                                <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                            {% endif %}
                        </label>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
        {{ section.settings.text }}
        {% assign tab_index = 0 %}
        {% for block in section.blocks %}
            {% if block.type == 'tab' %}
                {% assign tab_index = tab_index | plus: 1 %}
                {% if tab_index == 1 %}
                    {% assign pane = 'first' %}
                {% else %}
                    {% assign pane = 'second' %}
                {% endif %}
                <ol class="set-up-toggle__steps set-up-toggle__steps--{{ pane }}">
                    {% for block in section.blocks %}
                        {% if block.type == 'step' %}
                            {% assign step_tab_id = block.settings.tab_id | strip | handleize %}
                            {% if step_tab_id == pane %}
                                <li>
                                    {% if block.settings.image_mobile != blank %}
                                        <picture>
                                            {% if block.settings.image != blank %}
                                                <source media="(min-width:768px)" srcset="{{ block.settings.image | image_url }}" />
                                            {% endif %}
                                            <img loading="lazy" src="{{ block.settings.image_mobile | image_url }}" alt="{{ block.settings.image_mobile.alt | escape }}" />
                                        </picture>
                                    {% endif %}
                                    {{ block.settings.text }}
                                </li>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </ol>
            {% endif %}
        {% endfor %}
    </div>
</section>
<!-- SET UP TOGGLE END -->

{% schema %}
{
    "name": "t:sections.n_set-up-toggle.name",
    "settings": [
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text"
        }
    ],
    "blocks": [
        {
            "type": "tab",
            "name": "t:common.tab",
            "settings": [
                {
                    "type": "text",
                    "id": "label",
                    "label": "t:common.label-text"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "text",
                    "id": "wistia_url",
                    "label": "t:common.wistia-url"
                },
                {
                    "type": "image_picker",
                    "id": "video_image",
                    "label": "t:common.video-image-cover"
                },
                {
                    "type": "image_picker",
                    "id": "video_image_mobile",
                    "label": "t:common.image-mobile"
                }
            ]
        },
        {
            "type": "step",
            "name": "t:common.step",
            "settings": [
                {
                    "type": "text",
                    "id": "tab_id",
                    "label": "t:common.tab-id"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "image_picker",
                    "id": "image_mobile",
                    "label": "t:common.image-mobile"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_set-up-toggle.name"
        }
    ]
}
{% endschema %}
