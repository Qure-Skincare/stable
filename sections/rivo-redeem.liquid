{% comment %}
RIVO: REDEEM PRODUCTS SECTION
True horizontal carousel:
- Desktop: 3 cards at a time (fewer only if there are fewer rewards than that)
- Mobile: 1 full-width card, with overlay arrows beside it so it reads as scrollable
- Cards are sized so no card is ever partially shown
{% endcomment %}

<div
  id="rivo-redeem-products-{{ section.id }}"
  class="rivo-redeem"
  style="background-color: {{ section.settings.section_bg }}"
>
  {% if section.settings.section_title != blank or section.settings.section_subtitle != blank %}
    <div class="rivo-redeem-header">
      {% if section.settings.section_title != blank %}
        <h2 class="rivo-redeem-title">{{ section.settings.section_title }}</h2>
      {% endif %}
      {% if section.settings.section_subtitle != blank %}
        <p class="rivo-redeem-subtitle">{{ section.settings.section_subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div id="rivo-app-block-wrapper">
    {% for block in section.blocks %}
      <div class="rivo-app-block" {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {% endfor %}
  </div>
</div>

<style>
.rivo-redeem#rivo-redeem-products-{{ section.id }} {
  padding: 0;
}

.rivo-redeem .rivo-app-block {
  width: 100%;
}

/* Custom Title & Subtitle Styles */
.rivo-redeem-header {
  text-align: center;
  padding: 0 20px 20px;
}

.rivo-redeem-title {
  font-family: 'Canela', Georgia, serif;
  font-size: 38px;
  font-weight: 300;
  line-height: 42px;
  margin: 0 0 10px;
  color: #212428;
}

.rivo-redeem-subtitle {
  font-family: 'TT Commons', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 16px;
  font-weight: 400;
  margin: 0;
  color: #212428;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

@media (max-width: 749px) {
  .rivo-redeem-title {
    font-size: 26px;
    line-height: 1.15;
  }
  .rivo-redeem-subtitle {
    font-size: 14px;
  }
}

.rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-ways-to-redeem {
  position: relative;

  /* defaults */
  --rivo-gap: 20px;
  --rivo-per-view: 3;
  --rivo-card-width: 300px;
  --rivo-nav-btn: 38px;
  --rivo-nav-gap: 10px;

  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--rivo-nav-gap);
  /* wide enough for --rivo-per-view full-size cards plus both nav buttons, so cards never have to shrink to fit */
  max-width: calc(
    (var(--rivo-per-view) * var(--rivo-card-width)) + ((var(--rivo-per-view) - 1) * var(--rivo-gap)) +
    (2 * var(--rivo-nav-btn)) + (2 * var(--rivo-nav-gap)) + 40px
  );
  margin: auto;
}

/* Hide the default Rivo title/subtitle */
.rivo-redeem#rivo-redeem-products-{{ section.id }} .rivo-lp-section-title,
.rivo-redeem#rivo-redeem-products-{{ section.id }} .rivo-lp-section-subtitle,
.rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-ways-to-redeem h2,
.rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-ways-to-redeem h3,
.rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-ways-to-redeem .rivo-header,
.rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-ways-to-redeem .rivo-title,
.rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-ways-to-redeem .rivo-subtitle {
  display: none !important;
}

/* fewer rewards than the desktop target → JS caps --rivo-per-view down to the actual count */

/* mobile → 1 full-width card; arrows float beside it instead of taking row space */
@media (max-width: 749px) {
  .rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-ways-to-redeem {
    --rivo-per-view: 1;
    --rivo-card-width: 100%;
    max-width: 100%;
    padding: 16px 44px;
  }
  .rivo-redeem#rivo-redeem-products-{{ section.id }}
  #rivo-ways-to-redeem .rivo-lp-cards-container {
    padding-left: 0 !important;
    padding-right: 0 !important;

    /* makes snap/scroll feel correct with padding */
    scroll-padding-left: 0;
    scroll-padding-right: 0;
  }

  .rivo-redeem#rivo-redeem-products-{{ section.id }} .rivo-carousel-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  .rivo-redeem#rivo-redeem-products-{{ section.id }} .rivo-carousel-btn--prev { left: 4px; }
  .rivo-redeem#rivo-redeem-products-{{ section.id }} .rivo-carousel-btn--next { right: 4px; }
}

/* track — sized to an exact multiple of (card + gap) so a card can never peek in */
.rivo-redeem#rivo-redeem-products-{{ section.id }}
#rivo-ways-to-redeem .rivo-lp-cards-container {
  display: flex !important;
  flex-wrap: nowrap !important;
  justify-content: flex-start;
  overflow-x: auto !important;
  overflow-y: hidden !important;

  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;

  box-sizing: border-box;
  gap: var(--rivo-gap);
  padding: 0 !important;

  scrollbar-width: none;
  padding-top: 0 !important;
  margin: 0;
  flex: 0 0 auto;
  width: min(
    100%,
    calc((var(--rivo-per-view) * var(--rivo-card-width)) + ((var(--rivo-per-view) - 1) * var(--rivo-gap)))
  );
  max-width: 100%;
}
.rivo-redeem#rivo-redeem-products-{{ section.id }}
#rivo-ways-to-redeem .rivo-lp-cards-container::-webkit-scrollbar {
  display: none;
}

.rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-ways-to-redeem .rivo-card-description {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 6px 16px;
  background: #212428;
  color: #FFF;
  font-weight: 600;
  line-height: 1;
  border-radius: 60px;
}

.rivo-redeem#rivo-redeem-products-{{ section.id }}
#rivo-ways-to-redeem
.rivo-card-title::after {
  display: none !important;
}

/* cards — fixed width on desktop, driven by --rivo-card-width; 100% of the track on mobile */
.rivo-redeem#rivo-redeem-products-{{ section.id }}
#rivo-ways-to-redeem .rivo-card {
  box-sizing: border-box;
  flex: 0 0 var(--rivo-card-width) !important;
  width: var(--rivo-card-width) !important;
  max-width: var(--rivo-card-width) !important;

  scroll-snap-align: start;
  padding: 12px!important;
  position: relative;
  overflow: auto;
  background: #f6f6f7;
}

/* =========================================================
   CARD CONTENT
   ========================================================= */

.rivo-redeem #rivo-ways-to-redeem .rivo-card-icon img {
  width: 100% !important;
  height: 100% !important;
  border-radius: 6px;
}

.rivo-redeem #rivo-ways-to-redeem .rivo-card-body {
  padding: 10px;
  width: 90%;
}

/* =========================================================
   CTA
   ========================================================= */

.rivo-redeem #rivo-ways-to-redeem .rivo-arrow-icon svg,
.rivo-arrow-icon {
  display: none;
}

{% unless customer %}
.rivo-redeem #rivo-ways-to-redeem .rivo-arrow-icon,
.rivo-redeem #rivo-ways-to-redeem .rivo-arrow-icon::after {
  display: none;
}
{% endunless %}

/* =========================================================
   DISABLED
   ========================================================= */

.rivo-redeem #rivo-ways-to-redeem .rivo-card--disabled {
  opacity: .7;
  pointer-events: none;
}

{% if customer %}
.rivo-redeem #rivo-ways-to-redeem
.rivo-card--disabled .rivo-arrow-icon::after {
  content: "Not enough points";
  background: transparent;
  color: #000;
  font-weight: 400;
}
{% endif %}

/* =========================================================
   NAV BUTTONS
   ========================================================= */

.rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-ways-to-redeem {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.rivo-redeem#rivo-redeem-products-{{ section.id }} .rivo-carousel-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 999px;
  background: #fff;
  color: #212428;
  border: 1.5px solid #212428;
  cursor: pointer;
  z-index: 10;
}

.rivo-redeem#rivo-redeem-products-{{ section.id }} .rivo-carousel-btn svg {
  width: 16px;
  height: 16px;
  display: block;
}

.rivo-carousel-btn--prev { order: -1; }
.rivo-carousel-btn--next { order: 1; }

.rivo-carousel-btn:disabled {
  opacity: .3;
  cursor: default;
}

{%- if section.settings.hide_ways_to_redeem_ids != blank -%}
  {%- assign hide_ways_ids = section.settings.hide_ways_to_redeem_ids | split: ',' -%}
  {%- for id in hide_ways_ids -%}
    {%- assign trimmed_id = id | strip -%}
    #rivo-ways-to-redeem #rivo-reward-{{ trimmed_id }} {
      display: none !important;
    }
  {%- endfor -%}

  /* 2) Override: show those rewards inside THIS "Rivo: Redeem Coupons" section */
  {%- for id in hide_ways_ids -%}
    {%- assign trimmed_id = id | strip -%}
    .rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-ways-to-redeem #rivo-reward-{{ trimmed_id }} {
      display: flex !important;
    }
  {%- endfor -%}
{%- endif -%}

/* Hide rewards ONLY on THIS section */
{%- if section.settings.hide_reward_ids != blank -%}
  {%- assign reward_ids = section.settings.hide_reward_ids | split: ',' -%}
  {%- for id in reward_ids -%}
    {%- assign trimmed_id = id | strip -%}
    .rivo-redeem#rivo-redeem-products-{{ section.id }} #rivo-reward-{{ trimmed_id }} {
      display: none !important;
    }
  {%- endfor -%}
{%- endif -%}

</style>

<script>
(function () {
  const section = document.querySelector(
    '.rivo-redeem#rivo-redeem-products-{{ section.id }}'
  );
  if (!section) return;

  function getContainer() {
    return section.querySelector(
      '#rivo-ways-to-redeem .rivo-lp-cards-container'
    );
  }

  const DESKTOP_PER_VIEW = 3;

  function applyPerViewRule(container, ways) {
    const cards = container.querySelectorAll('.rivo-card');
    const isMobile = window.matchMedia('(max-width: 749px)').matches;
    if (isMobile) {
      // let the mobile media query's own --rivo-per-view: 1 take over
      ways.style.removeProperty('--rivo-per-view');
      return;
    }
    const perView = cards.length > 0 ? Math.min(DESKTOP_PER_VIEW, cards.length) : DESKTOP_PER_VIEW;
    ways.style.setProperty('--rivo-per-view', perView);
  }

  function initCarousel() {
    const container = getContainer();
    const ways = section.querySelector('#rivo-ways-to-redeem');
    if (!container || !ways) return;

    applyPerViewRule(container, ways);

    if (ways.querySelector('.rivo-carousel-btn')) return;

    const prev = document.createElement('button');
    prev.className = 'rivo-carousel-btn rivo-carousel-btn--prev';
    prev.setAttribute('aria-label', 'Previous rewards');
    prev.innerHTML = '<svg viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

    const next = document.createElement('button');
    next.className = 'rivo-carousel-btn rivo-carousel-btn--next';
    next.setAttribute('aria-label', 'Next rewards');
    next.innerHTML = '<svg viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

    ways.append(prev, next);

    const scrollPage = dir => {
      container.scrollBy({
        left: dir * container.clientWidth,
        behavior: 'smooth'
      });
    };

    prev.onclick = () => scrollPage(-1);
    next.onclick = () => scrollPage(1);

    const update = () => {
      // Keep arrows always enabled for continuous scrolling
      prev.disabled = false;
      next.disabled = false;
    };

    container.addEventListener('scroll', update);
    window.addEventListener('resize', () => {
      applyPerViewRule(container, ways);
      update();
    });

    setTimeout(update, 100);
  }

  document.addEventListener('DOMContentLoaded', initCarousel);
  document.addEventListener('rivo-js-loaded', () => {
    initCarousel();
    setTimeout(initCarousel, 300);
    setTimeout(initCarousel, 900);
  });

  document.addEventListener('shopify:section:load', e => {
    if (String(e.detail.sectionId) === String('{{ section.id }}')) {
      initCarousel();
    }
  });
})();
</script>



{% schema %}
{
  "name": "Rivo: Redeem Coupons v2",
  "settings": [
    { "type": "color", "id": "section_bg", "label": "Background Color", "default": "#ffffff" },
    { "type": "text", "id": "section_title", "label": "Section Title", "default": "Redeem Your Rewards" },
    { "type": "textarea", "id": "section_subtitle", "label": "Section Subtitle" },
    { "type": "textarea", "id": "hide_ways_to_redeem_ids", "label": "Hide Rewards on Ways to Redeem" },
    { "type": "textarea", "id": "hide_reward_ids", "label": "Hide Rewards on This Section" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Rivo: Redeem Coupons v2" }]
}
{% endschema %}