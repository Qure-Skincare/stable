                            "label": "t:common.calms-redness"
                        },
                        {
                            "value": "deeply-hydrates",
                            "label": "t:common.deeply-hydrates"
                        }
                    ]
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        },
        {
            "type": "right_column",
            "name": "t:sections.n_mi-ingredients.blocks.right-column.name",
            "settings": [
                {
                    "type": "select",
                    "id": "icon",
                    "label": "t:common.icon",
                    "default": "perfect-transforming",
                    "options": [
                        {
                            "value": "perfect-transforming",
                            "label": "t:common.perfect-transforming"
                        },
                        {
                            "value": "two-in-one",
                            "label": "t:common.two-in-one"
                        },
                        {
                            "value": "even-looking",
                            "label": "t:common.even-looking"
                        },
                        {
                            "value": "smooths",
                            "label": "t:common.smooths"
                        },
                        {
                            "value": "calms-redness",
                            "label": "t:common.calms-redness"
                        },
                        {
                            "value": "deeply-hydrates",
                            "label": "t:common.deeply-hydrates"
                        }
                    ]
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        },
        {
            "type": "left_accordion",
            "name": "t:sections.n_mi-ingredients.blocks.left-accordion.name",
