            "label": "t:common.text"
        }
    ],
    "blocks": [
        {
            "type": "left_heading",
            "name": "t:common.left-header",
            "limit": 1,
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        },
        {
            "type": "right_heading",
            "name": "t:common.right-header",
