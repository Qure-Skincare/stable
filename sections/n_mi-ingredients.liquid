            "name": "t:sections.n_mi-ingredients.blocks.right-accordion.name",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.header"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_mi-ingredients.name"
        }
    ]
}
{% endschema %}
