            "settings": [
                {
                    "type": "select",
                    "id": "icon",
                    "label": "t:common.icon",
                    "default": "perfect-transforming",
                    "options": [
                        {
                            "value": "perfect-transforming",
                            "label": "t:common.perfect-transforming"
                        },
                        {
                            "value": "two-in-one",
                            "label": "t:common.two-in-one"
                        },
                        {
                            "value": "even-looking",
                            "label": "t:common.even-looking"
                        },
                        {
                            "value": "smooths",
                            "label": "t:common.smooths"
                        },
                        {
