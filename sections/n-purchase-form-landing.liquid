{% include 'assoc-array', section: section, __parent_title: 'type', __separator: '###' %}

<template id="async">
    {%- liquid
        assign supply_first = false
        if section.settings.supply_first and section.settings.type == 'list'
            assign supply_first = true
        endif
    -%}
    <div class="{{ section.id }} purchase-form-wrapper"{% if supply_first %} data-supply-first="true"{% endif %}>
        {% if supply_first %}
            <style>
                [data-supply-first] .c-options-selector__list:not(.is-supply-first-ready) {
                    visibility: hidden;
                }
                [data-supply-first] .purchase_form_landing_product_type_item {
                    flex: 1 1 0;
                    width: auto;
                    min-width: 0;
                }
                [data-supply-first] .c-options-selector__list--single label {
                    display: grid;
                    grid-template-columns: auto auto;
                    align-content: center;
                    justify-content: center;
                    align-items: center;
                    column-gap: 16px;
                    row-gap: 2px;
                    text-align: left;
                }
                [data-supply-first] .c-options-selector__list--single label img {
                    grid-row: 1 / span 2;
                }
                [data-supply-first] .c-options-selector__list--single label span {
                    align-self: end;
                }
                [data-supply-first] .c-options-selector__list--single label .c-options-selector__subheading {
                    align-self: start;
                }
                [data-supply-first] .c-options-selector__subheading {
                    font-size: 14px;
                    line-height: 1.3;
                    color: #6b6b6b;
                }
                [data-supply-first] .purchase_form_landing_product_type_item.is-entering {
                    animation: landing-supply-first-in 0.3s ease-out;
                }
                @keyframes landing-supply-first-in {
                    from {
                        opacity: 0;
                        transform: translateY(8px) scale(0.98);
                    }
                    to {
                        opacity: 1;
                        transform: none;
                    }
                }
                @media (prefers-reduced-motion: reduce) {
                    [data-supply-first] .purchase_form_landing_product_type_item.is-entering {
                        animation: none;
                    }
                }
            </style>
        {% endif %}
        {% render 'n-purchase-form-landing-types' section: section, __idsArray1: __idsArray1, __idsArray2: __idsArray2, __idsArray3: __idsArray3 %}
        {% include 'n-purchase-form-landing-products' section: section, __idsArray1: __idsArray1, __idsArray2: __idsArray2, __idsArray3: __idsArray3 %}
        {% render 'n-purchase-form-landing-klaviyo', section: section %}
        {% include 'n-purchase-form-landing-subscription' section: section, __idsArray1: __idsArray1, __idsArray2: __idsArray2, __idsArray3: __idsArray3 %}
        {% render 'n-purchase-form-landing-optional-subscription', section: section %}
        {% include 'n-purchase-form-gift', box_class: 'c-gift-included-box', content_class: 'c-gift-included-box__content' %}
        {% render 'n-product-page-buy-button', product_price: null, product_variant_id: null, section: section, product_available: true, static: true %}
        {% if section.settings.delivery_switcher_position == 'footer' %}
            {% include 'n-purchase-form-landing-delivery-switcher' %}
        {% endif %}
        {% render 'n-purchase-form-landing-bottom' %}
    </div>
    <script src="{{ 'n-purchase-form-landing.js' | asset_url }}" data-form="{{ section.settings.form_name }}" data-section="{{ section.id }}" defer></script>
</template>

