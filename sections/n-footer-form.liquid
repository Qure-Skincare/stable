{% if section.settings.exception != blank %}
    {% assign exception_list = section.settings.exception | split: ',' %}
    {% assign path_lower = request.path | downcase %}

    {% for exception in exception_list %}
        {% assign exception = exception | downcase %}
        {% capture _exception %}{{ exception | replace: ' ', '' }}{% endcapture %}
        {% if exception != blank and path_lower contains _exception %}
            {% assign is_exception = true %}
            {% break %}
        {% endif %}
    {% endfor %}
{% endif %}

{% unless is_exception %}
<!-- FOOTER PROMO -->
<section class="footer-promo">
    <div class="container">
        <div class="footer-promo__content">
            <div class="c-subscribe-form">
                <h2>{{ 'footer.settings.subscribe_text' | t }}</h2>
                {% render 'n-klaviyo-subscription-form' %}
            </div>
            <div class="c-follow-us">
                <h2>{{ 'footer.settings.follow_us_text' | t }}</h2>
                <ul>
                    <li><a href="https://www.instagram.com/qureskincare/" aria-label="instagram"><i class="e-icon e-icon-instagram"></i></a></li>
                    <li><a href="https://www.facebook.com/Qureskincare/" aria-label="facebook"><i class="e-icon e-icon-facebook"></i></a></li>
                    <li><a href="https://www.tiktok.com/@qureskincare?lang=en" aria-label="tiktok"><i class="e-icon e-icon-tiktok"></i></a></li>
                    <li><a href="https://youtube.com/channel/UCGTi3BZn8GVlu30NtQ-reYA" aria-label="youtube"><i class="e-icon e-icon-youtube"></i></a></li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- FOOTER PROMO END -->
{% endunless %}

{% schema %}
{
    "name": "t:sections.footer-form.name",
    "settings": [
        {
            "type": "textarea",
            "id": "exception",
            "label": "t:common.exception"
        }
    ]
}
{% endschema %}