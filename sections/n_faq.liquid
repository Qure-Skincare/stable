{% doc %}
    Renders a faq section.
{% enddoc %}

{% if section.settings.use_own_file %}
    <link rel="stylesheet" href="https://qureskincaredns-stable.com/sections/have-questions/have-questions.css" />
{% endif %}

<div class="have-questions{% if section.settings.modifier == 'light' %} have-questions--light{% endif %}" id="faq">
    <div class="container">
        {{ section.settings.heading }}
        <div class="c-accordion c-accordion--lines">
            <div class="c-accordion__list">
                {% for block in section.blocks %}
                    {% if block.type == 'accordion' %}
                        <details class="c-accordion__item">
                            {% if block.settings.heading != blank %}
                                <summary class="c-accordion__summary">{{ block.settings.heading }}</summary>
                            {% endif %}
                            {% if block.settings.text != blank %}
                                <article class="c-accordion__content">
                                    {{ block.settings.text }}
                                    {% if block.settings.image != blank %}
                                        <img loading="lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt | escape }}" />
                                    {% endif %}
                                </article>
                            {% endif %}
                        </details>
                    {% endif %}
                {% endfor %}
            </div>
            {% if section.settings.button_label != blank and section.settings.button_url != blank %} 
                <div class="c-accordion__ask-us">
                    {{ section.settings.text }}<a href="{{ section.settings.button_url }}" class="btn btn-sm btn--secondary">{{ section.settings.button_label }}<i class="e-icon e-icon-arrow"></i></a>
                </div>
            {% endif %}
        </div>
        {% if section.settings.advisor_heading != blank %}
            <a class="team-advisor" href="{{ section.settings.advisor_url }}">
                <figure>
                    {% if section.settings.advisor_image != blank %}
                        <img loading="lazy" src="{{ section.settings.advisor_image | image_url }}" alt="{{ section.settings.advisor_heading | escape }}" />
                    {% endif %}
                    <figcaption><i class="e-icon e-icon-q"></i></figcaption>
                </figure>
                <strong>{{ section.settings.advisor_heading }}</strong>
                {% if section.settings.advisor_text != blank %}
                    <span>{{ section.settings.advisor_text }}</span>
                {% endif %}
            </a>
        {% endif %}
    </div>
</div>

{% if section.blocks.size > 0 %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {% for block in section.blocks %}
            {
                "@type": "Question",
                "name": {{ block.settings.heading | json }},
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ block.settings.text |  strip_html | json }}
                }
            }{% unless forloop.last %},{% endunless %}
            {% endfor %}
        ]
    }
    </script>
{% endif %}

{% schema %}
{
    "name": "t:sections.n_faq.name",
    "settings": [
        {
            "type": "checkbox",
            "id": "use_own_file",
            "label": "t:common.use-own-file",
            "default": false
        },
        {
            "type": "select",
            "id": "modifier",
            "label": "t:common.modifier",
            "default": "none",
            "options": [
                {
                    "value": "none",
                    "label": "t:common.none"
                },
                {
                    "value": "light",
                    "label": "t:common.light"
                }
            ]
        },
        {
            "type": "richtext",
            "id": "heading",
            "label": "t:common.header"
        },
        {
            "type": "image_picker",
            "id": "advisor_image",
            "label": "t:common.image"
        },
        {
            "type": "text",
            "id": "advisor_heading",
            "label": "t:sections.n_faq.settings.advisor-heading"
        },
        {
            "type": "text",
            "id": "advisor_text",
            "label": "t:sections.n_faq.settings.advisor-text"
        },
        {
            "type": "url",
            "id": "advisor_url",
            "label": "t:sections.n_faq.settings.advisor-url"
        },
        {
            "type": "text",
            "id": "text",
            "label": "t:common.text",
            "default": "Don't see your question? "
        },
        {
            "type": "text",
            "id": "button_label",
            "label": "t:common.button-label",
            "default": "Ask us "
        },
        {
            "type": "url",
            "id": "button_url",
            "label": "t:common.button-url"
        }
    ],
    "blocks": [
        {
            "type": "accordion",
            "name": "t:common.accordion",
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.header"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.n_faq.name"
        }
    ]
}
{% endschema %}