{% assign shower_filter_handle = 'shower-filter' %}
{% include 'get-product-data', product_handle: shower_filter_handle %}
{% assign shower_white_id = '' %}
{% assign shower_black_id = '' %}
{% for variant in get_product_data.variants %}
    {% if variant.title == 'White' %}{% assign shower_white_id = variant.id %}{% endif %}
    {% if variant.title == 'Black' %}{% assign shower_black_id = variant.id %}{% endif %}
{% endfor %}

{% assign faucet_filter_handle = 'faucet-filter' %}
{% include 'get-product-data', product_handle: faucet_filter_handle %}
{% assign faucet_white_id = '' %}
{% assign faucet_black_id = '' %}
{% for variant in get_product_data.variants %}
    {% if variant.title == 'White' %}{% assign faucet_white_id = variant.id %}{% endif %}
    {% if variant.title == 'Black' %}{% assign faucet_black_id = variant.id %}{% endif %}
{% endfor %}

<!-- HERO PRODUCT -->
<section class="hero-product hero-product--reverse hero-product--secondary" id="form-inside">
