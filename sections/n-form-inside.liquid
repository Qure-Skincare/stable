            </article>
            <hr />
            <div class="purchase-form-wrapper">
                <div class="c-options-selector">
                    <p class="c-options-selector__title">Select Your Color:</p>
                    <ul class="c-options-selector__list">
                        <li>
                            <label class="qure__variant-item planBlock">
                                <input type="radio" name="color" id="white" class="variant__input" checked="checked" />
                                <div class="bundle">
                                    <figure>
                                        <img loading="lazy" src="https://qureskincaredns-stable.com/assets/images/qure-shower-filter/shower_filter_white.webp" alt="White" />
                                    </figure>
                                    <i class="e-icon e-icon-plus"></i>
                                    <figure>
                                        <img loading="lazy" src="https://qureskincaredns-stable.com/assets/images/qure-shower-filter/faucet_filter_white.webp" alt="White" />
                                        <figcaption class="e-pill-badge e-pill-badge--xxs">Free</figcaption>
                                    </figure>
                                </div>
                                <span>White</span>
                            </label>
                        </li>
                        <li>
                            <label class="qure__variant-item planBlock">
                                <input type="radio" name="color" id="black" class="variant__input" />
                                <div class="bundle">
                                    <figure>
                                        <img loading="lazy" src="https://qureskincaredns-stable.com/assets/images/qure-shower-filter/shower_filter_black.webp" alt="Black" />
                                    </figure>
                                    <i class="e-icon e-icon-plus"></i>
                                    <figure>
                                        <img loading="lazy" src="https://qureskincaredns-stable.com/assets/images/qure-shower-filter/faucet_filter_black.webp" alt="Black" />
                                        <figcaption class="e-pill-badge e-pill-badge--xxs">Free</figcaption>
                                    </figure>
                                </div>
