{% doc %}
  Renders a led mask offer section on page led-mask-offer-2
{% enddoc %}

<!-- HERO PRODUCT -->
<section class="hero-product hero-product--reverse hero-product--secondary" id="buy-form">
    <div class="hero-product__container container">
        <div class="hero-product__gallery">
            {% render 'n-product-page-slider', product: product, page: page, element_id: '#buy-form', slidesPerView: 1, spaceBetween: 16 %}
            {% render 'n-product-page-slider-thumbs', product: product, page: page, slidesPerView: 'auto', spaceBetween: 12 %}
        </div>
        <div class="hero-product__main">
            <div class="e-pill-badge e-pill-badge--md">Limited Time Offer</div>
            <h2>Q-Rejuvalight Pro LED Mask</h2>
            <h4>+ FREE Neck &amp; Décolletage LED System</h4>
            <div class="c-special-offer" data-label="Special Offer">
                <div class="e-price">
                    <div class="e-price__main">
                        <div class="e-price__current">$399</div>
                        <div class="e-price__old e-price__full">{$dyn}</div>
                    </div>
                </div>
                <div class="e-pill-save">Save 40%</div>
            </div>
            <article>
                <ul>
                    <li>Warranty</li>
                    <li>FDA Cleared</li>
                </ul>
                <p>Elevate your LED routine with full face and neck coverage for consistent all-over results.</p>
            </article>
            <hr />
            <div class="c-bundle-included">
                <p class="c-bundle-included__tile">What’s Included</p>
                <ul class="c-bundle-included__list">

                    {% assign mask_handle = 'q-rejuvalight-pro-facewear-3' %}
                    {% include 'get-product-data', product_handle: mask_handle %}
                    {% assign mask_variant_id = get_product_data.variants.first.id %}

                    <li>
                        <a href="/products/{{ get_product_data.handle }}">
                            <img loading="lazy" src="https://qureskincaredns-stable.com/assets/images/led-mask-offer/q-rejuvalight.webp" alt="Q-Rejuvalight Pro LED Mask" />
                        </a>
                        <div>
                            <a href="/products/{{ get_product_data.handle }}">Q-Rejuvalight Pro LED Mask</a>
                            <small>FDA-cleared device that treats acne, fine lines, wrinkles and dark spots.</small>
                            <div class="e-price">
                                <div class="e-price__main">
                                    <div class="e-price__current">$399</div>
                                </div>
                            </div>
                        </div>
                    </li>

                    {% assign neck_handle = 'neck-decolletage-led' %}
                    {% include 'get-product-data', product_handle: neck_handle %}
                    {% assign neck_variant_id = get_product_data.variants.first.id %}

                    <li>
                        <a href="/products/{{ get_product_data.handle }}">
                            <img loading="lazy" src="https://qureskincaredns-stable.com/assets/images/led-mask-offer/led-device.webp" alt="Neck & Décolletage LED Device" />
                        </a>
                        <div>
                            <a href="/products/{{ get_product_data.handle }}">Neck &amp; Décolletage LED Device</a>
                            <small>Clinically proven to smooth and firm where aging shows first.</small>
                            <div class="e-price e-price--highlight">
                                <div class="e-price__main">
                                    <div class="e-price__current">FREE</div>
                                    <div class="e-price__old">299</div>
                                </div>
                            </div>
                        </div>
                    </li>
                </ul>
                <hr />
                <div class="c-bundle-included__amount">
                    <p>INSTANT SAVINGS: $299</p>
                    <div class="e-price">
                        <div class="e-price__main">
                            <div class="e-price__current">$399</div>
                            <div class="e-price__old e-price__full">{$dyn}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="c-buy-block">
                <div class="e-progress _e-progress--nearly-full e-progress--low-stock">
                    <p>Low Stock</p>
                    <small>Due to high demand, this offer is only available while stock lasts.</small>
                    <div style="--progress: 75%">75% Sold</div>
                </div>
                <div class="e-get-free-shipping">Order today to lock in your deal and get FREE Shipping</div>
                <div class="c-order-button">
                    <form data-static="true">
                        <button class="btn btn--primary" type="submit">{{ 'sections.page-led-mask-offer-2-led-mask-form.settings.button-text' | t }} &amp; Save $299 <i class="e-icon e-icon-arrow"></i></button>
                    </form>
                </div>
                <div class="c-buy-block__payment-logos">
                    <img loading="lazy" src="https://qureskincaredns-stable.com/assets/images/full-payment-logos.svg" alt="Full payment logos" />
                </div>
                <ul class="e-features-list">
                    <li>
                        <i class="e-icon e-icon-one-year"></i>
                        1-Year Guarantee
                    </li>
                    <li>
                        <i class="e-icon e-icon-shipping-order"></i>
                        Free Shipping over 100$
                    </li>
                </ul>
            </div>
        </div>
        <div class="hero-product__extra">
            {% render 'n-product-page-collapsed', product: product, page: page %}
        </div>
    </div>
</section>

<script class="__init">
    /* class="__init" keeps this script OUT of the sapp proxy rewrite (same lane as
       the __sapp-lcp orchestrator), so it executes at parse — immediately, not
       after the LCP hero window. It wires the add-to-cart button using
       server-rendered variant ids, so it needs neither the deferred
       window.get_products_data nor the hero to load first. addToCartJson (slide
       cart) is still LCP-loaded; we retry until it exists, so an early click
       queues instead of being lost to a form reload. */
    (function () {
        var MASK_ID = {{ mask_variant_id | json }};
        var NECK_ID = {{ neck_variant_id | json }};
        var DISCOUNT = 'FREEN&DOFFER';

        function bind() {
            var form = document.querySelector('.c-buy-block form');
            if (!form) { return document.addEventListener('DOMContentLoaded', bind, { once: true }); }
            if (form.getAttribute('data-atc-bound')) return;
            form.setAttribute('data-atc-bound', '1');

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var items = [
                    { id: MASK_ID, quantity: 1 },
                    { id: NECK_ID, quantity: 1 }
                ];
                fetch('/discount/' + DISCOUNT).then(function () {
                    (function add() {
                        if (window.CartDrawer && typeof window.CartDrawer.addToCartJson === 'function') {
                            window.CartDrawer.addToCartJson(items);
                        } else if (typeof addToCartJson === 'function') {
                            addToCartJson(items);
                        } else {
                            setTimeout(add, 60);
                        }
                    })();
                });
            });
        }

        bind();
    })();
</script>

<script>
    {%- comment -%}
      Do NOT read window.get_products_data at top level or on DOMContentLoaded: the
      LCP orchestrator (__sapp-lcp) reorders/replays inert scripts, so the moment
      this consumer runs is not guaranteed to be after get-product-data has defined
      the global — and n-form-inside-mask.js captures window.mask ONCE at load, so
      loading it too early (loadScriptOnce is idempotent) leaves the buy form with
      no submit handler. Instead poll until both products exist, then expose them
      on window and load the script exactly once with the data already in place.
    {%- endcomment -%}
    (function () {
        var maskHandle = "{{ mask_handle }}";
        var neckHandle = "{{ neck_handle }}";

        function boot() {
            var data = window.get_products_data;
            if (typeof loadScriptOnce !== 'function' || !data || !data[maskHandle] || !data[neckHandle]) {
                return setTimeout(boot, 50);
            }
            window.mask = data[maskHandle];
            window.neck = data[neckHandle];
            window.discount_text = '{{ 'sections.page-led-mask-offer-2-led-mask-form.settings.discount-text' | t }}';

            loadScriptOnce('n-form-inside-mask', '{{ 'n-form-inside-mask.js' | asset_url }}');
        }

        boot();
    })();
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadScriptOnce("countdown", "https://qureskincaredns-stable.com/assets/js/countdown.js");
        loadScriptOnce("youtube-popup", "https://qureskincaredns-stable.com/assets/js/yt-popup.js");
        loadScriptOnce("wistia-popup", "https://qureskincaredns-stable.com/assets/js/wistia-popup.js");
        loadScriptOnce("gallery-sticky-video", "https://qureskincaredns-stable.com/assets/js/gallery-sticky-video.js");
        loadScriptOnce("dialog", "https://qureskincaredns-stable.com/assets/js/dialog.js");
    });
</script>
<!-- HERO PRODUCT END -->