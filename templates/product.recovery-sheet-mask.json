    "n_faq_recovery_mask": {
      "type": "n_faq",
      "blocks": {
        "accordion_benefit": {
          "type": "accordion",
          "settings": {
            "heading": "How will the Recovery+ Sheet Mask benefit my hair/skin?",
            "text": "<p>The Recovery+ Sheet Mask removes harmful impurities like heavy metals, chlorine, and unwanted minerals from your water, helping to protect your skin and hair from damage caused by hard water.</p><p>By filtering out water impurities, the Recovery+ Sheet Mask helps reduce dryness, irritation, and brittleness, leaving your skin hydrated and your hair smoother and more manageable.</p>"
          }
        },
        "accordion_showerheads": {
          "type": "accordion",
          "settings": {
            "heading": "Is it compatible with all showerheads?",
            "text": "<p>The Recovery+ Sheet Mask fits most standard showerheads, but we recommend checking your showerhead's specifications to ensure compatibility.</p>"
          }
        },
        "accordion_pressure": {
          "type": "accordion",
          "settings": {
            "heading": "Does it affect water pressure?",
            "text": "<p>The Recovery+ Sheet Mask is designed to maintain water pressure while effectively filtering impurities. You’ll enjoy clean water without compromising your shower experience.</p>"
          }
        },
        "accordion_certified": {
          "type": "accordion",
          "settings": {
            "heading": "Is the Recovery+ Sheet Mask certified, tested, and safe to use?",
            "text": "<p>Yes — it’s third-party tested to meet NSF water filtration standards and made with certified BPA-free, non-toxic, and skin-friendly materials. It’s also leak-resistant and built to last.</p>"
          }
        },
        "accordion_replace": {
          "type": "accordion",
          "settings": {
            "heading": "Do I need to change/replace the filter?",
            "text": "<p>The Recovery+ Sheet Mask lasts approximately 3 months, depending on your water quality and usage. We recommend replacing it after 3 months for optimal performance.</p>"
          }
        },
        "accordion_install": {
          "type": "accordion",
          "settings": {
            "heading": "How easy is it to install?",
            "text": "<p>Yes, the Recovery+ Sheet Mask is designed for easy, tool-free installation. It fits most standard showerheads, so you can quickly start enjoying clean, filtered water.</p>"
          }
        },
        "accordion_subscribe": {
          "type": "accordion",
          "settings": {
            "heading": "Why should I subscribe?",
            "text": "<p>Regularly replacing your Recovery+ Sheet Mask ensures it continues to effectively remove chlorine, heavy metals, and impurities from your water. Over time, the filtration media becomes saturated, reducing its ability to provide clean, skin-friendly water.</p><p>By subscribing, you prevent buildup of contaminants that can diminish the filter’s effectiveness, and consistently reduce exposure to harmful chemicals that cause hair and skin irritation and dryness.</p>"
          }
        }
      },
      "block_order": [
        "accordion_benefit",
        "accordion_showerheads",
        "accordion_pressure",
        "accordion_certified",
        "accordion_replace",
        "accordion_install",
        "accordion_subscribe"
      ],
