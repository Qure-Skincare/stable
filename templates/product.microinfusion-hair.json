    "n_expert_feature_hair": {
      "type": "n_expert-feature",
      "settings": {
        "use_own_file": false,
        "heading": "<h2>Does Micro-Infusion Hair hurt?</h2>",
        "text": "<p>Qure Micro-Infusion Hair is designed for comfortable at-home use. Its single-use, gold-plated needles (0.5 mm) gently stamp the scalp, unlike more aggressive treatments that involve rolling or dragging.</p><p>You may feel a slight prickling, similar to Velcro lightly pressed against your skin. As you stamp, the needles create channels that help your scalp absorb Qure’s Hair Renewal Serum, for hair that looks fuller and a healthier-looking scalp.</p>",
        "quote": "“What I really like about Qure Micro-Infusion Hair is the thought put into safe at-home use. Every treatment starts with a fresh, sterile, single-use needle head. That attention to detail matters.”",
        "author": "Dr. Shah",
        "caption": "1.2M followers",
        "badge": "Board Certified Dermatologist",
        "image": "shopify://shop_images/dr-shah.webp",
        "image_mobile": "shopify://shop_images/dr-shah-mob.webp"
      }
    },
