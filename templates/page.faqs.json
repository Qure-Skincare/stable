          }
        },
        "faq_item_3LXGiw": {
          "type": "faq_item",
          "settings": {
            "secure_strap": false,
            "heading": "Can I remove a saved payment method?",
            "text": "<p>Of course! You can make this change on your account page. If you need help, contact us via <a href=\"https://qureskincare.customerdesk.io/#rp-customer-widget-home\" title=\"https://qureskincare.customerdesk.io/#rp-customer-widget-home\">Customer Portal</a>.</p>",
            "section_id": ""
          }
        },
        "faq_item_yKAk6a": {
          "type": "faq_item",
          "settings": {
            "secure_strap": false,
            "heading": "What is the credit card statement or PayPal statement name?",
            "text": "<p>Please look out for “QURE SKIN” or “INSPIREBRANDS” charge on your credit card statement or PayPal account after you have placed your order. </p><p>If you're not sure what charge description you should be looking for then please contact us via <a href=\"https://qureskincare.customerdesk.io/#rp-customer-widget-home\" title=\"https://qureskincare.customerdesk.io/#rp-customer-widget-home\">Customer Portal.</a> </p>",
            "section_id": ""
          }
        }
