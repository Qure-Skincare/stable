          "type": "faq_item",
          "settings": {
            "secure_strap": false,
            "heading": "What forms of payment do you accept?",
            "text": "<p>We accept Visa, Mastercard, American Express credit cards or debit cards and PayPal.</p>",
            "section_id": ""
          }
        },
        "faq_item_RTFQjx": {
          "type": "faq_item",
          "settings": {
            "secure_strap": false,
            "heading": "When will my credit card be charged?",
            "text": "<p>Your credit card will be charged as soon as your order is accepted and processed.</p>",
