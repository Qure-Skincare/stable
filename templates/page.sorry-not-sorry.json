          "type": "slider",
          "settings": {
            "image": "shopify://shop_images/chelsea.webp",
            "flag": "shopify://shop_images/america_f.webp",
            "username": "Chelsea J.",
            "verified_customer": "Verified customer",
            "text": "<h6>Amazing results!</h6><p>\"Amazing results. I am just in shock at how great my skin is looking. This stuff has been amazing for hyperpigmentation and also some hormonal cystic acne. I will be continuing to support this business because it has brought the skin I know back. I was at my wits end with a hormonal breakout and bad hyperpigmentation.\"</p>",
            "product_url": "",
            "product_text": "",
            "product_title": ""
          }
        },
