    "n_expert_feature_Rw6zPm": {
      "type": "n_expert-feature",
      "name": "t:sections.n_expert-feature.name",
      "settings": {
        "use_own_file": false,
        "heading": "<h6>Does it hurt?</h6><h2>What it actually feels like: a light prickle.</h2>",
        "text": "<p>Picture Velcro pressed lightly against your skin. That’s the feeling. The 0.5mm needles stamp straight down. No rolling, no dragging, no tugging.</p><p>Each stamp creates tiny channels that help your skin take up the serum, for smoother-looking, more radiant skin.</p><p>Every treatment starts with a fresh, sterile, single-use needle head, so there’s nothing to worry about on the hygiene side either.</p>",
        "quote": "“What I really like about Qure Micro-Infusion Pro is the thought put into safe at-home use. Every treatment starts with a fresh, sterile, single-use needle head. That attention to detail matters.”",
        "author": "Dr. Shah",
        "caption": "1.2M followers",
        "badge": "Board Certified Dermatologist",
        "image": "shopify://shop_images/dr-shah.webp",
        "image_mobile": "shopify://shop_images/dr-shah-mob.webp"
      }
    },
